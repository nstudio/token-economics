diff --git a/src/pages/health/App.vue b/src/pages/health/App.vue
index fac36e7..0acd5cd 100644
--- a/src/pages/health/App.vue
+++ b/src/pages/health/App.vue
@@ -1,11 +1,98 @@
 <script setup lang="ts">
+import { computed, onMounted, onUnmounted, ref } from 'vue-lynx'
 import { close } from 'sparkling-navigation'
 
 import './App.css'
+import { getAuthorizationStatus, getLast7DaysSteps, logSteps, requestAuthorization } from './native'
+import type { HealthAuthStatus, HealthDayRow } from './native'
+
+const VIEW_DID_APPEAR_EVENT = 'kHybridKitEventViewDidAppear'
+
+const authStatus = ref<HealthAuthStatus>('notRequested')
+const errorText = ref<string | null>(null)
+const isLogging = ref(false)
+const days = ref<HealthDayRow[]>([])
+
+const statusLine = computed(() => {
+  if (errorText.value) {
+    return errorText.value
+  }
+  switch (authStatus.value) {
+    case 'authorized':
+      return 'Health access: granted'
+    case 'denied':
+      return 'Health access: denied'
+    default:
+      return 'Health access: not requested'
+  }
+})
+
+const canLogSteps = computed(() => authStatus.value === 'authorized')
+
+async function refreshDays() {
+  const result = await getLast7DaysSteps()
+  if (result.error) {
+    errorText.value = result.error
+    return
+  }
+  days.value = result.days ?? []
+}
+
+async function refreshStatus() {
+  const result = await getAuthorizationStatus()
+  authStatus.value = result.status
+  if (authStatus.value === 'authorized') {
+    await refreshDays()
+  }
+}
+
+async function requestAccess() {
+  errorText.value = null
+  const result = await requestAuthorization()
+  authStatus.value = result.status
+  if (result.error) {
+    errorText.value = result.error
+    return
+  }
+  if (authStatus.value === 'authorized') {
+    await refreshDays()
+  }
+}
+
+async function logFiveHundredSteps() {
+  if (!canLogSteps.value || isLogging.value) {
+    return
+  }
+  isLogging.value = true
+  try {
+    const result = await logSteps(500)
+    if (!result.success) {
+      errorText.value = result.error ?? 'Failed to log steps'
+      return
+    }
+    errorText.value = null
+    await refreshDays()
+  } finally {
+    isLogging.value = false
+  }
+}
 
 function goBack() {
   close()
 }
+
+function onViewDidAppear() {
+  refreshStatus()
+}
+
+onMounted(() => {
+  refreshStatus()
+  lynx.getJSModule?.('GlobalEventEmitter')?.addListener?.(VIEW_DID_APPEAR_EVENT, onViewDidAppear)
+})
+
+onUnmounted(() => {
+  lynx.getJSModule?.('GlobalEventEmitter')?.removeListener?.(VIEW_DID_APPEAR_EVENT, onViewDidAppear)
+})
 </script>
 
 <template>
@@ -15,16 +102,26 @@ function goBack() {
         <text class="nav-back__text">← Home</text>
       </view>
       <view class="content">
-        <text class="status-line">Health access: not requested</text>
-        <view class="button button--secondary">
+        <text class="status-line">{{ statusLine }}</text>
+        <view class="button button--secondary" @tap="requestAccess">
           <text class="button__text">Request Access</text>
         </view>
-        <view class="button button--disabled">
+        <view :class="['button', { 'button--disabled': !canLogSteps }]" @tap="logFiveHundredSteps">
           <text class="button__text">Log 500 Steps</text>
         </view>
         <text class="section-header">Last 7 Days</text>
         <view class="card">
-          <text class="empty-state">No data yet</text>
+          <template v-if="authStatus === 'authorized'">
+            <view
+              v-for="day in days"
+              :key="day.label"
+              :class="['list-row', { 'list-row--today': day.isToday }]"
+            >
+              <text class="list-row__text">{{ day.label }}</text>
+            </view>
+          </template>
+          <text v-else-if="authStatus === 'denied'" class="empty-state">Health access needed</text>
+          <text v-else class="empty-state">No data yet</text>
         </view>
       </view>
     </view>
diff --git a/src/pages/health/native.ts b/src/pages/health/native.ts
new file mode 100644
index 0000000..90d9b20
--- /dev/null
+++ b/src/pages/health/native.ts
@@ -0,0 +1,50 @@
+export type HealthAuthStatus = 'notRequested' | 'authorized' | 'denied'
+
+export interface HealthDayRow {
+  label: string
+  steps: number
+  isToday: boolean
+}
+
+interface StatusResult {
+  status: HealthAuthStatus
+  error?: string
+}
+
+interface SaveResult {
+  success: boolean
+  error?: string
+}
+
+interface DaysResult {
+  days?: HealthDayRow[]
+  error?: string
+}
+
+function healthModule() {
+  return NativeModules.NativeHealthModule
+}
+
+export function getAuthorizationStatus(): Promise<StatusResult> {
+  return new Promise((resolve) => {
+    healthModule().getAuthorizationStatus((result: StatusResult) => resolve(result))
+  })
+}
+
+export function requestAuthorization(): Promise<StatusResult> {
+  return new Promise((resolve) => {
+    healthModule().requestAuthorization((result: StatusResult) => resolve(result))
+  })
+}
+
+export function logSteps(steps: number): Promise<SaveResult> {
+  return new Promise((resolve) => {
+    healthModule().logSteps(steps, (result: SaveResult) => resolve(result))
+  })
+}
+
+export function getLast7DaysSteps(): Promise<DaysResult> {
+  return new Promise((resolve) => {
+    healthModule().getLast7DaysSteps((result: DaysResult) => resolve(result))
+  })
+}
