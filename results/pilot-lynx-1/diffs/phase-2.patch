diff --git a/ios/SparklingGo/SparklingGo/NativeModules/NativeHealthModule.swift b/ios/SparklingGo/SparklingGo/NativeModules/NativeHealthModule.swift
new file mode 100644
index 0000000..5fb6216
--- /dev/null
+++ b/ios/SparklingGo/SparklingGo/NativeModules/NativeHealthModule.swift
@@ -0,0 +1,157 @@
+// Copyright 2025 The Sparkling Authors. All rights reserved.
+// Licensed under the Apache License Version 2.0 that can be found in the
+// LICENSE file in the root directory of this source tree.
+
+import Foundation
+import Lynx
+#if canImport(HealthKit)
+import HealthKit
+#endif
+
+#if canImport(HealthKit)
+
+@objc(NativeHealthModule)
+@objcMembers
+public final class NativeHealthModule: NSObject, LynxModule {
+
+    public static var name: String { "NativeHealthModule" }
+
+    public static var methodLookup: [String: String] {
+        [
+            "getAuthorizationStatus": NSStringFromSelector(#selector(getAuthorizationStatus(_:))),
+            "requestAuthorization": NSStringFromSelector(#selector(requestAuthorization(_:))),
+            "logSteps": NSStringFromSelector(#selector(logSteps(_:callback:))),
+            "getLast7DaysSteps": NSStringFromSelector(#selector(getLast7DaysSteps(_:))),
+        ]
+    }
+
+    private let healthStore = HKHealthStore()
+    private let stepType = HKQuantityType.quantityType(forIdentifier: .stepCount)!
+
+    public override init() {
+        super.init()
+    }
+
+    public init(param: Any) {
+        super.init()
+    }
+
+    private func currentStatus() -> String {
+        switch healthStore.authorizationStatus(for: stepType) {
+        case .sharingAuthorized:
+            return "authorized"
+        case .sharingDenied:
+            return "denied"
+        default:
+            return "notRequested"
+        }
+    }
+
+    func getAuthorizationStatus(_ callback: @escaping (NSDictionary) -> Void) {
+        guard HKHealthStore.isHealthDataAvailable() else {
+            callback(["status": "denied"])
+            return
+        }
+        callback(["status": currentStatus()])
+    }
+
+    func requestAuthorization(_ callback: @escaping (NSDictionary) -> Void) {
+        guard HKHealthStore.isHealthDataAvailable() else {
+            callback(["status": "denied", "error": "Health data is not available on this device"])
+            return
+        }
+        healthStore.requestAuthorization(toShare: [stepType], read: [stepType]) { [weak self] _, error in
+            guard let self = self else { return }
+            DispatchQueue.main.async {
+                var result: [String: Any] = ["status": self.currentStatus()]
+                if let error = error {
+                    result["error"] = error.localizedDescription
+                }
+                callback(result as NSDictionary)
+            }
+        }
+    }
+
+    func logSteps(_ steps: Double, callback: @escaping (NSDictionary) -> Void) {
+        let now = Date()
+        let quantity = HKQuantity(unit: .count(), doubleValue: steps)
+        let sample = HKQuantitySample(type: stepType, quantity: quantity, start: now, end: now)
+        healthStore.save(sample) { success, error in
+            DispatchQueue.main.async {
+                var result: [String: Any] = ["success": success]
+                if let error = error {
+                    result["error"] = error.localizedDescription
+                }
+                callback(result as NSDictionary)
+            }
+        }
+    }
+
+    func getLast7DaysSteps(_ callback: @escaping (NSDictionary) -> Void) {
+        guard HKHealthStore.isHealthDataAvailable() else {
+            callback(["error": "Health data is not available on this device"])
+            return
+        }
+
+        let calendar = Calendar.current
+        let startOfToday = calendar.startOfDay(for: Date())
+        guard let rangeStart = calendar.date(byAdding: .day, value: -6, to: startOfToday),
+              let rangeEnd = calendar.date(byAdding: .day, value: 1, to: startOfToday) else {
+            callback(["error": "Unable to compute date range"])
+            return
+        }
+
+        var interval = DateComponents()
+        interval.day = 1
+
+        let query = HKStatisticsCollectionQuery(
+            quantityType: stepType,
+            quantitySamplePredicate: nil,
+            options: .cumulativeSum,
+            anchorDate: startOfToday,
+            intervalComponents: interval
+        )
+
+        query.initialResultsHandler = { _, collection, error in
+            if let error = error {
+                DispatchQueue.main.async {
+                    callback(["error": error.localizedDescription])
+                }
+                return
+            }
+
+            let dayFormatter = DateFormatter()
+            dayFormatter.locale = Locale(identifier: "en_US_POSIX")
+            dayFormatter.dateFormat = "EEE MMM d"
+
+            let numberFormatter = NumberFormatter()
+            numberFormatter.locale = Locale(identifier: "en_US")
+            numberFormatter.numberStyle = .decimal
+
+            var rows: [[String: Any]] = []
+            var dayStart = rangeStart
+            while dayStart < rangeEnd {
+                let dayEnd = calendar.date(byAdding: .day, value: 1, to: dayStart) ?? rangeEnd
+                let sum = collection?.statistics(for: dayStart)?.sumQuantity()?.doubleValue(for: .count()) ?? 0
+                let steps = Int(sum.rounded())
+                let isToday = calendar.isDate(dayStart, inSameDayAs: startOfToday)
+                let stepsLabel = numberFormatter.string(from: NSNumber(value: steps)) ?? "\(steps)"
+                var label = "\(dayFormatter.string(from: dayStart)) — \(stepsLabel) steps"
+                if isToday {
+                    label += " (today)"
+                }
+                rows.append(["label": label, "steps": steps, "isToday": isToday])
+                dayStart = dayEnd
+            }
+            rows.reverse()
+
+            DispatchQueue.main.async {
+                callback(["days": rows])
+            }
+        }
+
+        healthStore.execute(query)
+    }
+}
+
+#endif
