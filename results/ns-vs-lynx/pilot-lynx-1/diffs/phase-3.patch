diff --git a/ios/SparklingGo/SparklingGo/NativeModules/NativeSpeechModule.swift b/ios/SparklingGo/SparklingGo/NativeModules/NativeSpeechModule.swift
new file mode 100644
index 0000000..a59731c
--- /dev/null
+++ b/ios/SparklingGo/SparklingGo/NativeModules/NativeSpeechModule.swift
@@ -0,0 +1,121 @@
+// Copyright 2025 The Sparkling Authors. All rights reserved.
+// Licensed under the Apache License Version 2.0 that can be found in the
+// LICENSE file in the root directory of this source tree.
+
+import Foundation
+import Lynx
+#if canImport(Speech)
+import Speech
+#endif
+
+#if canImport(Speech)
+
+@objc(NativeSpeechModule)
+@objcMembers
+public final class NativeSpeechModule: NSObject, LynxContextModule {
+
+    public static var name: String { "NativeSpeechModule" }
+
+    public static var methodLookup: [String: String] {
+        [
+            "getAuthorizationStatus": NSStringFromSelector(#selector(getAuthorizationStatus(_:))),
+            "requestAuthorization": NSStringFromSelector(#selector(requestAuthorization(_:))),
+            "transcribeSample": NSStringFromSelector(#selector(transcribeSample(_:))),
+        ]
+    }
+
+    private static let partialResultEvent = "kNativeSpeechPartialResult"
+
+    private weak var lynxContext: LynxContext?
+    private let recognizer = SFSpeechRecognizer(locale: Locale(identifier: "en-US"))
+    private var recognitionTask: SFSpeechRecognitionTask?
+
+    public required init(lynxContext: LynxContext) {
+        self.lynxContext = lynxContext
+        super.init()
+    }
+
+    public init(lynxContext: LynxContext, withParam param: Any) {
+        self.lynxContext = lynxContext
+        super.init()
+    }
+
+    public override init() {
+        super.init()
+    }
+
+    public init(param: Any) {
+        super.init()
+    }
+
+    private func currentStatus() -> String {
+        switch SFSpeechRecognizer.authorizationStatus() {
+        case .authorized:
+            return "authorized"
+        case .denied, .restricted:
+            return "denied"
+        case .notDetermined:
+            return "notRequested"
+        @unknown default:
+            return "notRequested"
+        }
+    }
+
+    func getAuthorizationStatus(_ callback: @escaping (NSDictionary) -> Void) {
+        callback(["status": currentStatus()])
+    }
+
+    func requestAuthorization(_ callback: @escaping (NSDictionary) -> Void) {
+        SFSpeechRecognizer.requestAuthorization { [weak self] _ in
+            DispatchQueue.main.async {
+                callback(["status": self?.currentStatus() ?? "denied"])
+            }
+        }
+    }
+
+    func transcribeSample(_ callback: @escaping (NSDictionary) -> Void) {
+        guard currentStatus() == "authorized" else {
+            callback(["success": false, "error": "Speech access is not granted"])
+            return
+        }
+        guard let recognizer = recognizer, recognizer.isAvailable else {
+            callback(["success": false, "error": "Speech recognizer is not available"])
+            return
+        }
+        guard let url = Bundle.main.url(forResource: "sample", withExtension: "wav") else {
+            callback(["success": false, "error": "Sample audio file not found in bundle"])
+            return
+        }
+
+        recognitionTask?.cancel()
+        recognitionTask = nil
+
+        let request = SFSpeechURLRecognitionRequest(url: url)
+        request.shouldReportPartialResults = true
+
+        recognitionTask = recognizer.recognitionTask(with: request) { [weak self] result, error in
+            guard let self = self else { return }
+            if let error = error {
+                DispatchQueue.main.async {
+                    self.recognitionTask = nil
+                    callback(["success": false, "error": error.localizedDescription])
+                }
+                return
+            }
+            guard let result = result else { return }
+            let text = result.bestTranscription.formattedString
+            if result.isFinal {
+                DispatchQueue.main.async {
+                    self.recognitionTask = nil
+                    callback(["success": true, "transcript": text])
+                }
+            } else {
+                DispatchQueue.main.async {
+                    self.lynxContext?.sendGlobalEvent(NativeSpeechModule.partialResultEvent, withParams: [text])
+                }
+            }
+        }
+    }
+}
+
+#endif
