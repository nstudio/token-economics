diff --git a/src/pages/transcribe/App.vue b/src/pages/transcribe/App.vue
index c0f049d..8fff55c 100644
--- a/src/pages/transcribe/App.vue
+++ b/src/pages/transcribe/App.vue
@@ -1,11 +1,92 @@
 <script setup lang="ts">
+import { computed, onMounted, onUnmounted, ref } from 'vue-lynx'
 import { close } from 'sparkling-navigation'
 
 import './App.css'
+import { getAuthorizationStatus, requestAuthorization, transcribeSample } from './native'
+import type { SpeechAuthStatus } from './native'
+
+const VIEW_DID_APPEAR_EVENT = 'kHybridKitEventViewDidAppear'
+
+const authStatus = ref<SpeechAuthStatus>('notRequested')
+const errorText = ref<string | null>(null)
+const isTranscribing = ref(false)
+const transcript = ref('')
+const completedSeconds = ref<string | null>(null)
+
+const statusLine = computed(() => {
+  if (isTranscribing.value) {
+    return 'Transcribing…'
+  }
+  if (errorText.value) {
+    return errorText.value
+  }
+  switch (authStatus.value) {
+    case 'authorized':
+      return 'Speech access: granted'
+    case 'denied':
+      return 'Speech access: denied'
+    default:
+      return 'Speech access: not requested'
+  }
+})
+
+const canTranscribe = computed(() => authStatus.value === 'authorized' && !isTranscribing.value)
+
+async function refreshStatus() {
+  const result = await getAuthorizationStatus()
+  authStatus.value = result.status
+}
+
+async function requestAccess() {
+  errorText.value = null
+  const result = await requestAuthorization()
+  authStatus.value = result.status
+  if (result.error) {
+    errorText.value = result.error
+  }
+}
+
+async function transcribe() {
+  if (!canTranscribe.value) {
+    return
+  }
+  errorText.value = null
+  transcript.value = ''
+  completedSeconds.value = null
+  isTranscribing.value = true
+  const startedAt = Date.now()
+  try {
+    const result = await transcribeSample((partial) => {
+      transcript.value = partial
+    })
+    if (!result.success) {
+      errorText.value = result.error ?? 'Transcription failed'
+      return
+    }
+    transcript.value = result.transcript ?? ''
+    completedSeconds.value = ((Date.now() - startedAt) / 1000).toFixed(1)
+  } finally {
+    isTranscribing.value = false
+  }
+}
 
 function goBack() {
   close()
 }
+
+function onViewDidAppear() {
+  refreshStatus()
+}
+
+onMounted(() => {
+  refreshStatus()
+  lynx.getJSModule?.('GlobalEventEmitter')?.addListener?.(VIEW_DID_APPEAR_EVENT, onViewDidAppear)
+})
+
+onUnmounted(() => {
+  lynx.getJSModule?.('GlobalEventEmitter')?.removeListener?.(VIEW_DID_APPEAR_EVENT, onViewDidAppear)
+})
 </script>
 
 <template>
@@ -15,15 +96,17 @@ function goBack() {
         <text class="nav-back__text">← Home</text>
       </view>
       <view class="content">
-        <text class="status-line">Speech access: not requested</text>
-        <view class="button button--secondary">
+        <text class="status-line">{{ statusLine }}</text>
+        <view class="button button--secondary" @tap="requestAccess">
           <text class="button__text">Request Access</text>
         </view>
-        <view class="button button--disabled">
+        <view :class="['button', { 'button--disabled': !canTranscribe }]" @tap="transcribe">
           <text class="button__text">Transcribe Sample</text>
         </view>
         <view class="transcript">
-          <text class="transcript__text empty-state">No transcript yet</text>
+          <text v-if="transcript" class="transcript__text">{{ transcript }}</text>
+          <text v-else class="transcript__text empty-state">No transcript yet</text>
+          <text v-if="completedSeconds !== null" class="transcript__meta">Completed in {{ completedSeconds }} s</text>
         </view>
       </view>
     </view>
diff --git a/src/pages/transcribe/native.ts b/src/pages/transcribe/native.ts
new file mode 100644
index 0000000..14bf219
--- /dev/null
+++ b/src/pages/transcribe/native.ts
@@ -0,0 +1,42 @@
+export type SpeechAuthStatus = 'notRequested' | 'authorized' | 'denied'
+
+const PARTIAL_RESULT_EVENT = 'kNativeSpeechPartialResult'
+
+interface StatusResult {
+  status: SpeechAuthStatus
+  error?: string
+}
+
+interface TranscribeResult {
+  success: boolean
+  transcript?: string
+  error?: string
+}
+
+function speechModule() {
+  return NativeModules.NativeSpeechModule
+}
+
+export function getAuthorizationStatus(): Promise<StatusResult> {
+  return new Promise((resolve) => {
+    speechModule().getAuthorizationStatus((result: StatusResult) => resolve(result))
+  })
+}
+
+export function requestAuthorization(): Promise<StatusResult> {
+  return new Promise((resolve) => {
+    speechModule().requestAuthorization((result: StatusResult) => resolve(result))
+  })
+}
+
+export function transcribeSample(onPartial: (text: string) => void): Promise<TranscribeResult> {
+  const emitter = lynx.getJSModule?.('GlobalEventEmitter')
+  const onPartialResult = (text: string) => onPartial(text)
+  emitter?.addListener?.(PARTIAL_RESULT_EVENT, onPartialResult)
+  return new Promise((resolve) => {
+    speechModule().transcribeSample((result: TranscribeResult) => {
+      emitter?.removeListener?.(PARTIAL_RESULT_EVENT, onPartialResult)
+      resolve(result)
+    })
+  })
+}
