--- /dev/null
+++ b/modules/expo-speech-recognition/ios/ExpoSpeechRecognitionModule.swift
@@ -0,0 +1,83 @@
+import ExpoModulesCore
+import Speech
+
+public class ExpoSpeechRecognitionModule: Module {
+  private let recognizer = SFSpeechRecognizer(locale: Locale(identifier: "en-US"))
+  private var recognitionTask: SFSpeechRecognitionTask?
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoSpeechRecognition")
+
+    Events("onPartialTranscript")
+
+    Function("getAuthorizationStatus") {
+      self.statusString(SFSpeechRecognizer.authorizationStatus())
+    }
+
+    AsyncFunction("requestAuthorization") { () async -> String in
+      await withCheckedContinuation { (continuation: CheckedContinuation<String, Never>) in
+        SFSpeechRecognizer.requestAuthorization { status in
+          continuation.resume(returning: self.statusString(status))
+        }
+      }
+    }
+
+    AsyncFunction("transcribeSample") { () async throws -> String in
+      guard let recognizer = self.recognizer, recognizer.isAvailable else {
+        throw ExpoSpeechRecognitionError.unavailable
+      }
+      guard let url = Bundle.main.url(forResource: "sample", withExtension: "wav") else {
+        throw ExpoSpeechRecognitionError.missingSample
+      }
+
+      let request = SFSpeechURLRecognitionRequest(url: url)
+      request.shouldReportPartialResults = true
+
+      return try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<String, Error>) in
+        var didResume = false
+        self.recognitionTask = recognizer.recognitionTask(with: request) { result, error in
+          if didResume { return }
+          if let error {
+            didResume = true
+            continuation.resume(throwing: error)
+            return
+          }
+          guard let result else { return }
+          if result.isFinal {
+            didResume = true
+            continuation.resume(returning: result.bestTranscription.formattedString)
+          } else {
+            self.sendEvent("onPartialTranscript", ["text": result.bestTranscription.formattedString])
+          }
+        }
+      }
+    }
+  }
+
+  private func statusString(_ status: SFSpeechRecognizerAuthorizationStatus) -> String {
+    switch status {
+    case .authorized:
+      return "authorized"
+    case .denied, .restricted:
+      return "denied"
+    case .notDetermined:
+      fallthrough
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+}
+
+enum ExpoSpeechRecognitionError: Error, LocalizedError {
+  case unavailable
+  case missingSample
+
+  var errorDescription: String? {
+    switch self {
+    case .unavailable:
+      return "Speech recognition is not available on this device."
+    case .missingSample:
+      return "Bundled sample audio could not be found."
+    }
+  }
+}
