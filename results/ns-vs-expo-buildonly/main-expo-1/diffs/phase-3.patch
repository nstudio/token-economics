+import { NativeModule, requireNativeModule } from 'expo';
+
+import type { PartialTranscriptEvent, SpeechAuthorizationStatus } from './ExpoSpeechRecognition.types';
+
+type ExpoSpeechRecognitionEvents = {
+  onPartialTranscript: (event: PartialTranscriptEvent) => void;
+};
+
+declare class ExpoSpeechRecognitionModuleType extends NativeModule<ExpoSpeechRecognitionEvents> {
+  getAuthorizationStatus(): SpeechAuthorizationStatus;
+  requestAuthorization(): Promise<SpeechAuthorizationStatus>;
+  transcribeSample(): Promise<string>;
+}
+
+export default requireNativeModule<ExpoSpeechRecognitionModuleType>('ExpoSpeechRecognition');
