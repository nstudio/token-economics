diff --git a/plugins/withSampleAudio.ts b/plugins/withSampleAudio.ts
new file mode 100644
index 0000000..def0954
--- /dev/null
+++ b/plugins/withSampleAudio.ts
@@ -0,0 +1,40 @@
+import fs from 'fs';
+import path from 'path';
+
+import { withDangerousMod, withXcodeProject, ConfigPlugin } from '@expo/config-plugins';
+
+const SAMPLE_FILENAME = 'sample.wav';
+
+const withSampleAudio: ConfigPlugin = (config) => {
+  config = withDangerousMod(config, [
+    'ios',
+    (config) => {
+      const source = path.join(config.modRequest.projectRoot, 'spec-assets', SAMPLE_FILENAME);
+      const destDir = path.join(config.modRequest.platformProjectRoot, config.modRequest.projectName!);
+      fs.mkdirSync(destDir, { recursive: true });
+      fs.copyFileSync(source, path.join(destDir, SAMPLE_FILENAME));
+      return config;
+    },
+  ]);
+
+  config = withXcodeProject(config, (config) => {
+    const project = config.modResults;
+    const projectName = config.modRequest.projectName!;
+    const groupKey = project.findPBXGroupKey({ name: projectName });
+    // xcode's addResourceFile always looks up a group literally named "Resources"
+    // to rebase the file path against; this project has none, so create a
+    // detached placeholder to satisfy that lookup without affecting the tree.
+    if (!project.pbxGroupByName('Resources')) {
+      project.pbxCreateGroup('Resources', undefined);
+    }
+    // The target group has no explicit "path", so file paths are resolved relative
+    // to the project root — match the convention used by the template's own files
+    // (e.g. AppDelegate.swift is referenced as "ExpoBenchmark/AppDelegate.swift").
+    project.addResourceFile(`${projectName}/${SAMPLE_FILENAME}`, {}, groupKey);
+    return config;
+  });
+
+  return config;
+};
+
+export default withSampleAudio;
