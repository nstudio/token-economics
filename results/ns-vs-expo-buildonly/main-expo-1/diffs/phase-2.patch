+import { useFocusEffect } from '@react-navigation/native';
+import { useCallback, useState } from 'react';
 import { Pressable, StyleSheet, Text, View } from 'react-native';
 
+import ExpoHealth, { type DailySteps, type HealthAuthorizationStatus } from '../modules/expo-health';
+
+type DayRow = {
+  label: string;
+  steps: number;
+  isToday: boolean;
+};
+
+const STATUS_LABELS: Record<HealthAuthorizationStatus, string> = {
+  notDetermined: 'Health access: not requested',
+  authorized: 'Health access: granted',
+  denied: 'Health access: denied',
+};
+
+function formatDayLabel(date: Date): string {
+  const parts = new Intl.DateTimeFormat('en-US', {
+    weekday: 'short',
+    month: 'short',
+    day: 'numeric',
+  }).formatToParts(date);
+  const get = (type: Intl.DateTimeFormatPartTypes) => parts.find((part) => part.type === type)?.value ?? '';
+  return `${get('weekday')} ${get('month')} ${get('day')}`;
+}
+
+function toDayRows(days: DailySteps[]): DayRow[] {
+  return days.map((day, index) => ({
+    label: formatDayLabel(new Date(day.startOfDayMillis)),
+    steps: day.steps,
+    isToday: index === 0,
+  }));
+}
+
 export default function HealthScreen() {
+  const [status, setStatus] = useState<HealthAuthorizationStatus>('notDetermined');
+  const [statusMessage, setStatusMessage] = useState<string | null>(null);
+  const [days, setDays] = useState<DayRow[] | null>(null);
+  const [saving, setSaving] = useState(false);
+
+  const loadDays = useCallback(async () => {
+    try {
+      const result = await ExpoHealth.getDailySteps(7);
+      setDays(toDayRows(result));
+    } catch (error) {
+      setStatusMessage(error instanceof Error ? error.message : String(error));
+    }
+  }, []);
+
+  useFocusEffect(
+    useCallback(() => {
+      let cancelled = false;
+      (async () => {
+        const current = await ExpoHealth.getAuthorizationStatus();
+        if (cancelled) return;
+        setStatus(current);
+        if (current === 'authorized') {
+          await loadDays();
+        }
+      })();
+      return () => {
+        cancelled = true;
+      };
+    }, [loadDays])
+  );
+
+  const handleRequestAccess = useCallback(async () => {
+    try {
+      const result = await ExpoHealth.requestAuthorization();
+      setStatusMessage(null);
+      setStatus(result);
+      if (result === 'authorized') {
+        await loadDays();
+      }
+    } catch (error) {
+      setStatusMessage(error instanceof Error ? error.message : String(error));
+    }
+  }, [loadDays]);
+
+  const handleLogSteps = useCallback(async () => {
+    setSaving(true);
+    try {
+      await ExpoHealth.saveSteps(500);
+      setStatusMessage(null);
+      await loadDays();
+    } catch (error) {
+      setStatusMessage(error instanceof Error ? error.message : String(error));
+    } finally {
+      setSaving(false);
+    }
+  }, [loadDays]);
+
+  const canLog = status === 'authorized' && !saving;
+  const statusText = statusMessage ?? STATUS_LABELS[status];
+
   return (
     <View style={styles.container}>
-      <Text style={styles.status}>Health access: not requested</Text>
+      <Text style={styles.status}>{statusText}</Text>
 
       <View style={styles.buttons}>
-        <Pressable style={({ pressed }) => [styles.button, pressed && styles.buttonPressed]}>
+        <Pressable
+          style={({ pressed }) => [styles.button, pressed && styles.buttonPressed]}
+          onPress={handleRequestAccess}
+        >
           <Text style={styles.buttonText}>Request Access</Text>
         </Pressable>
-        <Pressable style={[styles.button, styles.buttonDisabled]} disabled>
-          <Text style={[styles.buttonText, styles.buttonTextDisabled]}>Log 500 Steps</Text>
+        <Pressable
+          style={[styles.button, !canLog && styles.buttonDisabled]}
+          disabled={!canLog}
+          onPress={handleLogSteps}
+        >
+          <Text style={[styles.buttonText, !canLog && styles.buttonTextDisabled]}>Log 500 Steps</Text>
         </Pressable>
       </View>
 
       <Text style={styles.sectionHeader}>Last 7 Days</Text>
-      <View style={styles.emptyState}>
-        <Text style={styles.emptyStateText}>No data yet</Text>
-      </View>
+      {status !== 'authorized' ? (
+        <View style={styles.emptyState}>
+          <Text style={styles.emptyStateText}>Health access needed</Text>
+        </View>
+      ) : days === null ? (
+        <View style={styles.emptyState}>
+          <Text style={styles.emptyStateText}>No data yet</Text>
+        </View>
+      ) : (
+        <View>
+          {days.map((day, index) => (
+            <View key={index} style={[styles.row, day.isToday && styles.rowToday]}>
+              <Text style={[styles.rowText, day.isToday && styles.rowTextToday]}>
+                {day.label} — {day.steps.toLocaleString('en-US')} steps
+                {day.isToday ? ' (today)' : ''}
+              </Text>
+            </View>
+          ))}
+        </View>
+      )}
     </View>
   );
 }
