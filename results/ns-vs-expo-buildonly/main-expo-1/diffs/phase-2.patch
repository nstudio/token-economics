+import { requireNativeModule } from 'expo';
+
+import type { DailySteps, HealthAuthorizationStatus } from './ExpoHealth.types';
+
+type ExpoHealthModuleType = {
+  getAuthorizationStatus(): HealthAuthorizationStatus;
+  requestAuthorization(): Promise<HealthAuthorizationStatus>;
+  saveSteps(steps: number): Promise<void>;
+  getDailySteps(days: number): Promise<DailySteps[]>;
+};
+
+export default requireNativeModule<ExpoHealthModuleType>('ExpoHealth');
