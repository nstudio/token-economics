diff --git a/plugins/withTranscribeSample.js b/plugins/withTranscribeSample.js
new file mode 100644
index 0000000..2a5a118
--- /dev/null
+++ b/plugins/withTranscribeSample.js
@@ -0,0 +1,29 @@
+const { withXcodeProject } = require('@expo/config-plugins');
+const { getProjectName, addResourceFileToGroup } = require('@expo/config-plugins/build/ios/utils/Xcodeproj');
+const fs = require('fs');
+const path = require('path');
+
+const SOURCE_PATH = path.join(__dirname, '..', 'spec-assets', 'sample.wav');
+
+const withTranscribeSample = (config) => {
+  return withXcodeProject(config, (config) => {
+    const projectRoot = config.modRequest.projectRoot;
+    const projectName = getProjectName(projectRoot);
+    fs.copyFileSync(SOURCE_PATH, path.join(projectRoot, 'ios', projectName, 'sample.wav'));
+
+    const filepath = `${projectName}/sample.wav`;
+    if (!config.modResults.hasFile(filepath)) {
+      config.modResults = addResourceFileToGroup({
+        filepath,
+        groupName: projectName,
+        project: config.modResults,
+        isBuildFile: true,
+        verbose: true,
+      });
+    }
+
+    return config;
+  });
+};
+
+module.exports = withTranscribeSample;
