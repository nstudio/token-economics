new file mode 100644
index 0000000..9059ce2
--- /dev/null
+++ b/modules/speech/src/ExpoSpeechModule.ts
@@ -0,0 +1,22 @@
+import { NativeModule, requireNativeModule } from 'expo';
+
+import type {
+  SpeechAuthorizationStatus,
+  SpeechPartialResultEvent,
+  SpeechFinalResultEvent,
+  SpeechTranscriptionErrorEvent,
+} from './ExpoSpeech.types';
+
+type ExpoSpeechModuleEvents = {
+  onPartialResult: (event: SpeechPartialResultEvent) => void;
+  onFinalResult: (event: SpeechFinalResultEvent) => void;
+  onTranscriptionError: (event: SpeechTranscriptionErrorEvent) => void;
+};
+
+declare class ExpoSpeechModule extends NativeModule<ExpoSpeechModuleEvents> {
+  getAuthorizationStatus(): SpeechAuthorizationStatus;
+  requestAuthorization(): Promise<SpeechAuthorizationStatus>;
+  startTranscription(): void;
+}
+
+export default requireNativeModule<ExpoSpeechModule>('ExpoSpeech');
