+import { useFocusEffect } from '@react-navigation/native';
+import { useCallback, useEffect, useRef, useState } from 'react';
 import { ScrollView, StyleSheet, Text, View } from 'react-native';
 
 import { Button } from '../components/Button';
+import { ExpoSpeechModule } from '../modules/speech/src';
+import type { SpeechAuthorizationStatus } from '../modules/speech/src';
+
+const STATUS_LABELS: Record<SpeechAuthorizationStatus, string> = {
+  notDetermined: 'Speech access: not requested',
+  authorized: 'Speech access: granted',
+  denied: 'Speech access: denied',
+};
+
+function formatError(err: unknown): string {
+  return err instanceof Error ? err.message : String(err);
+}
 
 export default function TranscribeScreen() {
+  const [status, setStatus] = useState<SpeechAuthorizationStatus>('notDetermined');
+  const [error, setError] = useState<string | null>(null);
+  const [isTranscribing, setIsTranscribing] = useState(false);
+  const [transcript, setTranscript] = useState<string | null>(null);
+  const [elapsedSeconds, setElapsedSeconds] = useState<number | null>(null);
+  const startedAtRef = useRef<number | null>(null);
+
+  useFocusEffect(
+    useCallback(() => {
+      setStatus(ExpoSpeechModule.getAuthorizationStatus());
+      setError(null);
+    }, [])
+  );
+
+  useEffect(() => {
+    const partialSub = ExpoSpeechModule.addListener('onPartialResult', ({ text }) => {
+      setTranscript(text);
+    });
+    const finalSub = ExpoSpeechModule.addListener('onFinalResult', ({ text }) => {
+      setTranscript(text);
+      const startedAt = startedAtRef.current;
+      setElapsedSeconds(startedAt !== null ? (Date.now() - startedAt) / 1000 : null);
+      setIsTranscribing(false);
+    });
+    const errorSub = ExpoSpeechModule.addListener('onTranscriptionError', ({ message }) => {
+      setError(message);
+      setIsTranscribing(false);
+    });
+
+    return () => {
+      partialSub.remove();
+      finalSub.remove();
+      errorSub.remove();
+    };
+  }, []);
+
+  const onRequestAccess = async () => {
+    try {
+      const result = await ExpoSpeechModule.requestAuthorization();
+      setStatus(result);
+      setError(null);
+    } catch (err) {
+      setError(formatError(err));
+    }
+  };
+
+  const onTranscribe = () => {
+    setError(null);
+    setTranscript(null);
+    setElapsedSeconds(null);
+    setIsTranscribing(true);
+    startedAtRef.current = Date.now();
+    try {
+      ExpoSpeechModule.startTranscription();
+    } catch (err) {
+      setError(formatError(err));
+      setIsTranscribing(false);
+    }
+  };
+
+  const statusLine = error ?? (isTranscribing ? 'Transcribing…' : STATUS_LABELS[status]);
+
   return (
     <ScrollView contentContainerStyle={styles.container}>
-      <Text style={styles.status}>Speech access: not requested</Text>
+      <Text style={styles.status}>{statusLine}</Text>
 
       <View style={styles.actions}>
-        <Button label="Request Access" onPress={() => {}} />
-        <Button label="Transcribe Sample" onPress={() => {}} disabled />
+        <Button label="Request Access" onPress={onRequestAccess} />
+        <Button
+          label="Transcribe Sample"
+          onPress={onTranscribe}
+          disabled={status !== 'authorized' || isTranscribing}
+        />
       </View>
 
       <View style={styles.transcriptArea}>
-        <Text style={styles.emptyStateText}>No transcript yet</Text>
+        {transcript ? (
+          <View style={styles.transcriptContent}>
+            <Text style={styles.transcriptText}>{transcript}</Text>
+            {elapsedSeconds !== null && (
+              <Text style={styles.completedText}>Completed in {elapsedSeconds.toFixed(1)} s</Text>
+            )}
+          </View>
+        ) : (
+          <Text style={styles.emptyStateText}>No transcript yet</Text>
+        )}
       </View>
     </ScrollView>
   );
