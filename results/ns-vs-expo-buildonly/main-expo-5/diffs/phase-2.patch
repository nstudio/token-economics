+import { useFocusEffect } from '@react-navigation/native';
+import { useCallback, useState } from 'react';
 import { ScrollView, StyleSheet, Text, View } from 'react-native';
 
 import { Button } from '../components/Button';
+import { ExpoHealthKitModule } from '../modules/health-kit/src';
+import type { DailySteps, HealthAuthorizationStatus } from '../modules/health-kit/src';
+
+const STATUS_LABELS: Record<HealthAuthorizationStatus, string> = {
+  notDetermined: 'Health access: not requested',
+  authorized: 'Health access: granted',
+  denied: 'Health access: denied',
+};
+
+const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
+const MONTHS = [
+  'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec',
+];
+
+function formatDayLabel(day: DailySteps): string {
+  const date = new Date(day.dayStartMillis);
+  const weekday = WEEKDAYS[date.getDay()];
+  const month = MONTHS[date.getMonth()];
+  const stepsLabel = day.steps.toLocaleString('en-US');
+  const label = `${weekday} ${month} ${date.getDate()} — ${stepsLabel} steps`;
+  return day.isToday ? `${label} (today)` : label;
+}
+
+function formatError(err: unknown): string {
+  return err instanceof Error ? err.message : String(err);
+}
 
 export default function HealthScreen() {
+  const [status, setStatus] = useState<HealthAuthorizationStatus>('notDetermined');
+  const [days, setDays] = useState<DailySteps[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [isLogging, setIsLogging] = useState(false);
+
+  const loadLast7Days = useCallback(async () => {
+    try {
+      const result = await ExpoHealthKitModule.getLast7DaysSteps();
+      setDays(result);
+      setError(null);
+    } catch (err) {
+      setError(formatError(err));
+    }
+  }, []);
+
+  useFocusEffect(
+    useCallback(() => {
+      let cancelled = false;
+
+      (async () => {
+        try {
+          const currentStatus = ExpoHealthKitModule.getAuthorizationStatus();
+          if (cancelled) return;
+          setStatus(currentStatus);
+          setError(null);
+          if (currentStatus === 'authorized') {
+            await loadLast7Days();
+          } else {
+            setDays(null);
+          }
+        } catch (err) {
+          if (!cancelled) setError(formatError(err));
+        }
+      })();
+
+      return () => {
+        cancelled = true;
+      };
+    }, [loadLast7Days])
+  );
+
+  const onRequestAccess = async () => {
+    try {
+      const result = await ExpoHealthKitModule.requestAuthorization();
+      setStatus(result);
+      setError(null);
+      if (result === 'authorized') {
+        await loadLast7Days();
+      } else {
+        setDays(null);
+      }
+    } catch (err) {
+      setError(formatError(err));
+    }
+  };
+
+  const onLogSteps = async () => {
+    setIsLogging(true);
+    try {
+      await ExpoHealthKitModule.logSteps(500);
+      setError(null);
+      await loadLast7Days();
+    } catch (err) {
+      setError(formatError(err));
+    } finally {
+      setIsLogging(false);
+    }
+  };
+
+  const statusLine = error ?? STATUS_LABELS[status];
+  const orderedDays = days ? [...days].reverse() : null;
+
   return (
     <ScrollView contentContainerStyle={styles.container}>
-      <Text style={styles.status}>Health access: not requested</Text>
+      <Text style={styles.status}>{statusLine}</Text>
 
       <View style={styles.actions}>
-        <Button label="Request Access" onPress={() => {}} />
-        <Button label="Log 500 Steps" onPress={() => {}} disabled />
+        <Button label="Request Access" onPress={onRequestAccess} />
+        <Button
+          label="Log 500 Steps"
+          onPress={onLogSteps}
+          disabled={status !== 'authorized' || isLogging}
+        />
       </View>
 
       <Text style={styles.sectionHeader}>Last 7 Days</Text>
-      <View style={styles.emptyState}>
-        <Text style={styles.emptyStateText}>No data yet</Text>
-      </View>
+      {status === 'authorized' && orderedDays ? (
+        <View style={styles.daysList}>
+          {orderedDays.map((day) => (
+            <Text
+              key={day.dayStartMillis}
+              style={[styles.dayRow, day.isToday && styles.dayRowToday]}
+            >
+              {formatDayLabel(day)}
+            </Text>
+          ))}
+        </View>
+      ) : (
+        <View style={styles.emptyState}>
+          <Text style={styles.emptyStateText}>
+            {status === 'authorized' ? 'No data yet' : 'Health access needed'}
+          </Text>
+        </View>
+      )}
     </ScrollView>
   );
 }
