+Pod::Spec.new do |s|
+  s.name           = 'ExpoHealthKit'
+  s.version        = '1.0.0'
+  s.summary        = 'Local HealthKit module for Native Bench'
+  s.description    = 'Wraps HealthKit step count read/write for the Native Bench Health screen'
+  s.author         = ''
+  s.homepage       = 'https://docs.expo.dev/modules/'
+  s.platforms      = {
+    :ios => '16.4'
+  }
+  s.source         = { git: '' }
+  s.static_framework = true
+
+  s.dependency 'ExpoModulesCore'
+  s.frameworks = 'HealthKit'
+
+  # Swift/Objective-C compatibility
+  s.pod_target_xcconfig = {
+    'DEFINES_MODULE' => 'YES',
+  }
+
+  s.source_files = "**/*.{h,m,mm,swift,hpp,cpp}"
+end
diff --git a/modules/health-kit/ios/ExpoHealthKitModule.swift b/modules/health-kit/ios/ExpoHealthKitModule.swift
new file mode 100644
index 0000000..4811942
--- /dev/null
+++ b/modules/health-kit/ios/ExpoHealthKitModule.swift
@@ -0,0 +1,113 @@
+import ExpoModulesCore
+import HealthKit
+
+public class ExpoHealthKitModule: Module {
+  private let healthStore = HKHealthStore()
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoHealthKit")
+
+    Function("getAuthorizationStatus") { () -> String in
+      guard let stepType = HKObjectType.quantityType(forIdentifier: .stepCount) else {
+        return "notDetermined"
+      }
+      return Self.statusString(for: self.healthStore.authorizationStatus(for: stepType))
+    }
+
+    AsyncFunction("requestAuthorization") { (promise: Promise) in
+      guard HKHealthStore.isHealthDataAvailable(), let stepType = HKObjectType.quantityType(forIdentifier: .stepCount) else {
+        promise.reject("ERR_HEALTHKIT_UNAVAILABLE", "Health data is not available on this device")
+        return
+      }
+      self.healthStore.requestAuthorization(toShare: [stepType], read: [stepType]) { _, error in
+        if let error = error {
+          promise.reject("ERR_HEALTHKIT_AUTH", error.localizedDescription)
+          return
+        }
+        promise.resolve(Self.statusString(for: self.healthStore.authorizationStatus(for: stepType)))
+      }
+    }
+
+    AsyncFunction("logSteps") { (count: Double, promise: Promise) in
+      guard let stepType = HKObjectType.quantityType(forIdentifier: .stepCount) else {
+        promise.reject("ERR_HEALTHKIT_UNAVAILABLE", "Step count type is unavailable")
+        return
+      }
+      let now = Date()
+      let sample = HKQuantitySample(
+        type: stepType,
+        quantity: HKQuantity(unit: .count(), doubleValue: count),
+        start: now,
+        end: now
+      )
+      self.healthStore.save(sample) { success, error in
+        if let error = error {
+          promise.reject("ERR_HEALTHKIT_SAVE", error.localizedDescription)
+        } else if !success {
+          promise.reject("ERR_HEALTHKIT_SAVE", "Failed to save step sample")
+        } else {
+          promise.resolve(nil)
+        }
+      }
+    }
+
+    AsyncFunction("getLast7DaysSteps") { (promise: Promise) in
+      guard let stepType = HKObjectType.quantityType(forIdentifier: .stepCount) else {
+        promise.reject("ERR_HEALTHKIT_UNAVAILABLE", "Step count type is unavailable")
+        return
+      }
+      let calendar = Calendar.current
+      let startOfToday = calendar.startOfDay(for: Date())
+      guard let startDate = calendar.date(byAdding: .day, value: -6, to: startOfToday) else {
+        promise.reject("ERR_HEALTHKIT_DATE", "Unable to compute the reporting date range")
+        return
+      }
+      let predicate = HKQuery.predicateForSamples(withStart: startDate, end: Date(), options: .strictStartDate)
+      let query = HKSampleQuery(
+        sampleType: stepType,
+        predicate: predicate,
+        limit: HKObjectQueryNoLimit,
+        sortDescriptors: nil
+      ) { _, samples, error in
+        if let error = error {
+          promise.reject("ERR_HEALTHKIT_QUERY", error.localizedDescription)
+          return
+        }
+        var totalsByDayOffset: [Int: Double] = [:]
+        for sample in (samples as? [HKQuantitySample]) ?? [] {
+          let dayStart = calendar.startOfDay(for: sample.startDate)
+          guard let dayOffset = calendar.dateComponents([.day], from: startOfToday, to: dayStart).day,
+            dayOffset >= -6, dayOffset <= 0
+          else {
+            continue
+          }
+          totalsByDayOffset[dayOffset, default: 0] += sample.quantity.doubleValue(for: .count())
+        }
+        var days: [[String: Any]] = []
+        for offset in stride(from: -6, through: 0, by: 1) {
+          let dayStart = calendar.date(byAdding: .day, value: offset, to: startOfToday) ?? startOfToday
+          days.append([
+            "dayStartMillis": dayStart.timeIntervalSince1970 * 1000,
+            "steps": Int(totalsByDayOffset[offset] ?? 0),
+            "isToday": offset == 0,
+          ])
+        }
+        promise.resolve(days)
+      }
+      self.healthStore.execute(query)
+    }
+  }
+
+  private static func statusString(for status: HKAuthorizationStatus) -> String {
+    switch status {
+    case .sharingAuthorized:
+      return "authorized"
+    case .sharingDenied:
+      return "denied"
+    case .notDetermined:
+      return "notDetermined"
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+}
