--- /dev/null
+++ b/modules/expo-speech/src/ExpoSpeechModule.ts
@@ -0,0 +1,13 @@
+import { NativeModule, requireNativeModule } from 'expo';
+
+import { PartialTranscriptEvent, SpeechAuthorizationStatus } from './ExpoSpeech.types';
+
+declare class ExpoSpeechModule extends NativeModule<{
+  onPartialTranscript(event: PartialTranscriptEvent): void;
+}> {
+  getAuthorizationStatus(): Promise<SpeechAuthorizationStatus>;
+  requestAuthorization(): Promise<SpeechAuthorizationStatus>;
+  transcribeSample(): Promise<string>;
+}
+
+export default requireNativeModule<ExpoSpeechModule>('ExpoSpeech');
diff --git a/plugins/withTranscribeSample.js b/plugins/withTranscribeSample.js
new file mode 100644
index 0000000..971c548
--- /dev/null
+++ b/plugins/withTranscribeSample.js
@@ -0,0 +1,38 @@
+const fs = require('fs');
+const path = require('path');
+const { withDangerousMod, withXcodeProject, IOSConfig } = require('@expo/config-plugins');
+
+const SOURCE_WAV = path.join(__dirname, '..', 'spec-assets', 'sample.wav');
+
+function withTranscribeSampleCopy(config) {
+  return withDangerousMod(config, [
+    'ios',
+    (config) => {
+      const sourceRoot = IOSConfig.Paths.getSourceRoot(config.modRequest.projectRoot);
+      fs.copyFileSync(SOURCE_WAV, path.join(sourceRoot, 'sample.wav'));
+      return config;
+    },
+  ]);
+}
+
+function withTranscribeSampleResource(config) {
+  return withXcodeProject(config, (config) => {
+    const project = config.modResults;
+    const projectName = path.basename(
+      IOSConfig.Paths.getSourceRoot(config.modRequest.projectRoot)
+    );
+    IOSConfig.XcodeUtils.addResourceFileToGroup({
+      filepath: path.join(projectName, 'sample.wav'),
+      groupName: projectName,
+      project,
+      isBuildFile: true,
+    });
+    return config;
+  });
+}
+
+module.exports = function withTranscribeSample(config) {
+  config = withTranscribeSampleCopy(config);
+  config = withTranscribeSampleResource(config);
+  return config;
+};
