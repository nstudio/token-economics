+import { NativeModule, requireNativeModule } from 'expo';
+
+import { DailySteps, HealthAuthorizationStatus } from './ExpoHealth.types';
+
+declare class ExpoHealthModule extends NativeModule<{}> {
+  getAuthorizationStatus(): Promise<HealthAuthorizationStatus>;
+  requestAuthorization(): Promise<HealthAuthorizationStatus>;
+  logSteps(count: number): Promise<void>;
+  getLast7DaysSteps(): Promise<DailySteps[]>;
+}
+
+export default requireNativeModule<ExpoHealthModule>('ExpoHealth');
