+import { useFocusEffect } from '@react-navigation/native';
+import { useCallback, useState } from 'react';
 import { StyleSheet, Text, View } from 'react-native';
 
 import Button from '../components/Button';
+import { DailySteps, HealthAuthorizationStatus } from '../modules/expo-health/src/ExpoHealth.types';
+import ExpoHealthModule from '../modules/expo-health/src/ExpoHealthModule';
+
+const STATUS_LABELS: Record<HealthAuthorizationStatus, string> = {
+  notDetermined: 'Health access: not requested',
+  authorized: 'Health access: granted',
+  denied: 'Health access: denied',
+};
+
+type DayRow = {
+  key: string;
+  label: string;
+  isToday: boolean;
+};
+
+function toMessage(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
+function buildDayRows(days: DailySteps[]): DayRow[] {
+  const today = new Date();
+  return [...days].reverse().map(({ startDateMillis, steps }) => {
+    const date = new Date(startDateMillis);
+    const isToday = date.toDateString() === today.toDateString();
+    const weekday = date.toLocaleDateString('en-US', { weekday: 'short' });
+    const month = date.toLocaleDateString('en-US', { month: 'short' });
+    const stepsLabel = Math.round(steps).toLocaleString('en-US');
+    const label = `${weekday} ${month} ${date.getDate()} — ${stepsLabel} steps${isToday ? ' (today)' : ''}`;
+    return { key: String(startDateMillis), label, isToday };
+  });
+}
 
 export default function HealthScreen() {
+  const [status, setStatus] = useState<HealthAuthorizationStatus>('notDetermined');
+  const [error, setError] = useState<string | null>(null);
+  const [days, setDays] = useState<DailySteps[] | null>(null);
+  const [logging, setLogging] = useState(false);
+
+  const refreshDays = useCallback(async () => {
+    try {
+      const result = await ExpoHealthModule.getLast7DaysSteps();
+      setDays(result);
+    } catch (e) {
+      setError(toMessage(e));
+    }
+  }, []);
+
+  useFocusEffect(
+    useCallback(() => {
+      let cancelled = false;
+      (async () => {
+        try {
+          const current = await ExpoHealthModule.getAuthorizationStatus();
+          if (cancelled) return;
+          setStatus(current);
+          setError(null);
+          if (current === 'authorized') {
+            await refreshDays();
+          }
+        } catch (e) {
+          if (!cancelled) setError(toMessage(e));
+        }
+      })();
+      return () => {
+        cancelled = true;
+      };
+    }, [refreshDays])
+  );
+
+  const handleRequestAccess = async () => {
+    try {
+      const next = await ExpoHealthModule.requestAuthorization();
+      setStatus(next);
+      setError(null);
+      if (next === 'authorized') {
+        await refreshDays();
+      }
+    } catch (e) {
+      setError(toMessage(e));
+    }
+  };
+
+  const handleLogSteps = async () => {
+    setLogging(true);
+    try {
+      await ExpoHealthModule.logSteps(500);
+      setError(null);
+      await refreshDays();
+    } catch (e) {
+      setError(toMessage(e));
+    } finally {
+      setLogging(false);
+    }
+  };
+
+  const statusText = error ?? STATUS_LABELS[status];
+  const rows = days ? buildDayRows(days) : [];
+
   return (
     <View style={styles.container}>
-      <Text style={styles.status}>Health access: not requested</Text>
+      <Text style={styles.status}>{statusText}</Text>
 
       <View style={styles.actions}>
-        <Button title="Request Access" onPress={() => {}} />
-        <Button title="Log 500 Steps" onPress={() => {}} disabled />
+        <Button title="Request Access" onPress={handleRequestAccess} />
+        <Button
+          title="Log 500 Steps"
+          onPress={handleLogSteps}
+          disabled={status !== 'authorized' || logging}
+        />
       </View>
 
       <Text style={styles.sectionHeader}>Last 7 Days</Text>
-      <View style={styles.emptyState}>
-        <Text style={styles.emptyStateText}>No data yet</Text>
-      </View>
+      {status === 'authorized' ? (
+        <View style={styles.list}>
+          {rows.map((row) => (
+            <Text key={row.key} style={[styles.row, row.isToday && styles.rowToday]}>
+              {row.label}
+            </Text>
+          ))}
+        </View>
+      ) : (
+        <View style={styles.emptyState}>
+          <Text style={styles.emptyStateText}>Health access needed</Text>
+        </View>
+      )}
     </View>
   );
 }
