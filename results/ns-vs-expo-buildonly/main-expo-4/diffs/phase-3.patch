+Pod::Spec.new do |s|
+  s.name           = 'ExpoSpeechBench'
+  s.version        = '1.0.0'
+  s.summary        = 'Local Speech framework access module for Native Bench'
+  s.description    = 'Wraps Speech recognition of the bundled sample audio for the Native Bench Transcribe screen'
+  s.author         = ''
+  s.homepage       = 'https://docs.expo.dev/modules/'
+  s.platforms      = {
+    :ios => '16.4',
+    :tvos => '16.4'
+  }
+  s.source         = { git: '' }
+  s.static_framework = true
+
+  s.dependency 'ExpoModulesCore'
+  s.frameworks = 'Speech'
+
+  # Swift/Objective-C compatibility
+  s.pod_target_xcconfig = {
+    'DEFINES_MODULE' => 'YES',
+  }
+
+  s.source_files = "**/*.{h,m,mm,swift,hpp,cpp}"
+  s.resource_bundles = {
+    'ExpoSpeechBench' => ['Resources/*']
+  }
+end
diff --git a/modules/expo-speech-bench/ios/ExpoSpeechBenchModule.swift b/modules/expo-speech-bench/ios/ExpoSpeechBenchModule.swift
new file mode 100644
index 0000000..61ce95d
--- /dev/null
+++ b/modules/expo-speech-bench/ios/ExpoSpeechBenchModule.swift
@@ -0,0 +1,75 @@
+import ExpoModulesCore
+import Speech
+
+public class ExpoSpeechBenchModule: Module {
+  private lazy var speechRecognizer = SFSpeechRecognizer(locale: Locale(identifier: "en-US"))
+  private var recognitionTask: SFSpeechRecognitionTask?
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoSpeechBench")
+
+    Events("onPartialTranscript")
+
+    AsyncFunction("getAuthorizationStatus") { () -> String in
+      self.statusString(SFSpeechRecognizer.authorizationStatus())
+    }
+
+    AsyncFunction("requestAuthorization") { (promise: Promise) in
+      SFSpeechRecognizer.requestAuthorization { status in
+        promise.resolve(self.statusString(status))
+      }
+    }
+
+    AsyncFunction("transcribeSample") { (promise: Promise) in
+      guard let recognizer = self.speechRecognizer, recognizer.isAvailable else {
+        promise.reject("E_SPEECH_UNAVAILABLE", "Speech recognizer is not available")
+        return
+      }
+      guard let audioURL = self.sampleAudioURL() else {
+        promise.reject("E_SPEECH_ASSET", "Bundled sample audio could not be located")
+        return
+      }
+
+      let request = SFSpeechURLRecognitionRequest(url: audioURL)
+      request.shouldReportPartialResults = true
+
+      self.recognitionTask = recognizer.recognitionTask(with: request) { result, error in
+        if let error = error {
+          promise.reject("E_SPEECH_RECOGNITION", error.localizedDescription)
+          self.recognitionTask = nil
+          return
+        }
+        guard let result = result else { return }
+        if result.isFinal {
+          promise.resolve(result.bestTranscription.formattedString)
+          self.recognitionTask = nil
+        } else {
+          self.sendEvent("onPartialTranscript", ["text": result.bestTranscription.formattedString])
+        }
+      }
+    }
+  }
+
+  private func statusString(_ status: SFSpeechRecognizerAuthorizationStatus) -> String {
+    switch status {
+    case .authorized:
+      return "authorized"
+    case .denied, .restricted:
+      return "denied"
+    case .notDetermined:
+      return "notDetermined"
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+
+  private func sampleAudioURL() -> URL? {
+    guard
+      let bundleURL = Bundle(for: ExpoSpeechBenchModule.self).url(forResource: "ExpoSpeechBench", withExtension: "bundle"),
+      let resourceBundle = Bundle(url: bundleURL)
+    else {
+      return nil
+    }
+    return resourceBundle.url(forResource: "sample", withExtension: "wav")
+  }
+}
