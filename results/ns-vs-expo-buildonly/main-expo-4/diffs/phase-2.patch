@@ -0,0 +1,12 @@
+import { NativeModule, requireNativeModule } from 'expo';
+
+import type { DayStepEntry, HealthAuthorizationStatus } from './ExpoHealthBench.types';
+
+declare class ExpoHealthBenchModule extends NativeModule<{}> {
+  getAuthorizationStatus(): Promise<HealthAuthorizationStatus>;
+  requestAuthorization(): Promise<HealthAuthorizationStatus>;
+  logSteps(count: number): Promise<void>;
+  getLast7DaysSteps(): Promise<DayStepEntry[]>;
+}
+
+export default requireNativeModule<ExpoHealthBenchModule>('ExpoHealthBench');
