@@ -1,23 +1,137 @@
+import { useFocusEffect } from '@react-navigation/native';
+import { useCallback, useState } from 'react';
 import { Pressable, StyleSheet, Text, View } from 'react-native';
 
+import ExpoHealthBench from '../modules/expo-health-bench/src/ExpoHealthBenchModule';
+import type {
+  DayStepEntry,
+  HealthAuthorizationStatus,
+} from '../modules/expo-health-bench/src/ExpoHealthBench.types';
+
+const STATUS_LABELS: Record<HealthAuthorizationStatus, string> = {
+  notDetermined: 'Health access: not requested',
+  authorized: 'Health access: granted',
+  denied: 'Health access: denied',
+};
+
+function formatDayLabel(startOfDayMillis: number): string {
+  const date = new Date(startOfDayMillis);
+  const weekday = date.toLocaleDateString('en-US', { weekday: 'short' });
+  const month = date.toLocaleDateString('en-US', { month: 'short' });
+  return `${weekday} ${month} ${date.getDate()}`;
+}
+
+function isToday(startOfDayMillis: number): boolean {
+  const date = new Date(startOfDayMillis);
+  const now = new Date();
+  return (
+    date.getFullYear() === now.getFullYear() &&
+    date.getMonth() === now.getMonth() &&
+    date.getDate() === now.getDate()
+  );
+}
+
+function messageFromError(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
 export default function HealthScreen() {
+  const [status, setStatus] = useState<HealthAuthorizationStatus>('notDetermined');
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [days, setDays] = useState<DayStepEntry[] | null>(null);
+  const [isLogging, setIsLogging] = useState(false);
+
+  const loadDays = useCallback(async () => {
+    try {
+      const result = await ExpoHealthBench.getLast7DaysSteps();
+      setDays(result);
+    } catch (error) {
+      setErrorMessage(messageFromError(error));
+    }
+  }, []);
+
+  useFocusEffect(
+    useCallback(() => {
+      (async () => {
+        try {
+          const current = await ExpoHealthBench.getAuthorizationStatus();
+          setStatus(current);
+          setErrorMessage(null);
+          if (current === 'authorized') {
+            await loadDays();
+          }
+        } catch (error) {
+          setErrorMessage(messageFromError(error));
+        }
+      })();
+    }, [loadDays])
+  );
+
+  const handleRequestAccess = async () => {
+    try {
+      const result = await ExpoHealthBench.requestAuthorization();
+      setStatus(result);
+      setErrorMessage(null);
+      if (result === 'authorized') {
+        await loadDays();
+      }
+    } catch (error) {
+      setErrorMessage(messageFromError(error));
+    }
+  };
+
+  const handleLogSteps = async () => {
+    setIsLogging(true);
+    try {
+      await ExpoHealthBench.logSteps(500);
+      setErrorMessage(null);
+      await loadDays();
+    } catch (error) {
+      setErrorMessage(messageFromError(error));
+    } finally {
+      setIsLogging(false);
+    }
+  };
+
+  const canLog = status === 'authorized' && !isLogging;
+  const statusLine = errorMessage ?? STATUS_LABELS[status];
+
   return (
     <View style={styles.container}>
-      <Text style={styles.status}>Health access: not requested</Text>
+      <Text style={styles.status}>{statusLine}</Text>
 
       <View style={styles.buttons}>
-        <Pressable style={styles.button}>
+        <Pressable style={styles.button} onPress={handleRequestAccess}>
           <Text style={styles.buttonText}>Request Access</Text>
         </Pressable>
-        <Pressable style={[styles.button, styles.buttonDisabled]} disabled>
-          <Text style={[styles.buttonText, styles.buttonTextDisabled]}>
+        <Pressable
+          style={[styles.button, !canLog && styles.buttonDisabled]}
+          disabled={!canLog}
+          onPress={handleLogSteps}>
+          <Text style={[styles.buttonText, !canLog && styles.buttonTextDisabled]}>
             Log 500 Steps
           </Text>
         </Pressable>
       </View>
 
       <Text style={styles.sectionHeader}>Last 7 Days</Text>
-      <Text style={styles.emptyState}>No data yet</Text>
+
+      {status !== 'authorized' ? (
+        <Text style={styles.emptyState}>Health access needed</Text>
+      ) : (
+        days?.map((day) => {
+          const today = isToday(day.startOfDayMillis);
+          const stepsLabel = Math.round(day.steps).toLocaleString('en-US');
+          return (
+            <Text
+              key={day.startOfDayMillis}
+              style={[styles.dayRow, today && styles.dayRowToday]}>
+              {formatDayLabel(day.startOfDayMillis)} — {stepsLabel} steps
+              {today ? ' (today)' : ''}
+            </Text>
+          );
+        })
+      )}
     </View>
   );
 }
