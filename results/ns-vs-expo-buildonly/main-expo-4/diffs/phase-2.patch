+  }
+  s.source         = { git: '' }
+  s.static_framework = true
+
+  s.dependency 'ExpoModulesCore'
+  s.frameworks = 'HealthKit'
+
+  # Swift/Objective-C compatibility
+  s.pod_target_xcconfig = {
+    'DEFINES_MODULE' => 'YES',
+  }
+
+  s.source_files = "**/*.{h,m,mm,swift,hpp,cpp}"
+end
diff --git a/modules/expo-health-bench/ios/ExpoHealthBenchModule.swift b/modules/expo-health-bench/ios/ExpoHealthBenchModule.swift
new file mode 100644
index 0000000..b82fc00
--- /dev/null
+++ b/modules/expo-health-bench/ios/ExpoHealthBenchModule.swift
@@ -0,0 +1,109 @@
+import ExpoModulesCore
+import HealthKit
+
+struct DayStepEntry: Record {
+  @Field var startOfDayMillis: Double = 0
+  @Field var steps: Double = 0
+}
+
+public class ExpoHealthBenchModule: Module {
+  private let healthStore = HKHealthStore()
+  private let stepType = HKQuantityType.quantityType(forIdentifier: .stepCount)!
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoHealthBench")
+
+    AsyncFunction("getAuthorizationStatus") { () -> String in
+      self.statusString(self.healthStore.authorizationStatus(for: self.stepType))
+    }
+
+    AsyncFunction("requestAuthorization") { (promise: Promise) in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        promise.reject("E_HEALTHKIT_UNAVAILABLE", "Health data is not available on this device")
+        return
+      }
+      self.healthStore.requestAuthorization(toShare: [self.stepType], read: [self.stepType]) { _, error in
+        if let error = error {
+          promise.reject("E_HEALTHKIT_AUTH", error.localizedDescription)
+          return
+        }
+        promise.resolve(self.statusString(self.healthStore.authorizationStatus(for: self.stepType)))
+      }
+    }
+
+    AsyncFunction("logSteps") { (count: Double, promise: Promise) in
+      let now = Date()
+      let quantity = HKQuantity(unit: .count(), doubleValue: count)
+      let sample = HKQuantitySample(type: self.stepType, quantity: quantity, start: now, end: now)
+      self.healthStore.save(sample) { success, error in
+        if let error = error {
+          promise.reject("E_HEALTHKIT_SAVE", error.localizedDescription)
+        } else if !success {
+          promise.reject("E_HEALTHKIT_SAVE", "Failed to save the step sample")
+        } else {
+          promise.resolve(nil)
+        }
+      }
+    }
+
+    AsyncFunction("getLast7DaysSteps") { (promise: Promise) in
+      self.fetchLast7DaysSteps(promise: promise)
+    }
+  }
+
+  private func statusString(_ status: HKAuthorizationStatus) -> String {
+    switch status {
+    case .sharingAuthorized:
+      return "authorized"
+    case .sharingDenied:
+      return "denied"
+    case .notDetermined:
+      return "notDetermined"
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+
+  private func fetchLast7DaysSteps(promise: Promise) {
+    let calendar = Calendar.current
+    let startOfToday = calendar.startOfDay(for: Date())
+    guard
+      let rangeStart = calendar.date(byAdding: .day, value: -6, to: startOfToday),
+      let rangeEnd = calendar.date(byAdding: .day, value: 1, to: startOfToday)
+    else {
+      promise.reject("E_HEALTHKIT_QUERY", "Failed to compute the date range")
+      return
+    }
+
+    var intervalComponents = DateComponents()
+    intervalComponents.day = 1
+
+    let predicate = HKQuery.predicateForSamples(withStart: rangeStart, end: rangeEnd, options: .strictStartDate)
+    let query = HKStatisticsCollectionQuery(
+      quantityType: stepType,
+      quantitySamplePredicate: predicate,
+      options: .cumulativeSum,
+      anchorDate: startOfToday,
+      intervalComponents: intervalComponents
+    )
+
+    query.initialResultsHandler = { _, results, error in
+      if let error = error {
+        promise.reject("E_HEALTHKIT_QUERY", error.localizedDescription)
+        return
+      }
+
+      var days: [DayStepEntry] = []
+      results?.enumerateStatistics(from: rangeStart, to: rangeEnd) { statistics, _ in
+        var entry = DayStepEntry()
+        entry.startOfDayMillis = statistics.startDate.timeIntervalSince1970 * 1000
+        entry.steps = statistics.sumQuantity()?.doubleValue(for: .count()) ?? 0
+        days.append(entry)
+      }
+      days.reverse()
+      promise.resolve(days)
+    }
+
+    healthStore.execute(query)
+  }
+}
