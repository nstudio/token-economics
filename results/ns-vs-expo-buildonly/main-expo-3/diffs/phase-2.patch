+import { useCallback, useState } from 'react';
 import { StyleSheet, Text, View } from 'react-native';
+import { useFocusEffect } from '@react-navigation/native';
 
 import { Button } from '../components/Button';
+import HealthKitStepModule from '../modules/health-kit-step/src/HealthKitStepModule';
+import type { HealthAuthorizationStatus } from '../modules/health-kit-step/src/HealthKitStep.types';
+
+const DAYS_TO_SHOW = 7;
+const WEEKDAY_LABELS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
+const MONTH_LABELS = [
+  'Jan',
+  'Feb',
+  'Mar',
+  'Apr',
+  'May',
+  'Jun',
+  'Jul',
+  'Aug',
+  'Sep',
+  'Oct',
+  'Nov',
+  'Dec',
+];
+
+type DayRow = {
+  key: string;
+  label: string;
+  isToday: boolean;
+};
+
+const STATUS_LABELS: Record<HealthAuthorizationStatus, string> = {
+  notDetermined: 'Health access: not requested',
+  authorized: 'Health access: granted',
+  denied: 'Health access: denied',
+};
+
+function formatRow(startOfDayMillis: number, steps: number, isToday: boolean): string {
+  const date = new Date(startOfDayMillis);
+  const dayLabel = `${WEEKDAY_LABELS[date.getDay()]} ${MONTH_LABELS[date.getMonth()]} ${date.getDate()}`;
+  const stepsLabel = `${Math.round(steps).toLocaleString('en-US')} steps`;
+  return isToday ? `${dayLabel} — ${stepsLabel} (today)` : `${dayLabel} — ${stepsLabel}`;
+}
 
 export default function HealthScreen() {
+  const [status, setStatus] = useState<HealthAuthorizationStatus>('notDetermined');
+  const [errorText, setErrorText] = useState<string | null>(null);
+  const [rows, setRows] = useState<DayRow[] | null>(null);
+  const [isLogging, setIsLogging] = useState(false);
+
+  const loadDailyTotals = useCallback(async () => {
+    const totals = await HealthKitStepModule.queryDailyTotals(DAYS_TO_SHOW);
+    const todayMillis = new Date().setHours(0, 0, 0, 0);
+    const sorted = [...totals].sort((a, b) => b.startOfDayMillis - a.startOfDayMillis);
+    setRows(
+      sorted.map((total) => ({
+        key: String(total.startOfDayMillis),
+        label: formatRow(total.startOfDayMillis, total.steps, total.startOfDayMillis === todayMillis),
+        isToday: total.startOfDayMillis === todayMillis,
+      }))
+    );
+  }, []);
+
+  const refresh = useCallback(async () => {
+    try {
+      const current = await HealthKitStepModule.getAuthorizationStatus();
+      setStatus(current);
+      setErrorText(null);
+      if (current === 'authorized') {
+        await loadDailyTotals();
+      } else {
+        setRows(null);
+      }
+    } catch (error) {
+      setErrorText(error instanceof Error ? error.message : String(error));
+    }
+  }, [loadDailyTotals]);
+
+  useFocusEffect(
+    useCallback(() => {
+      refresh();
+    }, [refresh])
+  );
+
+  const handleRequestAccess = async () => {
+    try {
+      const result = await HealthKitStepModule.requestAuthorization();
+      setStatus(result);
+      setErrorText(null);
+      if (result === 'authorized') {
+        await loadDailyTotals();
+      } else {
+        setRows(null);
+      }
+    } catch (error) {
+      setErrorText(error instanceof Error ? error.message : String(error));
+    }
+  };
+
+  const handleLogSteps = async () => {
+    setIsLogging(true);
+    try {
+      await HealthKitStepModule.logSteps(500);
+      setErrorText(null);
+      await loadDailyTotals();
+    } catch (error) {
+      setErrorText(error instanceof Error ? error.message : String(error));
+    } finally {
+      setIsLogging(false);
+    }
+  };
+
+  const statusLine = errorText ?? STATUS_LABELS[status];
+
   return (
     <View style={styles.container}>
-      <Text style={styles.status}>Health access: not requested</Text>
+      <Text style={styles.status}>{statusLine}</Text>
 
       <View style={styles.actions}>
-        <Button label="Request Access" onPress={() => {}} />
-        <Button label="Log 500 Steps" onPress={() => {}} disabled />
+        <Button label="Request Access" onPress={handleRequestAccess} />
+        <Button
+          label="Log 500 Steps"
+          onPress={handleLogSteps}
+          disabled={status !== 'authorized' || isLogging}
+        />
       </View>
 
       <Text style={styles.sectionHeader}>Last 7 Days</Text>
-      <View style={styles.emptyState}>
-        <Text style={styles.emptyStateText}>No data yet</Text>
-      </View>
+      {status !== 'authorized' ? (
+        <View style={styles.emptyState}>
+          <Text style={styles.emptyStateText}>
+            {status === 'denied' ? 'Health access needed' : 'No data yet'}
+          </Text>
+        </View>
+      ) : rows === null || rows.length === 0 ? (
+        <View style={styles.emptyState}>
+          <Text style={styles.emptyStateText}>No data yet</Text>
+        </View>
+      ) : (
+        <View style={styles.list}>
+          {rows.map((row) => (
+            <Text key={row.key} style={[styles.row, row.isToday && styles.rowToday]}>
+              {row.label}
+            </Text>
+          ))}
+        </View>
+      )}
     </View>
   );
 }
