@@ -0,0 +1,12 @@
+import { NativeModule, requireNativeModule } from 'expo';
+
+import type { DailyStepTotal, HealthAuthorizationStatus } from './HealthKitStep.types';
+
+declare class HealthKitStepModule extends NativeModule<{}> {
+  getAuthorizationStatus(): Promise<HealthAuthorizationStatus>;
+  requestAuthorization(): Promise<HealthAuthorizationStatus>;
+  logSteps(count: number): Promise<void>;
+  queryDailyTotals(days: number): Promise<DailyStepTotal[]>;
+}
+
+export default requireNativeModule<HealthKitStepModule>('HealthKitStep');
