diff --git a/modules/health-kit-step/ios/HealthKitStepModule.swift b/modules/health-kit-step/ios/HealthKitStepModule.swift
new file mode 100644
index 0000000..21cf712
--- /dev/null
+++ b/modules/health-kit-step/ios/HealthKitStepModule.swift
@@ -0,0 +1,106 @@
+import ExpoModulesCore
+import HealthKit
+
+enum HealthKitStepError: Error, LocalizedError {
+  case notAvailable
+
+  var errorDescription: String? {
+    switch self {
+    case .notAvailable:
+      return "Health data is not available on this device"
+    }
+  }
+}
+
+public class HealthKitStepModule: Module {
+  let healthStore = HKHealthStore()
+  let stepType = HKQuantityType.quantityType(forIdentifier: .stepCount)!
+
+  public func definition() -> ModuleDefinition {
+    Name("HealthKitStep")
+
+    AsyncFunction("getAuthorizationStatus") { () -> String in
+      self.authorizationStatusString()
+    }
+
+    AsyncFunction("requestAuthorization") { () -> String in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        throw HealthKitStepError.notAvailable
+      }
+      try await self.healthStore.requestAuthorization(toShare: [self.stepType], read: [self.stepType])
+      return self.authorizationStatusString()
+    }
+
+    AsyncFunction("logSteps") { (count: Double) in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        throw HealthKitStepError.notAvailable
+      }
+      let now = Date()
+      let quantity = HKQuantity(unit: .count(), doubleValue: count)
+      let sample = HKQuantitySample(type: self.stepType, quantity: quantity, start: now, end: now)
+      try await self.healthStore.save(sample)
+    }
+
+    AsyncFunction("queryDailyTotals") { (days: Int) -> [[String: Any]] in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        throw HealthKitStepError.notAvailable
+      }
+      return try await self.dailyTotals(days: days)
+    }
+  }
+
+  private func authorizationStatusString() -> String {
+    switch healthStore.authorizationStatus(for: stepType) {
+    case .notDetermined:
+      return "notDetermined"
+    case .sharingDenied:
+      return "denied"
+    case .sharingAuthorized:
+      return "authorized"
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+
+  private func dailyTotals(days: Int) async throws -> [[String: Any]] {
+    let calendar = Calendar.current
+    let startOfToday = calendar.startOfDay(for: Date())
+    guard let startDate = calendar.date(byAdding: .day, value: -(days - 1), to: startOfToday),
+      let endDate = calendar.date(byAdding: .day, value: 1, to: startOfToday)
+    else {
+      return []
+    }
+
+    let predicate = HKQuery.predicateForSamples(withStart: startDate, end: endDate, options: .strictStartDate)
+    var intervalComponents = DateComponents()
+    intervalComponents.day = 1
+
+    return try await withCheckedThrowingContinuation { continuation in
+      let query = HKStatisticsCollectionQuery(
+        quantityType: stepType,
+        quantitySamplePredicate: predicate,
+        options: .cumulativeSum,
+        anchorDate: startDate,
+        intervalComponents: intervalComponents
+      )
+
+      query.initialResultsHandler = { _, results, error in
+        if let error {
+          continuation.resume(throwing: error)
+          return
+        }
+        var totals: [[String: Any]] = []
+        results?.enumerateStatistics(from: startDate, to: endDate) { statistics, _ in
+          let steps = statistics.sumQuantity()?.doubleValue(for: .count()) ?? 0
+          totals.append([
+            "startOfDayMillis": statistics.startDate.timeIntervalSince1970 * 1000,
+            "steps": steps,
+          ])
+        }
+        continuation.resume(returning: totals)
+      }
+
+      healthStore.execute(query)
+    }
+  }
+}
