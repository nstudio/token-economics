@@ -0,0 +1,97 @@
+import ExpoModulesCore
+import Speech
+
+enum SpeechTranscribeError: Error, LocalizedError {
+  case notAuthorized
+  case recognizerUnavailable
+  case audioFileNotFound
+
+  var errorDescription: String? {
+    switch self {
+    case .notAuthorized:
+      return "Speech recognition access has not been granted"
+    case .recognizerUnavailable:
+      return "Speech recognizer is not available"
+    case .audioFileNotFound:
+      return "Sample audio file not found in app bundle"
+    }
+  }
+}
+
+public class SpeechTranscribeModule: Module {
+  private let recognizer = SFSpeechRecognizer(locale: Locale(identifier: "en-US"))
+  private var recognitionTask: SFSpeechRecognitionTask?
+
+  public func definition() -> ModuleDefinition {
+    Name("SpeechTranscribe")
+
+    Events("onPartialTranscript")
+
+    AsyncFunction("getAuthorizationStatus") { () -> String in
+      self.authorizationStatusString()
+    }
+
+    AsyncFunction("requestAuthorization") { () async -> String in
+      await withCheckedContinuation { continuation in
+        SFSpeechRecognizer.requestAuthorization { _ in
+          continuation.resume(returning: self.authorizationStatusString())
+        }
+      }
+    }
+
+    AsyncFunction("transcribeSample") { () async throws -> String in
+      try await self.transcribe()
+    }
+  }
+
+  private func authorizationStatusString() -> String {
+    switch SFSpeechRecognizer.authorizationStatus() {
+    case .notDetermined:
+      return "notDetermined"
+    case .authorized:
+      return "authorized"
+    case .denied, .restricted:
+      return "denied"
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+
+  private func transcribe() async throws -> String {
+    guard SFSpeechRecognizer.authorizationStatus() == .authorized else {
+      throw SpeechTranscribeError.notAuthorized
+    }
+    guard let recognizer = recognizer, recognizer.isAvailable else {
+      throw SpeechTranscribeError.recognizerUnavailable
+    }
+    guard let url = Bundle.main.url(forResource: "sample", withExtension: "wav") else {
+      throw SpeechTranscribeError.audioFileNotFound
+    }
+
+    let request = SFSpeechURLRecognitionRequest(url: url)
+    request.shouldReportPartialResults = true
+
+    return try await withCheckedThrowingContinuation { continuation in
+      var didFinish = false
+      self.recognitionTask = recognizer.recognitionTask(with: request) { result, error in
+        if didFinish {
+          return
+        }
+        if let error {
+          didFinish = true
+          continuation.resume(throwing: error)
+          return
+        }
+        guard let result else {
+          return
+        }
+        let transcript = result.bestTranscription.formattedString
+        self.sendEvent("onPartialTranscript", ["transcript": transcript])
+        if result.isFinal {
+          didFinish = true
+          continuation.resume(returning: transcript)
+        }
+      }
+    }
+  }
+}
