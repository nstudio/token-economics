+import { useCallback, useEffect, useState } from 'react';
 import { StyleSheet, Text, View } from 'react-native';
+import { useFocusEffect } from '@react-navigation/native';
 
 import { Button } from '../components/Button';
+import SpeechTranscribeModule from '../modules/speech-transcribe/src/SpeechTranscribeModule';
+import type { SpeechAuthorizationStatus } from '../modules/speech-transcribe/src/SpeechTranscribe.types';
+
+const STATUS_LABELS: Record<SpeechAuthorizationStatus, string> = {
+  notDetermined: 'Speech access: not requested',
+  authorized: 'Speech access: granted',
+  denied: 'Speech access: denied',
+};
 
 export default function TranscribeScreen() {
+  const [status, setStatus] = useState<SpeechAuthorizationStatus>('notDetermined');
+  const [errorText, setErrorText] = useState<string | null>(null);
+  const [transcript, setTranscript] = useState<string | null>(null);
+  const [elapsedSeconds, setElapsedSeconds] = useState<number | null>(null);
+  const [isTranscribing, setIsTranscribing] = useState(false);
+
+  const refresh = useCallback(async () => {
+    try {
+      const current = await SpeechTranscribeModule.getAuthorizationStatus();
+      setStatus(current);
+      setErrorText(null);
+    } catch (error) {
+      setErrorText(error instanceof Error ? error.message : String(error));
+    }
+  }, []);
+
+  useFocusEffect(
+    useCallback(() => {
+      refresh();
+    }, [refresh])
+  );
+
+  useEffect(() => {
+    const subscription = SpeechTranscribeModule.addListener('onPartialTranscript', (event) => {
+      setTranscript(event.transcript);
+    });
+    return () => subscription.remove();
+  }, []);
+
+  const handleRequestAccess = async () => {
+    try {
+      const result = await SpeechTranscribeModule.requestAuthorization();
+      setStatus(result);
+      setErrorText(null);
+    } catch (error) {
+      setErrorText(error instanceof Error ? error.message : String(error));
+    }
+  };
+
+  const handleTranscribe = async () => {
+    setIsTranscribing(true);
+    setErrorText(null);
+    setTranscript(null);
+    setElapsedSeconds(null);
+    const startedAt = Date.now();
+    try {
+      const finalTranscript = await SpeechTranscribeModule.transcribeSample();
+      setTranscript(finalTranscript);
+      setElapsedSeconds((Date.now() - startedAt) / 1000);
+    } catch (error) {
+      setErrorText(error instanceof Error ? error.message : String(error));
+    } finally {
+      setIsTranscribing(false);
+    }
+  };
+
+  const statusLine = errorText ?? (isTranscribing ? 'Transcribing…' : STATUS_LABELS[status]);
+
   return (
     <View style={styles.container}>
-      <Text style={styles.status}>Speech access: not requested</Text>
+      <Text style={styles.status}>{statusLine}</Text>
 
       <View style={styles.actions}>
-        <Button label="Request Access" onPress={() => {}} />
-        <Button label="Transcribe Sample" onPress={() => {}} disabled />
+        <Button label="Request Access" onPress={handleRequestAccess} />
+        <Button
+          label="Transcribe Sample"
+          onPress={handleTranscribe}
+          disabled={status !== 'authorized' || isTranscribing}
+        />
       </View>
 
       <View style={styles.transcriptArea}>
-        <Text style={styles.emptyStateText}>No transcript yet</Text>
+        {transcript === null ? (
+          <View style={styles.emptyState}>
+            <Text style={styles.emptyStateText}>No transcript yet</Text>
+          </View>
+        ) : (
+          <>
+            <Text style={styles.transcriptText}>{transcript}</Text>
+            {elapsedSeconds !== null && (
+              <Text style={styles.completedText}>Completed in {elapsedSeconds.toFixed(1)} s</Text>
+            )}
+          </>
+        )}
       </View>
     </View>
   );
