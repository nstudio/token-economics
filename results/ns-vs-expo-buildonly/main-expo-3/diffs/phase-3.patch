+import { NativeModule, requireNativeModule } from 'expo';
+
+import type { SpeechAuthorizationStatus, SpeechTranscribeModuleEvents } from './SpeechTranscribe.types';
+
+declare class SpeechTranscribeModule extends NativeModule<SpeechTranscribeModuleEvents> {
+  getAuthorizationStatus(): Promise<SpeechAuthorizationStatus>;
+  requestAuthorization(): Promise<SpeechAuthorizationStatus>;
+  transcribeSample(): Promise<string>;
+}
+
+export default requireNativeModule<SpeechTranscribeModule>('SpeechTranscribe');
