                 <Label text="Last 7 Days" class="mt-6 text-lg font-bold" />
-                <Label text="No data yet" class="mt-2 text-gray-500" textWrap="true" />
+                <Label v-if="!authGranted" text="Health access needed" class="mt-2 text-gray-500" textWrap="true" />
+                <StackLayout v-else class="mt-2">
+                    <Label v-if="dayRows.length === 0" text="No data yet" class="text-gray-500" textWrap="true" />
+                    <Label
+                        v-for="(row, i) in dayRows"
+                        :key="i"
+                        :text="row.text"
+                        textWrap="true"
+                        :class="row.isToday ? 'mt-1 font-bold text-blue-600' : 'mt-1 text-gray-800'"
+                    />
+                </StackLayout>
             </StackLayout>
         </ScrollView>
     </Page>
 </template>
 
-<script setup lang="ts"></script>
+<script setup lang="ts">
+import { ref } from 'nativescript-vue'
+import { Utils } from '@nativescript/core'
+
+interface DayRow {
+    text: string
+    isToday: boolean
+}
+
+const statusText = ref('Health access: not requested')
+const authGranted = ref(false)
+const canLog = ref(false)
+const dayRows = ref<DayRow[]>([])
+
+let healthStore: HKHealthStore | null = null
+let stepType: HKQuantityType | null = null
+
+function getStore(): HKHealthStore {
+    if (!healthStore) {
+        healthStore = HKHealthStore.new()
+    }
+    return healthStore
+}
+
+function getStepType(): HKQuantityType {
+    if (!stepType) {
+        stepType = HKQuantityType.quantityTypeForIdentifier(HKQuantityTypeIdentifierStepCount)
+    }
+    return stepType
+}
+
+function formatSteps(steps: number): string {
+    return `${Math.round(steps).toLocaleString('en-US')} steps`
+}
+
+function queryDaySteps(dayStart: Date, dayEnd: Date): Promise<number> {
+    return new Promise((resolve) => {
+        const predicate = HKQuery.predicateForSamplesWithStartDateEndDateOptions(dayStart, dayEnd, HKQueryOptions.StrictStartDate)
+        const query = HKStatisticsQuery.alloc().initWithQuantityTypeQuantitySamplePredicateOptionsCompletionHandler(
+            getStepType(),
+            predicate,
+            HKStatisticsOptions.CumulativeSum,
+            (_query, result, error) => {
+                if (error || !result) {
+                    resolve(0)
+                    return
+                }
+                const sum = result.sumQuantity()
+                resolve(sum ? sum.doubleValueForUnit(HKUnit.countUnit()) : 0)
+            }
+        )
+        getStore().executeQuery(query)
+    })
+}
+
+async function loadLast7Days() {
+    const todayStart = new Date()
+    todayStart.setHours(0, 0, 0, 0)
+
+    const rows: DayRow[] = []
+    for (let i = 0; i < 7; i++) {
+        const dayStart = new Date(todayStart)
+        dayStart.setDate(todayStart.getDate() - i)
+        const dayEnd = new Date(dayStart)
+        dayEnd.setDate(dayStart.getDate() + 1)
+        const isToday = i === 0
+
+        const steps = await queryDaySteps(dayStart, dayEnd)
+        const label = dayStart.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }).replace(',', '')
+        const text = `${label} — ${formatSteps(steps)}`
+
+        rows.push({ text: isToday ? `${text} (today)` : text, isToday })
+    }
+
+    dayRows.value = rows
+}
+
+function refreshStatus() {
+    if (!HKHealthStore.isHealthDataAvailable()) {
+        statusText.value = 'Health access: denied'
+        authGranted.value = false
+        canLog.value = false
+        dayRows.value = []
+        return
+    }
+
+    const status = getStore().authorizationStatusForType(getStepType())
+    if (status === HKAuthorizationStatus.SharingAuthorized) {
+        statusText.value = 'Health access: granted'
+        authGranted.value = true
+    } else if (status === HKAuthorizationStatus.SharingDenied) {
+        statusText.value = 'Health access: denied'
+        authGranted.value = false
+    } else {
+        statusText.value = 'Health access: not requested'
+        authGranted.value = false
+    }
+
+    canLog.value = authGranted.value
+
+    if (authGranted.value) {
+        loadLast7Days()
+    } else {
+        dayRows.value = []
+    }
+}
+
+function requestAccess() {
+    if (!HKHealthStore.isHealthDataAvailable()) {
+        statusText.value = 'Health access: denied'
+        return
+    }
+
+    const shareTypes = NSSet.setWithObject<HKSampleType>(getStepType())
+    const readTypes = NSSet.setWithObject<HKObjectType>(getStepType())
+
+    getStore().requestAuthorizationToShareTypesReadTypesCompletion(shareTypes, readTypes, (success, error) => {
+        Utils.dispatchToMainThread(() => {
+            if (!success && error) {
+                statusText.value = `Request failed: ${error.localizedDescription}`
+                return
+            }
+            refreshStatus()
+        })
+    })
+}
+
+function logSteps() {
+    const quantity = HKQuantity.quantityWithUnitDoubleValue(HKUnit.countUnit(), 500)
+    const now = new Date()
+    const sample = HKQuantitySample.quantitySampleWithTypeQuantityStartDateEndDate(getStepType(), quantity, now, now)
+
+    getStore().saveObjectWithCompletion(sample, (success, error) => {
+        Utils.dispatchToMainThread(() => {
+            if (!success) {
+                statusText.value = `Save failed: ${error ? error.localizedDescription : 'unknown error'}`
+                return
+            }
+            loadLast7Days()
+        })
+    })
+}
+
+function onNavigatedTo() {
+    refreshStatus()
+}
+</script>
