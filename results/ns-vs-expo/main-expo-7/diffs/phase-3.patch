@@ -0,0 +1,7 @@
+export type SpeechAuthorizationStatus = 'notDetermined' | 'authorized' | 'denied';
+
+export type ExpoSpeechModuleEvents = {
+  onPartialResult: (payload: { transcript: string }) => void;
+  onFinalResult: (payload: { transcript: string }) => void;
+  onError: (payload: { message: string }) => void;
+};
diff --git a/modules/expo-speech/src/ExpoSpeechModule.ts b/modules/expo-speech/src/ExpoSpeechModule.ts
new file mode 100644
index 0000000..09f2f1b
--- /dev/null
+++ b/modules/expo-speech/src/ExpoSpeechModule.ts
@@ -0,0 +1,11 @@
+import { NativeModule, requireNativeModule } from 'expo';
+
+import { ExpoSpeechModuleEvents, SpeechAuthorizationStatus } from './ExpoSpeech.types';
+
+declare class ExpoSpeechModule extends NativeModule<ExpoSpeechModuleEvents> {
+  getAuthorizationStatus(): Promise<SpeechAuthorizationStatus>;
+  requestAuthorization(): Promise<SpeechAuthorizationStatus>;
+  transcribeSample(): void;
+}
+
+export default requireNativeModule<ExpoSpeechModule>('ExpoSpeech');
diff --git a/plugins/withSpeechSample.js b/plugins/withSpeechSample.js
new file mode 100644
index 0000000..992cfac
--- /dev/null
+++ b/plugins/withSpeechSample.js
@@ -0,0 +1,24 @@
+const { withXcodeProject, IOSConfig } = require('@expo/config-plugins');
+const path = require('path');
+
+module.exports = function withSpeechSample(config) {
+  return withXcodeProject(config, (config) => {
+    const project = config.modResults;
+    const platformProjectRoot = config.modRequest.platformProjectRoot;
+    const projectRoot = config.modRequest.projectRoot;
+    const relativePath = path.relative(
+      platformProjectRoot,
+      path.join(projectRoot, 'spec-assets', 'sample.wav')
+    );
+
+    IOSConfig.XcodeUtils.ensureGroupRecursively(project, 'Resources');
+    IOSConfig.XcodeUtils.addResourceFileToGroup({
+      filepath: relativePath,
+      groupName: 'Resources',
+      project,
+      isBuildFile: true,
+    });
+
+    return config;
+  });
+};
