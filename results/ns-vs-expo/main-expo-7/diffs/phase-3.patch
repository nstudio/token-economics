diff --git a/modules/expo-speech/ios/ExpoSpeechModule.swift b/modules/expo-speech/ios/ExpoSpeechModule.swift
new file mode 100644
index 0000000..2045e21
--- /dev/null
+++ b/modules/expo-speech/ios/ExpoSpeechModule.swift
@@ -0,0 +1,94 @@
+import ExpoModulesCore
+import Speech
+
+final class SpeechSampleUnavailableException: Exception {
+  override var reason: String {
+    "The bundled sample audio file could not be found."
+  }
+}
+
+final class SpeechRecognizerUnavailableException: Exception {
+  override var reason: String {
+    "Speech recognition is not available on this device."
+  }
+}
+
+final class SpeechAlreadyRunningException: Exception {
+  override var reason: String {
+    "A transcription is already in progress."
+  }
+}
+
+public class ExpoSpeechModule: Module {
+  private var recognitionTask: SFSpeechRecognitionTask?
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoSpeech")
+
+    Events("onPartialResult", "onFinalResult", "onError")
+
+    AsyncFunction("getAuthorizationStatus") { () -> String in
+      Self.statusString(SFSpeechRecognizer.authorizationStatus())
+    }
+
+    AsyncFunction("requestAuthorization") { () async -> String in
+      await withCheckedContinuation { continuation in
+        SFSpeechRecognizer.requestAuthorization { status in
+          continuation.resume(returning: Self.statusString(status))
+        }
+      }
+    }
+
+    Function("transcribeSample") {
+      try self.startTranscription()
+    }
+  }
+
+  private func startTranscription() throws {
+    guard recognitionTask == nil else {
+      throw SpeechAlreadyRunningException()
+    }
+    guard let url = Bundle.main.url(forResource: "sample", withExtension: "wav") else {
+      throw SpeechSampleUnavailableException()
+    }
+    guard let recognizer = SFSpeechRecognizer(locale: Locale(identifier: "en-US")) else {
+      throw SpeechRecognizerUnavailableException()
+    }
+
+    let request = SFSpeechURLRecognitionRequest(url: url)
+    request.shouldReportPartialResults = true
+
+    recognitionTask = recognizer.recognitionTask(with: request) { [weak self] result, error in
+      guard let self = self else { return }
+
+      if let error = error {
+        self.recognitionTask = nil
+        self.sendEvent("onError", ["message": error.localizedDescription])
+        return
+      }
+
+      guard let result = result else { return }
+      let transcript = result.bestTranscription.formattedString
+
+      if result.isFinal {
+        self.recognitionTask = nil
+        self.sendEvent("onFinalResult", ["transcript": transcript])
+      } else {
+        self.sendEvent("onPartialResult", ["transcript": transcript])
+      }
+    }
+  }
+
+  private static func statusString(_ status: SFSpeechRecognizerAuthorizationStatus) -> String {
+    switch status {
+    case .notDetermined:
+      return "notDetermined"
+    case .authorized:
+      return "authorized"
+    case .denied, .restricted:
+      return "denied"
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+}
