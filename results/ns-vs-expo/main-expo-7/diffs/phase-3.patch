+import { useCallback, useEffect, useRef, useState } from 'react';
 import { Pressable, StyleSheet, Text, View } from 'react-native';
 
 import ScreenHeader from './ScreenHeader';
+import ExpoSpeechModule from '../modules/expo-speech/src/ExpoSpeechModule';
+import { SpeechAuthorizationStatus } from '../modules/expo-speech/src/ExpoSpeech.types';
 
 type Props = {
   onBack: () => void;
 };
 
+const STATUS_LABEL: Record<SpeechAuthorizationStatus, string> = {
+  notDetermined: 'Speech access: not requested',
+  authorized: 'Speech access: granted',
+  denied: 'Speech access: denied',
+};
+
+function messageFor(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
 export default function TranscribeScreen({ onBack }: Props) {
+  const [authStatus, setAuthStatus] = useState<SpeechAuthorizationStatus>('notDetermined');
+  const [statusLine, setStatusLine] = useState(STATUS_LABEL.notDetermined);
+  const [isRunning, setIsRunning] = useState(false);
+  const [transcript, setTranscript] = useState<string | null>(null);
+  const [completedSeconds, setCompletedSeconds] = useState<string | null>(null);
+  const startedAtRef = useRef(0);
+
+  const refreshStatus = useCallback(async (knownStatus?: SpeechAuthorizationStatus) => {
+    try {
+      const status = knownStatus ?? (await ExpoSpeechModule.getAuthorizationStatus());
+      setAuthStatus(status);
+      setStatusLine(STATUS_LABEL[status]);
+    } catch (error) {
+      setStatusLine(messageFor(error));
+    }
+  }, []);
+
+  useEffect(() => {
+    refreshStatus();
+  }, [refreshStatus]);
+
+  useEffect(() => {
+    const subscriptions = [
+      ExpoSpeechModule.addListener('onPartialResult', ({ transcript }) => {
+        setTranscript(transcript);
+      }),
+      ExpoSpeechModule.addListener('onFinalResult', ({ transcript }) => {
+        setTranscript(transcript);
+        setCompletedSeconds(((Date.now() - startedAtRef.current) / 1000).toFixed(1));
+        setIsRunning(false);
+        setStatusLine(STATUS_LABEL.authorized);
+      }),
+      ExpoSpeechModule.addListener('onError', ({ message }) => {
+        setIsRunning(false);
+        setStatusLine(message);
+      }),
+    ];
+
+    return () => subscriptions.forEach((subscription) => subscription.remove());
+  }, []);
+
+  const handleRequestAccess = async () => {
+    try {
+      const status = await ExpoSpeechModule.requestAuthorization();
+      await refreshStatus(status);
+    } catch (error) {
+      setStatusLine(messageFor(error));
+    }
+  };
+
+  const handleTranscribe = () => {
+    try {
+      setTranscript(null);
+      setCompletedSeconds(null);
+      setIsRunning(true);
+      setStatusLine('Transcribing…');
+      startedAtRef.current = Date.now();
+      ExpoSpeechModule.transcribeSample();
+    } catch (error) {
+      setIsRunning(false);
+      setStatusLine(messageFor(error));
+    }
+  };
+
+  const canTranscribe = authStatus === 'authorized' && !isRunning;
+
   return (
     <View style={styles.container}>
       <ScreenHeader title="Transcribe" onBack={onBack} />
 
       <View style={styles.content}>
-        <Text style={styles.statusLine}>Speech access: not requested</Text>
+        <Text style={styles.statusLine}>{statusLine}</Text>
 
-        <Pressable style={styles.button}>
+        <Pressable style={styles.button} onPress={handleRequestAccess}>
           <Text style={styles.buttonText}>Request Access</Text>
         </Pressable>
 
-        <Pressable style={[styles.button, styles.buttonDisabled]} disabled>
-          <Text style={[styles.buttonText, styles.buttonTextDisabled]}>Transcribe Sample</Text>
+        <Pressable
+          style={[styles.button, !canTranscribe && styles.buttonDisabled]}
+          disabled={!canTranscribe}
+          onPress={handleTranscribe}
+        >
+          <Text style={[styles.buttonText, !canTranscribe && styles.buttonTextDisabled]}>Transcribe Sample</Text>
         </Pressable>
 
         <View style={styles.transcriptArea}>
-          <Text style={styles.emptyState}>No transcript yet</Text>
+          {transcript === null && <Text style={styles.emptyState}>No transcript yet</Text>}
+          {transcript !== null && <Text style={styles.transcriptText}>{transcript}</Text>}
+          {completedSeconds !== null && <Text style={styles.completedLine}>Completed in {completedSeconds} s</Text>}
         </View>
       </View>
     </View>
@@ -74,4 +159,14 @@ const styles = StyleSheet.create({
     fontSize: 15,
     color: '#999',
   },
+  transcriptText: {
+    fontSize: 15,
+    color: '#1a1a1a',
+    lineHeight: 22,
+  },
+  completedLine: {
+    fontSize: 13,
+    color: '#666',
+    marginTop: 8,
+  },
 });
