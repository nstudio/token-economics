+import { useCallback, useEffect, useState } from 'react';
 import { Pressable, StyleSheet, Text, View } from 'react-native';
 
 import ScreenHeader from './ScreenHeader';
+import ExpoHealthModule from '../modules/expo-health/src/ExpoHealthModule';
+import { DailyStepTotal, HealthAuthorizationStatus } from '../modules/expo-health/src/ExpoHealth.types';
 
 type Props = {
   onBack: () => void;
 };
 
+const STATUS_LABEL: Record<HealthAuthorizationStatus, string> = {
+  notDetermined: 'Health access: not requested',
+  authorized: 'Health access: granted',
+  denied: 'Health access: denied',
+};
+
+const WEEKDAY_FORMATTER = new Intl.DateTimeFormat('en-US', { weekday: 'short' });
+const MONTH_DAY_FORMATTER = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' });
+const STEP_FORMATTER = new Intl.NumberFormat('en-US');
+
+function formatDayLabel(date: Date): string {
+  return `${WEEKDAY_FORMATTER.format(date)} ${MONTH_DAY_FORMATTER.format(date)}`;
+}
+
+function isSameDay(a: Date, b: Date): boolean {
+  return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
+}
+
+function messageFor(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
 export default function HealthScreen({ onBack }: Props) {
+  const [authStatus, setAuthStatus] = useState<HealthAuthorizationStatus>('notDetermined');
+  const [statusLine, setStatusLine] = useState(STATUS_LABEL.notDetermined);
+  const [days, setDays] = useState<DailyStepTotal[] | null>(null);
+
+  const loadDailySteps = useCallback(async () => {
+    try {
+      const totals = await ExpoHealthModule.getDailySteps(7);
+      setDays(totals);
+    } catch (error) {
+      setStatusLine(messageFor(error));
+    }
+  }, []);
+
+  const refreshStatus = useCallback(
+    async (knownStatus?: HealthAuthorizationStatus) => {
+      try {
+        const status = knownStatus ?? (await ExpoHealthModule.getStepAuthorizationStatus());
+        setAuthStatus(status);
+        setStatusLine(STATUS_LABEL[status]);
+        if (status === 'authorized') {
+          await loadDailySteps();
+        }
+      } catch (error) {
+        setStatusLine(messageFor(error));
+      }
+    },
+    [loadDailySteps]
+  );
+
+  useEffect(() => {
+    refreshStatus();
+  }, [refreshStatus]);
+
+  const handleRequestAccess = async () => {
+    try {
+      const status = await ExpoHealthModule.requestStepAuthorization();
+      await refreshStatus(status);
+    } catch (error) {
+      setStatusLine(messageFor(error));
+    }
+  };
+
+  const handleLogSteps = async () => {
+    try {
+      await ExpoHealthModule.saveSteps(500);
+      await loadDailySteps();
+    } catch (error) {
+      setStatusLine(messageFor(error));
+    }
+  };
+
+  const canLog = authStatus === 'authorized';
+  const today = new Date();
+  const sortedDays = days ? [...days].sort((a, b) => b.startOfDayMillis - a.startOfDayMillis) : null;
+
   return (
     <View style={styles.container}>
       <ScreenHeader title="Health" onBack={onBack} />
 
       <View style={styles.content}>
-        <Text style={styles.statusLine}>Health access: not requested</Text>
+        <Text style={styles.statusLine}>{statusLine}</Text>
 
-        <Pressable style={styles.button}>
+        <Pressable style={styles.button} onPress={handleRequestAccess}>
           <Text style={styles.buttonText}>Request Access</Text>
         </Pressable>
 
-        <Pressable style={[styles.button, styles.buttonDisabled]} disabled>
-          <Text style={[styles.buttonText, styles.buttonTextDisabled]}>Log 500 Steps</Text>
+        <Pressable
+          style={[styles.button, !canLog && styles.buttonDisabled]}
+          disabled={!canLog}
+          onPress={handleLogSteps}
+        >
+          <Text style={[styles.buttonText, !canLog && styles.buttonTextDisabled]}>Log 500 Steps</Text>
         </Pressable>
 
         <Text style={styles.sectionHeader}>Last 7 Days</Text>
-        <Text style={styles.emptyState}>No data yet</Text>
+
+        {!canLog && <Text style={styles.emptyState}>Health access needed</Text>}
+        {canLog && !sortedDays && <Text style={styles.emptyState}>No data yet</Text>}
+        {canLog &&
+          sortedDays &&
+          sortedDays.map((day) => {
+            const date = new Date(day.startOfDayMillis);
+            const isToday = isSameDay(date, today);
+            return (
+              <Text key={day.startOfDayMillis} style={[styles.dayRow, isToday && styles.dayRowToday]}>
+                {formatDayLabel(date)} — {STEP_FORMATTER.format(Math.round(day.steps))} steps
+                {isToday ? ' (today)' : ''}
+              </Text>
+            );
+          })}
       </View>
     </View>
   );
@@ -72,4 +170,13 @@ const styles = StyleSheet.create({
     fontSize: 15,
     color: '#999',
   },
+  dayRow: {
+    fontSize: 15,
+    color: '#333',
+    paddingVertical: 6,
+  },
+  dayRowToday: {
+    fontWeight: '700',
+    color: '#007aff',
+  },
 });
