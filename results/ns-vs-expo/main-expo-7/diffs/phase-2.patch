--- /dev/null
+++ b/modules/expo-health/src/ExpoHealthModule.ts
@@ -0,0 +1,12 @@
+import { NativeModule, requireNativeModule } from 'expo';
+
+import { DailyStepTotal, HealthAuthorizationStatus } from './ExpoHealth.types';
+
+declare class ExpoHealthModule extends NativeModule<{}> {
+  getStepAuthorizationStatus(): Promise<HealthAuthorizationStatus>;
+  requestStepAuthorization(): Promise<HealthAuthorizationStatus>;
+  saveSteps(count: number): Promise<void>;
+  getDailySteps(days: number): Promise<DailyStepTotal[]>;
+}
+
+export default requireNativeModule<ExpoHealthModule>('ExpoHealth');
