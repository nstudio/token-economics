diff --git a/modules/expo-health/ios/ExpoHealthModule.swift b/modules/expo-health/ios/ExpoHealthModule.swift
new file mode 100644
index 0000000..e409171
--- /dev/null
+++ b/modules/expo-health/ios/ExpoHealthModule.swift
@@ -0,0 +1,111 @@
+import ExpoModulesCore
+import HealthKit
+
+final class HealthDataUnavailableException: Exception {
+  override var reason: String {
+    "Health data is not available on this device."
+  }
+}
+
+final class StepTypeUnavailableException: Exception {
+  override var reason: String {
+    "The step count type is not available on this device."
+  }
+}
+
+public class ExpoHealthModule: Module {
+  private let healthStore = HKHealthStore()
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoHealth")
+
+    AsyncFunction("getStepAuthorizationStatus") { () throws -> String in
+      try self.authorizationStatusString()
+    }
+
+    AsyncFunction("requestStepAuthorization") { () async throws -> String in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        throw HealthDataUnavailableException()
+      }
+      let stepType = try self.stepType()
+      try await self.healthStore.requestAuthorization(toShare: [stepType], read: [stepType])
+      return try self.authorizationStatusString()
+    }
+
+    AsyncFunction("saveSteps") { (count: Double) async throws in
+      let stepType = try self.stepType()
+      let quantity = HKQuantity(unit: .count(), doubleValue: count)
+      let now = Date()
+      let sample = HKQuantitySample(type: stepType, quantity: quantity, start: now, end: now)
+      try await self.healthStore.save(sample)
+    }
+
+    AsyncFunction("getDailySteps") { (days: Int) async throws -> [[String: Any]] in
+      try await self.dailyStepTotals(days: days)
+    }
+  }
+
+  private func stepType() throws -> HKQuantityType {
+    guard let type = HKQuantityType.quantityType(forIdentifier: .stepCount) else {
+      throw StepTypeUnavailableException()
+    }
+    return type
+  }
+
+  private func authorizationStatusString() throws -> String {
+    switch healthStore.authorizationStatus(for: try stepType()) {
+    case .notDetermined:
+      return "notDetermined"
+    case .sharingDenied:
+      return "denied"
+    case .sharingAuthorized:
+      return "authorized"
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+
+  private func dailyStepTotals(days: Int) async throws -> [[String: Any]] {
+    let stepType = try stepType()
+    let calendar = Calendar.current
+    let startOfToday = calendar.startOfDay(for: Date())
+
+    guard
+      let startDate = calendar.date(byAdding: .day, value: -(days - 1), to: startOfToday),
+      let endDate = calendar.date(byAdding: .day, value: 1, to: startOfToday)
+    else {
+      throw StepTypeUnavailableException()
+    }
+
+    let predicate = HKQuery.predicateForSamples(withStart: startDate, end: endDate, options: .strictStartDate)
+    var interval = DateComponents()
+    interval.day = 1
+
+    let query = HKStatisticsCollectionQuery(
+      quantityType: stepType,
+      quantitySamplePredicate: predicate,
+      options: .cumulativeSum,
+      anchorDate: startOfToday,
+      intervalComponents: interval
+    )
+
+    return try await withCheckedThrowingContinuation { continuation in
+      query.initialResultsHandler = { _, results, error in
+        if let error = error {
+          continuation.resume(throwing: error)
+          return
+        }
+        var totals: [[String: Any]] = []
+        results?.enumerateStatistics(from: startDate, to: endDate) { statistics, _ in
+          let steps = statistics.sumQuantity()?.doubleValue(for: .count()) ?? 0
+          totals.append([
+            "startOfDayMillis": statistics.startDate.timeIntervalSince1970 * 1000,
+            "steps": steps,
+          ])
+        }
+        continuation.resume(returning: totals)
+      }
+      self.healthStore.execute(query)
+    }
+  }
+}
