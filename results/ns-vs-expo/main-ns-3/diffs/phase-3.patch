@@ -1,12 +1,119 @@
 <template>
-    <Page>
+    <Page @navigatedTo="onNavigatedTo">
         <ActionBar title="Transcribe" />
 
         <GridLayout rows="auto, auto, auto, *" class="px-6 pt-4">
-            <Label row="0" text="Speech access: not requested" class="text-base text-gray-500 mb-4" textWrap="true" />
-            <Button row="1" text="Request Access" class="mb-3 py-3 text-lg font-semibold text-white bg-blue-500 rounded-xl" />
-            <Button row="2" text="Transcribe Sample" :isEnabled="false" class="mb-6 py-3 text-lg font-semibold text-gray-400 bg-gray-200 rounded-xl" />
-            <Label row="3" text="No transcript yet" class="text-gray-400 text-center" verticalAlignment="top" />
+            <Label row="0" :text="statusText" class="text-base text-gray-500 mb-4" textWrap="true" />
+            <Button row="1" text="Request Access" class="mb-3 py-3 text-lg font-semibold text-white bg-blue-500 rounded-xl" @tap="requestAccess" />
+            <Button
+                row="2"
+                text="Transcribe Sample"
+                :isEnabled="canTranscribe"
+                :class="canTranscribe
+                    ? 'mb-6 py-3 text-lg font-semibold text-white bg-blue-500 rounded-xl'
+                    : 'mb-6 py-3 text-lg font-semibold text-gray-400 bg-gray-200 rounded-xl'"
+                @tap="transcribe"
+            />
+            <ScrollView row="3">
+                <StackLayout>
+                    <Label
+                        :text="transcript || 'No transcript yet'"
+                        :class="transcript ? 'text-base' : 'text-gray-400 text-center'"
+                        textWrap="true"
+                    />
+                    <Label v-if="completedText" :text="completedText" class="text-sm text-gray-500 pt-2" textWrap="true" />
+                </StackLayout>
+            </ScrollView>
         </GridLayout>
     </Page>
 </template>
+
+<script setup lang="ts">
+import { ref, computed } from 'nativescript-vue'
+import { Utils, knownFolders } from '@nativescript/core'
+
+const statusText = ref('Speech access: not requested')
+const accessGranted = ref(false)
+const isTranscribing = ref(false)
+const transcript = ref('')
+const completedText = ref('')
+
+const canTranscribe = computed(() => accessGranted.value && !isTranscribing.value)
+
+function authStatusText(status: SFSpeechRecognizerAuthorizationStatus): string {
+    switch (status) {
+        case SFSpeechRecognizerAuthorizationStatus.Authorized:
+            return 'Speech access: granted'
+        case SFSpeechRecognizerAuthorizationStatus.Denied:
+        case SFSpeechRecognizerAuthorizationStatus.Restricted:
+            return 'Speech access: denied'
+        default:
+            return 'Speech access: not requested'
+    }
+}
+
+function refreshAuthStatus() {
+    const status = SFSpeechRecognizer.authorizationStatus()
+    statusText.value = authStatusText(status)
+    accessGranted.value = status === SFSpeechRecognizerAuthorizationStatus.Authorized
+}
+
+function onNavigatedTo() {
+    refreshAuthStatus()
+}
+
+function requestAccess() {
+    SFSpeechRecognizer.requestAuthorization(() => {
+        Utils.dispatchToMainThread(() => {
+            refreshAuthStatus()
+        })
+    })
+}
+
+function transcribe() {
+    transcript.value = ''
+    completedText.value = ''
+    isTranscribing.value = true
+    statusText.value = 'Transcribing…'
+
+    const startedAt = Date.now()
+
+    try {
+        const path = `${knownFolders.currentApp().path}/assets/sample.wav`
+        const url = NSURL.fileURLWithPath(path)
+        const request = new SFSpeechURLRecognitionRequest({ URL: url })
+        request.shouldReportPartialResults = true
+        const locale = NSLocale.alloc().initWithLocaleIdentifier('en-US')
+        const recognizer = new SFSpeechRecognizer({ locale })
+
+        if (!recognizer || !recognizer.available) {
+            isTranscribing.value = false
+            statusText.value = 'Transcription failed: speech recognizer unavailable'
+            return
+        }
+
+        recognizer.recognitionTaskWithRequestResultHandler(request, (result, error) => {
+            Utils.dispatchToMainThread(() => {
+                if (error) {
+                    isTranscribing.value = false
+                    statusText.value = `Transcription failed: ${error.localizedDescription}`
+                    return
+                }
+                if (!result) {
+                    return
+                }
+                transcript.value = result.bestTranscription.formattedString
+                if (result.final) {
+                    const elapsedSeconds = (Date.now() - startedAt) / 1000
+                    completedText.value = `Completed in ${elapsedSeconds.toFixed(1)} s`
+                    isTranscribing.value = false
+                    refreshAuthStatus()
+                }
+            })
+        })
+    } catch (error) {
+        isTranscribing.value = false
+        statusText.value = `Transcription failed: ${error}`
+    }
+}
+</script>
