-<script setup lang="ts"></script>
+<script setup lang="ts">
+import { computed, ref } from 'vue'
+import { Utils } from '@nativescript/core'
+
+type AccessState = 'not-requested' | 'granted' | 'denied'
+
+const accessState = ref<AccessState>('not-requested')
+const statusText = ref('Speech access: not requested')
+const transcript = ref('')
+const completedLine = ref('')
+const isTranscribing = ref(false)
+
+const canTranscribe = computed(() => accessState.value === 'granted' && !isTranscribing.value)
+
+// Retained outside the tap handler so the runtime doesn't GC them mid-recognition.
+let recognizer: SFSpeechRecognizer | null = null
+let recognitionTask: SFSpeechRecognitionTask | null = null
+let startedAt = 0
+
+function refreshAuthStatus() {
+    const status = SFSpeechRecognizer.authorizationStatus()
+    if (status === SFSpeechRecognizerAuthorizationStatus.Authorized) {
+        accessState.value = 'granted'
+        statusText.value = 'Speech access: granted'
+    } else if (status === SFSpeechRecognizerAuthorizationStatus.Denied || status === SFSpeechRecognizerAuthorizationStatus.Restricted) {
+        accessState.value = 'denied'
+        statusText.value = 'Speech access: denied'
+    } else {
+        accessState.value = 'not-requested'
+        statusText.value = 'Speech access: not requested'
+    }
+}
+
+function onNavigatingTo() {
+    refreshAuthStatus()
+}
+
+function requestAccess() {
+    SFSpeechRecognizer.requestAuthorization(() => {
+        Utils.dispatchToMainThread(() => {
+            refreshAuthStatus()
+        })
+    })
+}
+
+function transcribeSample() {
+    const path = NSBundle.mainBundle.pathForResourceOfType('sample', 'wav')
+    if (!path) {
+        statusText.value = 'sample.wav not found in app bundle'
+        return
+    }
+
+    recognizer = SFSpeechRecognizer.alloc().initWithLocale(NSLocale.alloc().initWithLocaleIdentifier('en-US'))
+    if (!recognizer.available) {
+        statusText.value = 'Speech recognizer not available'
+        return
+    }
+
+    const request = SFSpeechURLRecognitionRequest.alloc().initWithURL(NSURL.fileURLWithPath(path))
+    request.shouldReportPartialResults = true
+    // The iOS Simulator lacks on-device speech models; force server-based recognition (spec permits either).
+    request.requiresOnDeviceRecognition = false
+
+    transcript.value = ''
+    completedLine.value = ''
+    isTranscribing.value = true
+    statusText.value = 'Transcribing…'
+    startedAt = Date.now()
+
+    recognitionTask = recognizer.recognitionTaskWithRequestResultHandler(request, (result, error) => {
+        Utils.dispatchToMainThread(() => {
+            if (error) {
+                isTranscribing.value = false
+                statusText.value = error.localizedDescription
+                return
+            }
+            if (!result) {
+                return
+            }
+
+            transcript.value = result.bestTranscription.formattedString
+
+            if (result.final) {
+                const elapsedSeconds = (Date.now() - startedAt) / 1000
+                completedLine.value = `Completed in ${elapsedSeconds.toFixed(1)} s`
+                isTranscribing.value = false
+                statusText.value = 'Speech access: granted'
+            }
+        })
+    })
+}
+</script>
