 <template>
-    <Page>
+    <Page @navigatedTo="refreshAuthStatus">
         <ActionBar title="Transcribe" />
 
         <ScrollView>
             <StackLayout class="p-6">
-                <Label text="Speech access: not requested" class="text-base text-gray-500" textWrap="true" />
+                <Label :text="statusText" class="text-base text-gray-500" textWrap="true" />
 
-                <Button text="Request Access" class="mt-4 p-3 bg-blue-500 text-white rounded" />
-                <Button text="Transcribe Sample" :isEnabled="false" class="mt-2 p-3 bg-gray-300 text-white rounded" />
+                <Button text="Request Access" class="mt-4 p-3 bg-blue-500 text-white rounded" @tap="requestAccess" />
+                <Button
+                    text="Transcribe Sample"
+                    :isEnabled="canTranscribe"
+                    :class="canTranscribe ? 'mt-2 p-3 bg-blue-500 text-white rounded' : 'mt-2 p-3 bg-gray-300 text-white rounded'"
+                    @tap="transcribeSample"
+                />
 
-                <Label text="No transcript yet" class="mt-6 text-gray-500" textWrap="true" />
+                <Label :text="transcript || 'No transcript yet'" class="mt-6 text-gray-700" textWrap="true" />
+                <Label v-if="completedText" :text="completedText" class="mt-1 text-gray-500" textWrap="true" />
             </StackLayout>
         </ScrollView>
     </Page>
 </template>
 
 <script setup lang="ts">
+import { ref, computed } from 'vue'
+import { Utils, knownFolders } from '@nativescript/core'
+
+type SpeechAccessState = 'not-requested' | 'granted' | 'denied'
+
+const statusText = ref('Speech access: not requested')
+const speechAccessState = ref<SpeechAccessState>('not-requested')
+const accessGranted = ref(false)
+const isTranscribing = ref(false)
+const transcript = ref('')
+const completedText = ref('')
+
+const canTranscribe = computed(() => accessGranted.value && !isTranscribing.value)
+
+let recognizer: SFSpeechRecognizer | null = null
+
+function getRecognizer(): SFSpeechRecognizer {
+  if (!recognizer) {
+    recognizer = SFSpeechRecognizer.new()
+  }
+  return recognizer
+}
+
+function applyAuthStatus(status: SFSpeechRecognizerAuthorizationStatus) {
+  if (status === SFSpeechRecognizerAuthorizationStatus.Authorized) {
+    speechAccessState.value = 'granted'
+    accessGranted.value = true
+    statusText.value = 'Speech access: granted'
+  } else if (status === SFSpeechRecognizerAuthorizationStatus.Denied || status === SFSpeechRecognizerAuthorizationStatus.Restricted) {
+    speechAccessState.value = 'denied'
+    accessGranted.value = false
+    statusText.value = 'Speech access: denied'
+  } else {
+    speechAccessState.value = 'not-requested'
+    accessGranted.value = false
+    statusText.value = 'Speech access: not requested'
+  }
+}
+
+function refreshAuthStatus() {
+  applyAuthStatus(SFSpeechRecognizer.authorizationStatus())
+}
+
+function requestAccess() {
+  SFSpeechRecognizer.requestAuthorization((status) => {
+    Utils.dispatchToMainThread(() => {
+      applyAuthStatus(status)
+    })
+  })
+}
+
+function transcribeSample() {
+  if (!canTranscribe.value) {
+    return
+  }
+
+  const fileUrl = NSURL.fileURLWithPath(`${knownFolders.currentApp().path}/assets/sample.wav`)
+  const request = new SFSpeechURLRecognitionRequest({ URL: fileUrl })
+  request.shouldReportPartialResults = true
+
+  isTranscribing.value = true
+  statusText.value = 'Transcribing…'
+  transcript.value = ''
+  completedText.value = ''
+
+  const startTime = Date.now()
+
+  getRecognizer().recognitionTaskWithRequestResultHandler(request, (result, error) => {
+    Utils.dispatchToMainThread(() => {
+      if (error) {
+        isTranscribing.value = false
+        statusText.value = error.localizedDescription
+        return
+      }
+      if (!result) {
+        return
+      }
+
+      transcript.value = result.bestTranscription.formattedString
+
+      if (result.final) {
+        const elapsedSeconds = (Date.now() - startTime) / 1000
+        completedText.value = `Completed in ${elapsedSeconds.toFixed(1)} s`
+        isTranscribing.value = false
+        statusText.value = 'Speech access: granted'
+      }
+    })
+  })
+}
 </script>
