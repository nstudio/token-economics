+import { useCallback, useEffect, useState } from 'react';
 import { StyleSheet, Text, View, Pressable } from 'react-native';
 
 import ScreenHeader from './ScreenHeader';
+import ExpoHealth, { DailyStepTotal, HealthAuthorizationStatus } from '../modules/expo-health';
 
 type Props = {
   onBack: () => void;
 };
 
+const STATUS_LABEL: Record<HealthAuthorizationStatus, string> = {
+  notDetermined: 'Health access: not requested',
+  authorized: 'Health access: granted',
+  denied: 'Health access: denied',
+};
+
+function formatDayLabel(timestamp: number): string {
+  return new Date(timestamp)
+    .toLocaleDateString('en-US', {
+      weekday: 'short',
+      month: 'short',
+      day: 'numeric',
+    })
+    .replace(',', '');
+}
+
+function formatSteps(steps: number): string {
+  return Math.round(steps).toLocaleString('en-US');
+}
+
 export default function HealthScreen({ onBack }: Props) {
+  const [authStatus, setAuthStatus] = useState<HealthAuthorizationStatus>('notDetermined');
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [dailyTotals, setDailyTotals] = useState<DailyStepTotal[] | null>(null);
+
+  const loadDailyTotals = useCallback(async () => {
+    try {
+      const totals = await ExpoHealth.getDailyStepTotals(7);
+      setDailyTotals(totals);
+    } catch (error) {
+      setErrorMessage(error instanceof Error ? error.message : String(error));
+    }
+  }, []);
+
+  useEffect(() => {
+    (async () => {
+      try {
+        const status = await ExpoHealth.getAuthorizationStatus();
+        setAuthStatus(status);
+        if (status === 'authorized') {
+          await loadDailyTotals();
+        }
+      } catch (error) {
+        setErrorMessage(error instanceof Error ? error.message : String(error));
+      }
+    })();
+  }, [loadDailyTotals]);
+
+  const handleRequestAccess = async () => {
+    setErrorMessage(null);
+    try {
+      const status = await ExpoHealth.requestAuthorization();
+      setAuthStatus(status);
+      if (status === 'authorized') {
+        await loadDailyTotals();
+      }
+    } catch (error) {
+      setErrorMessage(error instanceof Error ? error.message : String(error));
+    }
+  };
+
+  const handleLogSteps = async () => {
+    setErrorMessage(null);
+    try {
+      await ExpoHealth.saveSteps(500);
+      await loadDailyTotals();
+    } catch (error) {
+      setErrorMessage(error instanceof Error ? error.message : String(error));
+    }
+  };
+
+  const statusText = errorMessage ?? STATUS_LABEL[authStatus];
+  const canLog = authStatus === 'authorized';
+
   return (
     <View style={styles.container}>
       <ScreenHeader title="Health" onBack={onBack} />
       <View style={styles.content}>
-        <Text style={styles.status}>Health access: not requested</Text>
+        <Text style={styles.status}>{statusText}</Text>
         <View style={styles.buttonGroup}>
-          <Pressable style={styles.button}>
+          <Pressable style={styles.button} onPress={handleRequestAccess}>
             <Text style={styles.buttonText}>Request Access</Text>
           </Pressable>
-          <Pressable style={[styles.button, styles.buttonDisabled]} disabled>
-            <Text style={[styles.buttonText, styles.buttonTextDisabled]}>Log 500 Steps</Text>
+          <Pressable
+            style={[styles.button, !canLog && styles.buttonDisabled]}
+            disabled={!canLog}
+            onPress={handleLogSteps}>
+            <Text style={[styles.buttonText, !canLog && styles.buttonTextDisabled]}>
+              Log 500 Steps
+            </Text>
           </Pressable>
         </View>
         <Text style={styles.sectionHeader}>Last 7 Days</Text>
-        <Text style={styles.emptyState}>No data yet</Text>
+        {authStatus === 'denied' && <Text style={styles.emptyState}>Health access needed</Text>}
+        {authStatus !== 'denied' && !dailyTotals && (
+          <Text style={styles.emptyState}>No data yet</Text>
+        )}
+        {authStatus !== 'denied' &&
+          dailyTotals?.map((row, index) => {
+            const isToday = index === 0;
+            return (
+              <Text key={row.timestamp} style={[styles.row, isToday && styles.rowToday]}>
+                {formatDayLabel(row.timestamp)} — {formatSteps(row.steps)} steps
+                {isToday ? ' (today)' : ''}
+              </Text>
+            );
+          })}
       </View>
     </View>
   );
@@ -72,4 +165,13 @@ const styles = StyleSheet.create({
     fontSize: 15,
     color: '#8E8E93',
   },
+  row: {
+    fontSize: 15,
+    color: '#333',
