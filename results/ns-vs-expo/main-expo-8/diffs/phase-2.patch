diff --git a/modules/expo-health/ios/ExpoHealthModule.swift b/modules/expo-health/ios/ExpoHealthModule.swift
new file mode 100644
index 0000000..14ccb20
--- /dev/null
+++ b/modules/expo-health/ios/ExpoHealthModule.swift
@@ -0,0 +1,105 @@
+import ExpoModulesCore
+import HealthKit
+
+public class ExpoHealthModule: Module {
+  private let healthStore = HKHealthStore()
+  private let stepType = HKQuantityType.quantityType(forIdentifier: .stepCount)!
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoHealth")
+
+    AsyncFunction("getAuthorizationStatus") { () -> String in
+      self.authorizationStatusString()
+    }
+
+    AsyncFunction("requestAuthorization") { (promise: Promise) in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        promise.reject("ERR_HEALTH_UNAVAILABLE", "Health data is not available on this device")
+        return
+      }
+
+      let typesToShare: Set<HKSampleType> = [self.stepType]
+      let typesToRead: Set<HKObjectType> = [self.stepType]
+
+      self.healthStore.requestAuthorization(toShare: typesToShare, read: typesToRead) { _, error in
+        if let error {
+          promise.reject("ERR_HEALTH_AUTH", error.localizedDescription)
+          return
+        }
+        promise.resolve(self.authorizationStatusString())
+      }
+    }
+
+    AsyncFunction("saveSteps") { (count: Double, promise: Promise) in
+      let now = Date()
+      let quantity = HKQuantity(unit: .count(), doubleValue: count)
+      let sample = HKQuantitySample(type: self.stepType, quantity: quantity, start: now, end: now)
+
+      self.healthStore.save(sample) { success, error in
+        if let error {
+          promise.reject("ERR_HEALTH_SAVE", error.localizedDescription)
+          return
+        }
+        if !success {
+          promise.reject("ERR_HEALTH_SAVE", "Failed to save step sample")
+          return
+        }
+        promise.resolve(nil)
+      }
+    }
+
+    AsyncFunction("getDailyStepTotals") { (days: Int, promise: Promise) in
+      let calendar = Calendar.current
+      let now = Date()
+      let startOfToday = calendar.startOfDay(for: now)
+
+      guard let startDate = calendar.date(byAdding: .day, value: -(days - 1), to: startOfToday) else {
+        promise.reject("ERR_HEALTH_QUERY", "Failed to compute date range")
+        return
+      }
+
+      var intervalComponents = DateComponents()
+      intervalComponents.day = 1
+
+      let query = HKStatisticsCollectionQuery(
+        quantityType: self.stepType,
+        quantitySamplePredicate: nil,
+        options: .cumulativeSum,
+        anchorDate: startOfToday,
+        intervalComponents: intervalComponents
+      )
+
+      query.initialResultsHandler = { _, collection, error in
+        if let error {
+          promise.reject("ERR_HEALTH_QUERY", error.localizedDescription)
+          return
+        }
+
+        var results: [[String: Any]] = []
+        collection?.enumerateStatistics(from: startDate, to: now) { statistics, _ in
+          let steps = statistics.sumQuantity()?.doubleValue(for: .count()) ?? 0
+          results.append([
+            "timestamp": statistics.startDate.timeIntervalSince1970 * 1000,
+            "steps": steps,
+          ])
+        }
+        promise.resolve(results.reversed())
+      }
+
+      self.healthStore.execute(query)
+    }
+  }
+
+  private func authorizationStatusString() -> String {
+    switch healthStore.authorizationStatus(for: stepType) {
+    case .notDetermined:
+      return "notDetermined"
+    case .sharingDenied:
+      return "denied"
+    case .sharingAuthorized:
+      return "authorized"
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+}
