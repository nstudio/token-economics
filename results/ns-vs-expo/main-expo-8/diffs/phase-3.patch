@@ -0,0 +1,34 @@
+Pod::Spec.new do |s|
+  s.name           = 'ExpoSpeech'
+  s.version        = '1.0.0'
+  s.summary        = 'Speech recognition access for Native Bench'
+  s.description    = 'Speech recognition access for Native Bench'
+  s.author         = ''
+  s.homepage       = 'https://docs.expo.dev/modules/'
+  s.platforms      = {
+    :ios => '16.4',
+    :tvos => '16.4'
+  }
+  s.source         = { git: '' }
+  s.static_framework = true
+
+  s.dependency 'ExpoModulesCore'
+  s.frameworks = 'Speech'
+
+  # Swift/Objective-C compatibility
+  s.pod_target_xcconfig = {
+    'DEFINES_MODULE' => 'YES',
+  }
+
+  s.source_files = "**/*.{h,m,mm,swift,hpp,cpp}"
+
+  # CocoaPods resource globs can't reach outside the pod root, so pull the
+  # bundled sample in from spec-assets/ at `pod install` time.
+  s.prepare_command = <<-CMD
+    mkdir -p assets
+    cp ../../../spec-assets/sample.wav assets/sample.wav
+  CMD
+  s.resource_bundles = {
+    'ExpoSpeech' => ['assets/sample.wav']
+  }
+end
diff --git a/modules/expo-speech/ios/ExpoSpeechModule.swift b/modules/expo-speech/ios/ExpoSpeechModule.swift
new file mode 100644
index 0000000..df460eb
--- /dev/null
+++ b/modules/expo-speech/ios/ExpoSpeechModule.swift
@@ -0,0 +1,90 @@
+import ExpoModulesCore
+import Speech
+
+// `Promise.reject(code:description:)` builds a plain `Exception`, whose JS-facing
+// message is always "undefined reason" — its `reason` is never wired to the passed
+// description. Reject with an `Error` instead, which surfaces `localizedDescription`.
+private struct SpeechError: LocalizedError {
+  let code: String
+  let message: String
+  var errorDescription: String? { message }
+}
+
+public class ExpoSpeechModule: Module {
+  private let recognizer = SFSpeechRecognizer(locale: Locale(identifier: "en-US"))
+  private var recognitionTask: SFSpeechRecognitionTask?
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoSpeech")
+
+    Events("onPartialTranscript")
+
+    AsyncFunction("getAuthorizationStatus") { () -> String in
+      self.authorizationStatusString(SFSpeechRecognizer.authorizationStatus())
+    }
+
+    AsyncFunction("requestAuthorization") { (promise: Promise) in
+      SFSpeechRecognizer.requestAuthorization { status in
+        promise.resolve(self.authorizationStatusString(status))
+      }
+    }
+
+    AsyncFunction("transcribeSample") { (promise: Promise) in
+      guard let audioURL = self.sampleAudioURL() else {
+        promise.reject(SpeechError(code: "ERR_SPEECH_ASSET", message: "Could not locate bundled sample audio"))
+        return
+      }
+
+      guard let recognizer = self.recognizer, recognizer.isAvailable else {
+        promise.reject(SpeechError(code: "ERR_SPEECH_UNAVAILABLE", message: "Speech recognizer is not available"))
+        return
+      }
+
+      let request = SFSpeechURLRecognitionRequest(url: audioURL)
+      request.shouldReportPartialResults = true
+      request.taskHint = .dictation
+      // The Simulator has no on-device Siri speech model installed, so on-device
+      // recognition fails outright there; force server-based recognition instead.
+      request.requiresOnDeviceRecognition = false
+
+      self.recognitionTask = recognizer.recognitionTask(with: request) { result, error in
+        if let error {
+          promise.reject(SpeechError(code: "ERR_SPEECH_RECOGNITION", message: error.localizedDescription))
+          self.recognitionTask = nil
+          return
+        }
+
+        guard let result else { return }
+
+        let text = result.bestTranscription.formattedString
+        if result.isFinal {
+          promise.resolve(text)
+          self.recognitionTask = nil
+        } else {
+          self.sendEvent("onPartialTranscript", ["text": text])
+        }
+      }
+    }
+  }
+
+  private func authorizationStatusString(_ status: SFSpeechRecognizerAuthorizationStatus) -> String {
+    switch status {
+    case .notDetermined:
+      return "notDetermined"
+    case .authorized:
+      return "authorized"
+    case .denied, .restricted:
+      return "denied"
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+
+  private func sampleAudioURL() -> URL? {
+    guard let bundleURL = Bundle(for: ExpoSpeechModule.self).url(forResource: "ExpoSpeech", withExtension: "bundle"),
+          let resourceBundle = Bundle(url: bundleURL) else {
+      return nil
+    }
+    return resourceBundle.url(forResource: "sample", withExtension: "wav")
+  }
+}
