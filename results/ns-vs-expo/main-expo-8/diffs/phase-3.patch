--- /dev/null
+++ b/modules/expo-speech/src/ExpoSpeechModule.ts
@@ -0,0 +1,13 @@
+import { NativeModule, requireNativeModule } from 'expo';
+
+import { PartialTranscriptEvent, SpeechAuthorizationStatus } from './ExpoSpeech.types';
+
+declare class ExpoSpeechModule extends NativeModule<{
+  onPartialTranscript(event: PartialTranscriptEvent): void;
+}> {
+  getAuthorizationStatus(): Promise<SpeechAuthorizationStatus>;
+  requestAuthorization(): Promise<SpeechAuthorizationStatus>;
+  transcribeSample(): Promise<string>;
+}
+
+export default requireNativeModule<ExpoSpeechModule>('ExpoSpeech');
