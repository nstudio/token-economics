+++ b/modules/expo-speech-benchmark/ios/ExpoSpeechBenchmarkModule.swift
@@ -0,0 +1,112 @@
+import ExpoModulesCore
+import Speech
+
+enum ExpoSpeechBenchmarkError: Error, LocalizedError {
+  case notAuthorized
+  case recognizerUnavailable
+  case sampleNotFound
+
+  var errorDescription: String? {
+    switch self {
+    case .notAuthorized:
+      return "Speech recognition access has not been granted."
+    case .recognizerUnavailable:
+      return "Speech recognizer is not available."
+    case .sampleNotFound:
+      return "Bundled sample audio file could not be found."
+    }
+  }
+}
+
+private let partialTranscriptEvent = "onPartialTranscript"
+
+public class ExpoSpeechBenchmarkModule: Module {
+  private var recognitionTask: SFSpeechRecognitionTask?
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoSpeechBenchmark")
+
+    Events(partialTranscriptEvent)
+
+    Function("getAuthorizationStatus") { () -> String in
+      self.authorizationStatusString(SFSpeechRecognizer.authorizationStatus())
+    }
+
+    AsyncFunction("requestAuthorization") { () async -> String in
+      await withCheckedContinuation { continuation in
+        SFSpeechRecognizer.requestAuthorization { status in
+          continuation.resume(returning: self.authorizationStatusString(status))
+        }
+      }
+    }
+
+    AsyncFunction("transcribe") { () async throws -> String in
+      try await self.transcribeSample()
+    }
+  }
+
+  private func authorizationStatusString(_ status: SFSpeechRecognizerAuthorizationStatus) -> String {
+    switch status {
+    case .authorized:
+      return "authorized"
+    case .denied, .restricted:
+      return "denied"
+    case .notDetermined:
+      fallthrough
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+
+  private func sampleFileURL() throws -> URL {
+    let moduleBundle = Bundle(for: ExpoSpeechBenchmarkModule.self)
+    guard
+      let resourceBundleURL = moduleBundle.url(forResource: "ExpoSpeechBenchmarkResources", withExtension: "bundle"),
+      let resourceBundle = Bundle(url: resourceBundleURL),
+      let sampleURL = resourceBundle.url(forResource: "sample", withExtension: "wav")
+    else {
+      throw ExpoSpeechBenchmarkError.sampleNotFound
+    }
+    return sampleURL
+  }
+
+  private func transcribeSample() async throws -> String {
+    guard SFSpeechRecognizer.authorizationStatus() == .authorized else {
+      throw ExpoSpeechBenchmarkError.notAuthorized
+    }
+
+    let sampleURL = try sampleFileURL()
+
+    guard let recognizer = SFSpeechRecognizer(locale: Locale(identifier: "en-US")), recognizer.isAvailable else {
+      throw ExpoSpeechBenchmarkError.recognizerUnavailable
+    }
+
+    let request = SFSpeechURLRecognitionRequest(url: sampleURL)
+    request.shouldReportPartialResults = true
+    request.requiresOnDeviceRecognition = recognizer.supportsOnDeviceRecognition
+
+    return try await withCheckedThrowingContinuation { continuation in
+      var didFinish = false
+      self.recognitionTask = recognizer.recognitionTask(with: request) { result, error in
+        if let error = error {
+          if !didFinish {
+            didFinish = true
+            continuation.resume(throwing: error)
+          }
+          return
+        }
+        guard let result = result else { return }
+        if result.isFinal {
+          if !didFinish {
+            didFinish = true
+            continuation.resume(returning: result.bestTranscription.formattedString)
+          }
+        } else {
+          self.sendEvent(partialTranscriptEvent, [
+            "text": result.bestTranscription.formattedString,
+          ])
+        }
+      }
+    }
+  }
+}
