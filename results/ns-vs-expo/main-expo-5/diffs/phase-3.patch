+import { NativeModule, requireNativeModule } from 'expo';
+
+import type { PartialTranscriptEvent, SpeechAuthorizationStatus } from './ExpoSpeechBenchmark.types';
+
+type ExpoSpeechBenchmarkModuleEvents = {
+  onPartialTranscript(event: PartialTranscriptEvent): void;
+};
+
+declare class ExpoSpeechBenchmarkModule extends NativeModule<ExpoSpeechBenchmarkModuleEvents> {
+  getAuthorizationStatus(): SpeechAuthorizationStatus;
+  requestAuthorization(): Promise<SpeechAuthorizationStatus>;
+  transcribe(): Promise<string>;
+}
+
+export default requireNativeModule<ExpoSpeechBenchmarkModule>('ExpoSpeechBenchmark');
