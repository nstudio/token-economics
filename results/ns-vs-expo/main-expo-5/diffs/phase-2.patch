+++ b/modules/expo-health-benchmark/src/ExpoHealthBenchmarkModule.ts
@@ -0,0 +1,12 @@
+import { NativeModule, requireNativeModule } from 'expo';
+
+import type { DailyStepTotal, HealthAuthorizationStatus } from './ExpoHealthBenchmark.types';
+
+declare class ExpoHealthBenchmarkModule extends NativeModule<{}> {
+  getAuthorizationStatus(): HealthAuthorizationStatus;
+  requestAuthorization(): Promise<HealthAuthorizationStatus>;
+  logSteps(count: number): Promise<void>;
+  getDailyStepTotals(days: number): Promise<DailyStepTotal[]>;
+}
+
+export default requireNativeModule<ExpoHealthBenchmarkModule>('ExpoHealthBenchmark');
