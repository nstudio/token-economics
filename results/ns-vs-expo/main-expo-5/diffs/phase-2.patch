diff --git a/modules/expo-health-benchmark/ios/ExpoHealthBenchmarkModule.swift b/modules/expo-health-benchmark/ios/ExpoHealthBenchmarkModule.swift
new file mode 100644
index 0000000..996fb05
--- /dev/null
+++ b/modules/expo-health-benchmark/ios/ExpoHealthBenchmarkModule.swift
@@ -0,0 +1,101 @@
+import ExpoModulesCore
+import HealthKit
+
+enum ExpoHealthBenchmarkError: Error, LocalizedError {
+  case unavailable
+
+  var errorDescription: String? {
+    switch self {
+    case .unavailable:
+      return "Health data is not available on this device."
+    }
+  }
+}
+
+public class ExpoHealthBenchmarkModule: Module {
+  private let healthStore = HKHealthStore()
+  private let stepType = HKQuantityType(.stepCount)
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoHealthBenchmark")
+
+    Function("getAuthorizationStatus") { () -> String in
+      self.authorizationStatusString(self.healthStore.authorizationStatus(for: self.stepType))
+    }
+
+    AsyncFunction("requestAuthorization") { () async throws -> String in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        throw ExpoHealthBenchmarkError.unavailable
+      }
+      try await self.healthStore.requestAuthorization(toShare: [self.stepType], read: [self.stepType])
+      return self.authorizationStatusString(self.healthStore.authorizationStatus(for: self.stepType))
+    }
+
+    AsyncFunction("logSteps") { (count: Double) async throws in
+      let now = Date()
+      let quantity = HKQuantity(unit: .count(), doubleValue: count)
+      let sample = HKQuantitySample(type: self.stepType, quantity: quantity, start: now, end: now)
+      try await self.healthStore.save(sample)
+    }
+
+    AsyncFunction("getDailyStepTotals") { (days: Int) async throws -> [[String: Double]] in
+      try await self.dailyStepTotals(days: days)
+    }
+  }
+
+  private func authorizationStatusString(_ status: HKAuthorizationStatus) -> String {
+    switch status {
+    case .sharingAuthorized:
+      return "authorized"
+    case .sharingDenied:
+      return "denied"
+    case .notDetermined:
+      fallthrough
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+
+  private func dailyStepTotals(days: Int) async throws -> [[String: Double]] {
+    let calendar = Calendar.current
+    let now = Date()
+    let startOfToday = calendar.startOfDay(for: now)
+    guard let startDate = calendar.date(byAdding: .day, value: -(days - 1), to: startOfToday) else {
+      return []
+    }
+
+    var intervalComponents = DateComponents()
+    intervalComponents.day = 1
+
+    let query = HKStatisticsCollectionQuery(
+      quantityType: stepType,
+      quantitySamplePredicate: nil,
+      options: .cumulativeSum,
+      anchorDate: startOfToday,
+      intervalComponents: intervalComponents
+    )
+
+    return try await withCheckedThrowingContinuation { continuation in
+      query.initialResultsHandler = { _, results, error in
+        if let error = error {
+          continuation.resume(throwing: error)
+          return
+        }
+        guard let results = results else {
+          continuation.resume(returning: [])
+          return
+        }
+        var totals: [[String: Double]] = []
+        results.enumerateStatistics(from: startDate, to: now) { statistics, _ in
+          let sum = statistics.sumQuantity()?.doubleValue(for: .count()) ?? 0
+          totals.append([
+            "startMs": statistics.startDate.timeIntervalSince1970 * 1000,
+            "steps": sum,
+          ])
+        }
+        continuation.resume(returning: totals)
+      }
+      self.healthStore.execute(query)
+    }
+  }
+}
