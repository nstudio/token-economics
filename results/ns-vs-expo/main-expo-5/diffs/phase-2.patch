+import { useCallback, useState } from 'react';
 import { StyleSheet, Text, View } from 'react-native';
+import { useFocusEffect } from '@react-navigation/native';
 
 import { Button } from '../components/Button';
+import ExpoHealthBenchmark from '../modules/expo-health-benchmark/src/ExpoHealthBenchmarkModule';
+import type {
+  DailyStepTotal,
+  HealthAuthorizationStatus,
+} from '../modules/expo-health-benchmark/src/ExpoHealthBenchmark.types';
+
+const DAYS = 7;
+const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
+const MONTHS = [
+  'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec',
+];
+
+const STATUS_LABEL: Record<HealthAuthorizationStatus, string> = {
+  notDetermined: 'Health access: not requested',
+  authorized: 'Health access: granted',
+  denied: 'Health access: denied',
+};
+
+function isSameLocalDay(a: Date, b: Date): boolean {
+  return (
+    a.getFullYear() === b.getFullYear() &&
+    a.getMonth() === b.getMonth() &&
+    a.getDate() === b.getDate()
+  );
+}
+
+function formatDayLabel(date: Date): string {
+  return `${WEEKDAYS[date.getDay()]} ${MONTHS[date.getMonth()]} ${date.getDate()}`;
+}
+
+function errorMessage(err: unknown): string {
+  return err instanceof Error ? err.message : String(err);
+}
 
 export default function HealthScreen() {
+  const [status, setStatus] = useState<HealthAuthorizationStatus>('notDetermined');
+  const [errorText, setErrorText] = useState<string | null>(null);
+  const [totals, setTotals] = useState<DailyStepTotal[]>([]);
+  const [saving, setSaving] = useState(false);
+
+  const loadTotals = useCallback(async () => {
+    try {
+      const results = await ExpoHealthBenchmark.getDailyStepTotals(DAYS);
+      setTotals(results);
+    } catch (err) {
+      setErrorText(errorMessage(err));
+    }
+  }, []);
+
+  useFocusEffect(
+    useCallback(() => {
+      setErrorText(null);
+      let current: HealthAuthorizationStatus = 'notDetermined';
+      try {
+        current = ExpoHealthBenchmark.getAuthorizationStatus();
+        setStatus(current);
+      } catch (err) {
+        setErrorText(errorMessage(err));
+        return;
+      }
+      if (current === 'authorized') {
+        loadTotals();
+      }
+    }, [loadTotals])
+  );
+
+  const handleRequestAccess = useCallback(async () => {
+    setErrorText(null);
+    try {
+      const result = await ExpoHealthBenchmark.requestAuthorization();
+      setStatus(result);
+      if (result === 'authorized') {
+        await loadTotals();
+      }
+    } catch (err) {
+      setErrorText(errorMessage(err));
+    }
+  }, [loadTotals]);
+
+  const handleLogSteps = useCallback(async () => {
+    setErrorText(null);
+    setSaving(true);
+    try {
+      await ExpoHealthBenchmark.logSteps(500);
+      await loadTotals();
+    } catch (err) {
+      setErrorText(errorMessage(err));
+    } finally {
+      setSaving(false);
+    }
+  }, [loadTotals]);
+
+  const statusLine = errorText ?? STATUS_LABEL[status];
+  const today = new Date();
+  const sortedTotals = [...totals].sort((a, b) => b.startMs - a.startMs);
+
   return (
     <View style={styles.container}>
-      <Text style={styles.status}>Health access: not requested</Text>
+      <Text style={styles.status}>{statusLine}</Text>
       <View style={styles.buttons}>
-        <Button label="Request Access" onPress={() => {}} />
-        <Button label="Log 500 Steps" onPress={() => {}} disabled />
+        <Button label="Request Access" onPress={handleRequestAccess} />
+        <Button
+          label="Log 500 Steps"
+          onPress={handleLogSteps}
+          disabled={status !== 'authorized' || saving}
+        />
       </View>
       <Text style={styles.sectionHeader}>Last 7 Days</Text>
-      <Text style={styles.emptyState}>No data yet</Text>
+      {status === 'denied' ? (
+        <Text style={styles.emptyState}>Health access needed</Text>
+      ) : status === 'authorized' && sortedTotals.length > 0 ? (
+        sortedTotals.map((total) => {
+          const date = new Date(total.startMs);
+          const isToday = isSameLocalDay(date, today);
+          const label = `${formatDayLabel(date)} — ${total.steps.toLocaleString('en-US')} steps${
+            isToday ? ' (today)' : ''
+          }`;
+          return (
+            <Text
+              key={total.startMs}
+              style={[styles.row, isToday && styles.rowToday]}
+            >
+              {label}
+            </Text>
+          );
+        })
+      ) : (
+        <Text style={styles.emptyState}>No data yet</Text>
+      )}
     </View>
   );
 }
