+import ExpoModulesCore
+import Speech
+
+enum SpeechAccessError: Error, LocalizedError {
+  case recognizerUnavailable
+  case fileMissing
+
+  var errorDescription: String? {
+    switch self {
+    case .recognizerUnavailable:
+      return "Speech recognizer is unavailable on this device"
+    case .fileMissing:
+      return "Sample audio file not found in the app bundle"
+    }
+  }
+}
+
+public class ExpoSpeechModule: Module {
+  private let recognizer = SFSpeechRecognizer(locale: Locale(identifier: "en-US"))
+  private var activeTask: SFSpeechRecognitionTask?
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoSpeech")
+
+    Events("onPartialTranscript")
+
+    AsyncFunction("getAuthorizationStatusAsync") { () -> String in
+      self.authorizationStatusString(SFSpeechRecognizer.authorizationStatus())
+    }
+
+    AsyncFunction("requestAuthorizationAsync") { (promise: Promise) in
+      SFSpeechRecognizer.requestAuthorization { status in
+        promise.resolve(self.authorizationStatusString(status))
+      }
+    }
+
+    AsyncFunction("transcribeSampleAsync") { (promise: Promise) in
+      guard let recognizer = self.recognizer, recognizer.isAvailable else {
+        promise.reject(SpeechAccessError.recognizerUnavailable)
+        return
+      }
+
+      guard let fileUrl = self.bundledSampleURL() else {
+        promise.reject(SpeechAccessError.fileMissing)
+        return
+      }
+
+      let request = SFSpeechURLRecognitionRequest(url: fileUrl)
+      request.shouldReportPartialResults = true
+
+      self.activeTask = recognizer.recognitionTask(with: request) { result, error in
+        if let error = error {
+          promise.reject(error)
+          self.activeTask = nil
+          return
+        }
+
+        guard let result = result else { return }
+
+        self.sendEvent("onPartialTranscript", ["text": result.bestTranscription.formattedString])
+
+        if result.isFinal {
+          promise.resolve(result.bestTranscription.formattedString)
+          self.activeTask = nil
+        }
+      }
+    }
+  }
+
+  private func bundledSampleURL() -> URL? {
+    let bundles: [Bundle] = [
+      Bundle.main.url(forResource: "ExpoSpeech", withExtension: "bundle").flatMap(Bundle.init(url:)),
+      Bundle(for: ExpoSpeechModule.self),
+    ].compactMap { $0 }
+
+    for bundle in bundles {
+      if let url = bundle.url(forResource: "sample", withExtension: "wav") {
+        return url
+      }
+    }
+    return nil
+  }
+
+  private func authorizationStatusString(_ status: SFSpeechRecognizerAuthorizationStatus) -> String {
+    switch status {
+    case .notDetermined:
+      return "notDetermined"
+    case .denied, .restricted:
+      return "denied"
+    case .authorized:
+      return "authorized"
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+}
