index 0000000..ed75fc4
--- /dev/null
+++ b/modules/expo-health/src/ExpoHealthAccessModule.ts
@@ -0,0 +1,12 @@
+import { NativeModule, requireNativeModule } from 'expo';
+
+import { DailySteps, HealthAuthorizationStatus } from './ExpoHealthAccess.types';
+
+declare class ExpoHealthAccessModule extends NativeModule<{}> {
+  getAuthorizationStatusAsync(): Promise<HealthAuthorizationStatus>;
+  requestAuthorizationAsync(): Promise<HealthAuthorizationStatus>;
+  logStepsAsync(steps: number): Promise<void>;
+  getLast7DaysStepsAsync(): Promise<DailySteps[]>;
+}
+
+export default requireNativeModule<ExpoHealthAccessModule>('ExpoHealthAccess');
