+      if (status === 'authorized') {
+        await loadLast7Days();
+      }
+    } catch (error) {
+      setErrorMessage(messageFor(error));
+    } finally {
+      setRequesting(false);
+    }
+  };
+
+  const handleLogSteps = async () => {
+    setLogging(true);
