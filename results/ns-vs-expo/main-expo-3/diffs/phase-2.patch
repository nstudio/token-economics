new file mode 100644
index 0000000..2745d62
--- /dev/null
+++ b/modules/expo-health/ios/ExpoHealthAccessModule.swift
@@ -0,0 +1,134 @@
+import ExpoModulesCore
+import HealthKit
+
+struct DailySteps: Record {
+  @Field
+  var daysAgo: Int = 0
+
+  @Field
+  var steps: Double = 0
+}
+
+enum HealthAccessError: Error, LocalizedError {
+  case unavailable
+  case dateRange
+
+  var errorDescription: String? {
+    switch self {
+    case .unavailable:
+      return "Health data is not available on this device"
+    case .dateRange:
+      return "Failed to compute date range"
+    }
+  }
+}
+
+public class ExpoHealthAccessModule: Module {
+  private let healthStore = HKHealthStore()
+  private let stepType = HKQuantityType.quantityType(forIdentifier: .stepCount)!
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoHealthAccess")
+
+    AsyncFunction("getAuthorizationStatusAsync") { () -> String in
+      self.authorizationStatusString()
+    }
+
+    AsyncFunction("requestAuthorizationAsync") { (promise: Promise) in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        promise.reject(HealthAccessError.unavailable)
+        return
+      }
+
+      self.healthStore.requestAuthorization(toShare: [self.stepType], read: [self.stepType]) { _, error in
+        if let error = error {
+          promise.reject(error)
+        } else {
+          promise.resolve(self.authorizationStatusString())
+        }
+      }
+    }
+
+    AsyncFunction("logStepsAsync") { (steps: Double, promise: Promise) in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        promise.reject(HealthAccessError.unavailable)
+        return
+      }
+
+      let now = Date()
+      let quantity = HKQuantity(unit: .count(), doubleValue: steps)
+      let sample = HKQuantitySample(type: self.stepType, quantity: quantity, start: now, end: now)
+
+      self.healthStore.save(sample) { success, error in
+        if let error = error {
+          promise.reject(error)
+        } else if !success {
+          promise.reject("ERR_HEALTH_SAVE", "Failed to save step sample")
+        } else {
+          promise.resolve(nil)
+        }
+      }
+    }
+
+    AsyncFunction("getLast7DaysStepsAsync") { (promise: Promise) in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        promise.reject(HealthAccessError.unavailable)
+        return
+      }
+
+      let calendar = Calendar.current
+      let now = Date()
+
+      guard
+        let startOfToday = calendar.date(from: calendar.dateComponents([.year, .month, .day], from: now)),
+        let startDate = calendar.date(byAdding: .day, value: -6, to: startOfToday),
+        let endDate = calendar.date(byAdding: .day, value: 1, to: startOfToday)
+      else {
+        promise.reject(HealthAccessError.dateRange)
+        return
+      }
+
+      let predicate = HKQuery.predicateForSamples(withStart: startDate, end: endDate, options: .strictStartDate)
+      let query = HKStatisticsCollectionQuery(
+        quantityType: self.stepType,
+        quantitySamplePredicate: predicate,
+        options: .cumulativeSum,
+        anchorDate: startDate,
+        intervalComponents: DateComponents(day: 1)
+      )
+
+      query.initialResultsHandler = { _, results, error in
+        if let error = error {
+          promise.reject(error)
+          return
+        }
+
+        var days: [DailySteps] = []
+        results?.enumerateStatistics(from: startDate, to: endDate) { statistics, _ in
+          let steps = statistics.sumQuantity()?.doubleValue(for: .count()) ?? 0
+          let daysAgo = calendar.dateComponents([.day], from: statistics.startDate, to: startOfToday).day ?? 0
+          var entry = DailySteps()
+          entry.daysAgo = daysAgo
+          entry.steps = steps
+          days.append(entry)
+        }
+        promise.resolve(days)
+      }
+
+      self.healthStore.execute(query)
+    }
+  }
+
+  private func authorizationStatusString() -> String {
+    switch healthStore.authorizationStatus(for: stepType) {
+    case .notDetermined:
+      return "notDetermined"
+    case .sharingDenied:
+      return "denied"
+    case .sharingAuthorized:
+      return "authorized"
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+}
