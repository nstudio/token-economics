+import { useCallback, useState } from 'react';
 import { Pressable, StyleSheet, Text, View } from 'react-native';
+import { useFocusEffect } from '@react-navigation/native';
+
+import ExpoHealthKit from '../modules/expo-health-kit';
+import type {
+  DailyStepTotal,
+  HealthAuthorizationStatus,
+} from '../modules/expo-health-kit';
+
+const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
+const MONTHS = [
+  'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
+  'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec',
+];
+
+function formatDayLabel(dayStart: string): string {
+  const [year, month, day] = dayStart.split('-').map(Number);
+  const date = new Date(year, month - 1, day);
+  return `${WEEKDAYS[date.getDay()]} ${MONTHS[date.getMonth()]} ${date.getDate()}`;
+}
+
+function statusLabel(status: HealthAuthorizationStatus): string {
+  switch (status) {
+    case 'authorized':
+      return 'Health access: granted';
+    case 'denied':
+      return 'Health access: denied';
+    default:
+      return 'Health access: not requested';
+  }
+}
+
+function errorMessage(e: unknown): string {
+  return e instanceof Error ? e.message : String(e);
+}
 
 export default function HealthScreen() {
+  const [authStatus, setAuthStatus] = useState<HealthAuthorizationStatus>('notDetermined');
+  const [error, setError] = useState<string | null>(null);
+  const [days, setDays] = useState<DailyStepTotal[] | null>(null);
+
+  const loadDays = useCallback(async () => {
+    try {
+      const totals = await ExpoHealthKit.getDailyStepTotalsAsync(7);
+      setDays(totals);
+    } catch (e) {
+      setError(errorMessage(e));
+    }
+  }, []);
+
+  useFocusEffect(
