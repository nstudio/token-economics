+      const status = ExpoHealthKit.getAuthorizationStatus();
+      setAuthStatus(status);
+      setError(null);
+      if (status === 'authorized') {
+        loadDays();
+      }
+    }, [loadDays])
+  );
+
+  const handleRequestAccess = async () => {
+    try {
+      const status = await ExpoHealthKit.requestAuthorizationAsync();
+      setAuthStatus(status);
+      setError(null);
+      if (status === 'authorized') {
+        await loadDays();
+      }
+    } catch (e) {
+      setError(errorMessage(e));
+    }
+  };
+
+  const handleLogSteps = async () => {
+    try {
+      await ExpoHealthKit.logStepsAsync(500);
+      setError(null);
+      await loadDays();
+    } catch (e) {
+      setError(errorMessage(e));
+    }
+  };
+
+  const orderedDays = days ? [...days].reverse() : [];
+
   return (
     <View style={styles.container}>
-      <Text style={styles.status}>Health access: not requested</Text>
+      <Text style={styles.status}>{error ?? statusLabel(authStatus)}</Text>
 
       <View style={styles.buttons}>
-        <Pressable style={styles.button}>
+        <Pressable style={styles.button} onPress={handleRequestAccess}>
           <Text style={styles.buttonText}>Request Access</Text>
         </Pressable>
-        <Pressable style={[styles.button, styles.buttonDisabled]} disabled>
-          <Text style={[styles.buttonText, styles.buttonTextDisabled]}>
+        <Pressable
+          style={[styles.button, authStatus !== 'authorized' && styles.buttonDisabled]}
+          disabled={authStatus !== 'authorized'}
+          onPress={handleLogSteps}
+        >
+          <Text
+            style={[
+              styles.buttonText,
+              authStatus !== 'authorized' && styles.buttonTextDisabled,
+            ]}
+          >
             Log 500 Steps
           </Text>
         </Pressable>
       </View>
 
       <Text style={styles.sectionHeader}>Last 7 Days</Text>
-      <View style={styles.emptyState}>
-        <Text style={styles.emptyStateText}>No data yet</Text>
-      </View>
+      {authStatus === 'denied' ? (
+        <View style={styles.emptyState}>
+          <Text style={styles.emptyStateText}>Health access needed</Text>
+        </View>
+      ) : authStatus === 'authorized' && orderedDays.length > 0 ? (
+        <View>
+          {orderedDays.map((d, index) => {
+            const isToday = index === 0;
+            const label = formatDayLabel(d.dayStart);
+            const stepsText = d.steps.toLocaleString('en-US');
+            return (
+              <Text
+                key={d.dayStart}
+                style={[styles.dayRow, isToday && styles.dayRowToday]}
+              >
+                {label} — {stepsText} steps{isToday ? ' (today)' : ''}
+              </Text>
+            );
+          })}
+        </View>
+      ) : (
+        <View style={styles.emptyState}>
+          <Text style={styles.emptyStateText}>No data yet</Text>
+        </View>
+      )}
     </View>
   );
 }
