--- /dev/null
+++ b/modules/expo-health-kit/src/ExpoHealthKitModule.ts
@@ -0,0 +1,12 @@
+import { NativeModule, requireNativeModule } from 'expo';
+
+import type { DailyStepTotal, HealthAuthorizationStatus } from './ExpoHealthKit.types';
+
+declare class ExpoHealthKitModule extends NativeModule<{}> {
+  getAuthorizationStatus(): HealthAuthorizationStatus;
+  requestAuthorizationAsync(): Promise<HealthAuthorizationStatus>;
+  logStepsAsync(steps: number): Promise<void>;
+  getDailyStepTotalsAsync(days: number): Promise<DailyStepTotal[]>;
+}
+
+export default requireNativeModule<ExpoHealthKitModule>('ExpoHealthKit');
