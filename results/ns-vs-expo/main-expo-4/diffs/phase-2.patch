diff --git a/modules/expo-health-kit/ios/ExpoHealthKitModule.swift b/modules/expo-health-kit/ios/ExpoHealthKitModule.swift
new file mode 100644
index 0000000..16a3abd
--- /dev/null
+++ b/modules/expo-health-kit/ios/ExpoHealthKitModule.swift
@@ -0,0 +1,106 @@
+import ExpoModulesCore
+import HealthKit
+
+enum ExpoHealthKitError: Error, LocalizedError {
+  case unavailable
+
+  var errorDescription: String? {
+    switch self {
+    case .unavailable:
+      return "Health data is not available on this device."
+    }
+  }
+}
+
+public class ExpoHealthKitModule: Module {
+  private let healthStore = HKHealthStore()
+  private let stepType = HKQuantityType.quantityType(forIdentifier: .stepCount)!
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoHealthKit")
+
+    Function("getAuthorizationStatus") { () -> String in
+      self.authorizationStatusString()
+    }
+
+    AsyncFunction("requestAuthorizationAsync") { () -> String in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        throw ExpoHealthKitError.unavailable
+      }
+      try await self.healthStore.requestAuthorization(toShare: [self.stepType], read: [self.stepType])
+      return self.authorizationStatusString()
+    }
+
+    AsyncFunction("logStepsAsync") { (steps: Double) in
+      let now = Date()
+      let quantity = HKQuantity(unit: .count(), doubleValue: steps)
+      let sample = HKQuantitySample(type: self.stepType, quantity: quantity, start: now, end: now)
+      try await self.healthStore.save(sample)
+    }
+
+    AsyncFunction("getDailyStepTotalsAsync") { (days: Int) -> [[String: Any]] in
+      try await self.dailyStepTotals(days: days)
+    }
+  }
+
+  private func authorizationStatusString() -> String {
+    switch healthStore.authorizationStatus(for: stepType) {
+    case .notDetermined:
+      return "notDetermined"
+    case .sharingDenied:
+      return "denied"
+    case .sharingAuthorized:
+      return "authorized"
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+
+  private func dailyStepTotals(days: Int) async throws -> [[String: Any]] {
+    let calendar = Calendar.current
+    let now = Date()
+    let startOfToday = calendar.startOfDay(for: now)
+    guard let startDay = calendar.date(byAdding: .day, value: -(days - 1), to: startOfToday) else {
+      return []
+    }
+
+    let dayFormatter = DateFormatter()
+    dayFormatter.dateFormat = "yyyy-MM-dd"
+    dayFormatter.timeZone = calendar.timeZone
+    dayFormatter.locale = Locale(identifier: "en_US_POSIX")
+
+    var intervalComponents = DateComponents()
+    intervalComponents.day = 1
+
+    let predicate = HKQuery.predicateForSamples(withStart: startDay, end: now, options: .strictStartDate)
+
+    return try await withCheckedThrowingContinuation { continuation in
+      let query = HKStatisticsCollectionQuery(
+        quantityType: stepType,
+        quantitySamplePredicate: predicate,
+        options: .cumulativeSum,
+        anchorDate: startOfToday,
+        intervalComponents: intervalComponents
+      )
+
+      query.initialResultsHandler = { _, collection, error in
+        if let error = error {
+          continuation.resume(throwing: error)
+          return
+        }
+
+        var results: [[String: Any]] = []
+        collection?.enumerateStatistics(from: startDay, to: now) { statistics, _ in
+          let steps = statistics.sumQuantity()?.doubleValue(for: .count()) ?? 0
+          results.append([
+            "dayStart": dayFormatter.string(from: statistics.startDate),
+            "steps": steps,
+          ])
+        }
+        continuation.resume(returning: results)
+      }
+
+      healthStore.execute(query)
+    }
+  }
+}
