@@ -0,0 +1,18 @@
+import { NativeModule, requireNativeModule } from 'expo';
+
+import type {
+  PartialTranscriptEvent,
+  SpeechAuthorizationStatus,
+} from './ExpoSpeechRecognizer.types';
+
+export type ExpoSpeechRecognizerEvents = {
+  onPartialTranscript: (event: PartialTranscriptEvent) => void;
+};
+
+declare class ExpoSpeechRecognizerModule extends NativeModule<ExpoSpeechRecognizerEvents> {
+  getAuthorizationStatus(): SpeechAuthorizationStatus;
+  requestAuthorizationAsync(): Promise<SpeechAuthorizationStatus>;
+  transcribeSampleAsync(): Promise<string>;
+}
+
+export default requireNativeModule<ExpoSpeechRecognizerModule>('ExpoSpeechRecognizer');
diff --git a/plugins/withSpeechSample.js b/plugins/withSpeechSample.js
new file mode 100644
index 0000000..a97ee23
--- /dev/null
+++ b/plugins/withSpeechSample.js
@@ -0,0 +1,31 @@
+const fs = require('fs');
+const path = require('path');
+const { withXcodeProject, IOSConfig } = require('@expo/config-plugins');
+
+const SOURCE_RELATIVE_PATH = path.join('spec-assets', 'sample.wav');
+const BUNDLE_FILE_NAME = 'sample.wav';
+
+module.exports = function withSpeechSample(config) {
+  return withXcodeProject(config, (config) => {
+    const projectRoot = config.modRequest.projectRoot;
+    const platformProjectRoot = config.modRequest.platformProjectRoot;
+    const projectName = IOSConfig.XcodeUtils.getProjectName(projectRoot);
+
+    const sourcePath = path.join(projectRoot, SOURCE_RELATIVE_PATH);
+    const destPath = path.join(platformProjectRoot, projectName, BUNDLE_FILE_NAME);
+
+    fs.mkdirSync(path.dirname(destPath), { recursive: true });
+    fs.copyFileSync(sourcePath, destPath);
+
+    if (!config.modResults.hasFile(destPath)) {
+      config.modResults = IOSConfig.XcodeUtils.addResourceFileToGroup({
+        filepath: path.join(projectName, BUNDLE_FILE_NAME),
+        groupName: projectName,
+        project: config.modResults,
+        isBuildFile: true,
+      });
+    }
+
+    return config;
+  });
+};
