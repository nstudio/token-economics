diff --git a/modules/expo-speech-recognizer/ios/ExpoSpeechRecognizerModule.swift b/modules/expo-speech-recognizer/ios/ExpoSpeechRecognizerModule.swift
new file mode 100644
index 0000000..eb830ed
--- /dev/null
+++ b/modules/expo-speech-recognizer/ios/ExpoSpeechRecognizerModule.swift
@@ -0,0 +1,98 @@
+import AVFoundation
+import ExpoModulesCore
+import Speech
+
+enum ExpoSpeechRecognizerError: Error, LocalizedError {
+  case fileNotFound
+  case recognizerUnavailable
+
+  var errorDescription: String? {
+    switch self {
+    case .fileNotFound:
+      return "Sample audio file not found in the app bundle."
+    case .recognizerUnavailable:
+      return "Speech recognizer is not available on this device."
+    }
+  }
+}
+
+public class ExpoSpeechRecognizerModule: Module {
+  private var recognizer: SFSpeechRecognizer?
+  private var recognitionTask: SFSpeechRecognitionTask?
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoSpeechRecognizer")
+
+    Events("onPartialTranscript")
+
+    Function("getAuthorizationStatus") { () -> String in
+      self.authorizationStatusString()
+    }
+
+    AsyncFunction("requestAuthorizationAsync") { () -> String in
+      await withCheckedContinuation { (continuation: CheckedContinuation<String, Never>) in
+        SFSpeechRecognizer.requestAuthorization { _ in
+          continuation.resume(returning: self.authorizationStatusString())
+        }
+      }
+    }
+
+    AsyncFunction("transcribeSampleAsync") { () -> String in
+      try await self.transcribeSample()
+    }
+  }
+
+  private func authorizationStatusString() -> String {
+    switch SFSpeechRecognizer.authorizationStatus() {
+    case .notDetermined:
+      return "notDetermined"
+    case .denied, .restricted:
+      return "denied"
+    case .authorized:
+      return "authorized"
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+
+  private func transcribeSample() async throws -> String {
+    guard let url = Bundle.main.url(forResource: "sample", withExtension: "wav") else {
+      throw ExpoSpeechRecognizerError.fileNotFound
+    }
+    guard let recognizer = SFSpeechRecognizer(locale: Locale(identifier: "en-US")), recognizer.isAvailable else {
+      throw ExpoSpeechRecognizerError.recognizerUnavailable
+    }
+    self.recognizer = recognizer
+
+    let audioSession = AVAudioSession.sharedInstance()
+    try audioSession.setCategory(.playAndRecord, mode: .measurement, options: .duckOthers)
+    try audioSession.setActive(true, options: .notifyOthersOnDeactivation)
+
+    let request = SFSpeechURLRecognitionRequest(url: url)
+    request.shouldReportPartialResults = true
+
+    return try await withCheckedThrowingContinuation { continuation in
+      var didFinish = false
+      self.recognitionTask = recognizer.recognitionTask(with: request) { result, error in
+        if didFinish {
+          return
+        }
+        if let error {
+          didFinish = true
+          continuation.resume(throwing: error)
+          return
+        }
+        guard let result else {
+          return
+        }
+        let text = result.bestTranscription.formattedString
+        if result.isFinal {
+          didFinish = true
+          continuation.resume(returning: text)
+        } else {
+          self.sendEvent("onPartialTranscript", ["transcript": text])
+        }
+      }
+    }
+  }
+}
