+import { useFocusEffect } from '@react-navigation/native';
+import { useCallback, useState } from 'react';
 import { StyleSheet, Text, View } from 'react-native';
 import { Button } from '../components/Button';
+import ExpoHealth, { type DailySteps } from '../modules/expo-health';
+
+const DAYS_TO_SHOW = 7;
+
+type DayRow = {
+  key: number;
+  label: string;
+  steps: number;
+  isToday: boolean;
+};
+
+function errorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
+function formatDayLabel(date: Date): string {
+  const weekday = date.toLocaleDateString('en-US', { weekday: 'short' });
+  const month = date.toLocaleDateString('en-US', { month: 'short' });
+  return `${weekday} ${month} ${date.getDate()}`;
+}
+
+function toDayRows(days: DailySteps[]): DayRow[] {
+  const todayKey = new Date().toDateString();
+  return days.map(({ dayStartMillis, steps }) => {
+    const date = new Date(dayStartMillis);
+    return {
+      key: dayStartMillis,
+      label: formatDayLabel(date),
+      steps,
+      isToday: date.toDateString() === todayKey,
+    };
+  });
+}
 
 export function HealthScreen() {
+  const [statusLine, setStatusLine] = useState('Health access: not requested');
+  const [authorized, setAuthorized] = useState(false);
+  const [rows, setRows] = useState<DayRow[] | null>(null);
+
+  const loadDailySteps = useCallback(async () => {
+    try {
+      const days = await ExpoHealth.getDailySteps(DAYS_TO_SHOW);
+      setRows(toDayRows(days));
+    } catch (error) {
+      setStatusLine(errorMessage(error));
+    }
+  }, []);
+
+  const refreshStatus = useCallback(async () => {
+    const status = ExpoHealth.getAuthorizationStatus();
+    setStatusLine(`Health access: ${status}`);
+    setAuthorized(status === 'granted');
+    if (status === 'granted') {
+      await loadDailySteps();
+    } else {
+      setRows(null);
+    }
+  }, [loadDailySteps]);
+
+  useFocusEffect(
+    useCallback(() => {
+      refreshStatus();
+    }, [refreshStatus])
+  );
+
+  const handleRequestAccess = async () => {
+    try {
+      const status = await ExpoHealth.requestAuthorization();
+      setStatusLine(`Health access: ${status}`);
+      setAuthorized(status === 'granted');
+      if (status === 'granted') {
+        await loadDailySteps();
+      }
+    } catch (error) {
+      setStatusLine(errorMessage(error));
+    }
+  };
+
+  const handleLogSteps = async () => {
+    try {
+      await ExpoHealth.logSteps(500);
+      await loadDailySteps();
+    } catch (error) {
+      setStatusLine(errorMessage(error));
+    }
+  };
+
   return (
     <View style={styles.container}>
-      <Text style={styles.status}>Health access: not requested</Text>
+      <Text style={styles.status}>{statusLine}</Text>
       <View style={styles.buttons}>
-        <Button label="Request Access" onPress={() => {}} />
-        <Button label="Log 500 Steps" onPress={() => {}} disabled />
+        <Button label="Request Access" onPress={handleRequestAccess} />
+        <Button label="Log 500 Steps" onPress={handleLogSteps} disabled={!authorized} />
       </View>
       <Text style={styles.sectionHeader}>Last 7 Days</Text>
-      <Text style={styles.emptyState}>No data yet</Text>
+      {authorized && rows ? (
+        rows.map((row) => (
+          <Text
+            key={row.key}
+            style={[styles.row, row.isToday && styles.rowToday]}
+          >
+            {row.label} — {row.steps.toLocaleString('en-US')} steps
+            {row.isToday ? ' (today)' : ''}
+          </Text>
+        ))
+      ) : (
+        <Text style={styles.emptyState}>
+          {authorized ? 'No data yet' : 'Health access needed'}
+        </Text>
+      )}
     </View>
   );
 }
