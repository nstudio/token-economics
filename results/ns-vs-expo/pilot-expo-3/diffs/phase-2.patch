diff --git a/modules/expo-health/ios/ExpoHealthModule.swift b/modules/expo-health/ios/ExpoHealthModule.swift
new file mode 100644
index 0000000..ba870d8
--- /dev/null
+++ b/modules/expo-health/ios/ExpoHealthModule.swift
@@ -0,0 +1,126 @@
+import ExpoModulesCore
+import HealthKit
+
+struct DailySteps: Record {
+  @Field
+  var dayStartMillis: Double = 0
+
+  @Field
+  var steps: Int = 0
+}
+
+enum HealthModuleError: Error, CustomStringConvertible {
+  case unavailable
+  case saveFailed(String)
+  case queryFailed(String)
+
+  var description: String {
+    switch self {
+    case .unavailable:
+      return "Health data is not available on this device"
+    case .saveFailed(let message):
+      return "Failed to save step data: \(message)"
+    case .queryFailed(let message):
+      return "Failed to load step data: \(message)"
+    }
+  }
+}
+
+public class ExpoHealthModule: Module {
+  let healthStore = HKHealthStore()
+  let stepType = HKQuantityType.quantityType(forIdentifier: .stepCount)!
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoHealth")
+
+    Function("getAuthorizationStatus") { () -> String in
+      self.authorizationStatusLabel()
+    }
+
+    AsyncFunction("requestAuthorization") { () -> String in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        throw HealthModuleError.unavailable
+      }
+      try await self.healthStore.requestAuthorization(toShare: [self.stepType], read: [self.stepType])
+      return self.authorizationStatusLabel()
+    }
+
+    AsyncFunction("logSteps") { (count: Int) in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        throw HealthModuleError.unavailable
+      }
+      let now = Date()
+      let quantity = HKQuantity(unit: .count(), doubleValue: Double(count))
+      let sample = HKQuantitySample(type: self.stepType, quantity: quantity, start: now, end: now)
+      do {
+        try await self.healthStore.save(sample)
+      } catch {
+        throw HealthModuleError.saveFailed(error.localizedDescription)
+      }
+    }
+
+    AsyncFunction("getDailySteps") { (days: Int) -> [DailySteps] in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        throw HealthModuleError.unavailable
+      }
+      return try await self.queryDailySteps(days: days)
+    }
+  }
+
+  private func authorizationStatusLabel() -> String {
+    switch healthStore.authorizationStatus(for: stepType) {
+    case .notDetermined:
+      return "not requested"
+    case .sharingDenied:
+      return "denied"
+    case .sharingAuthorized:
+      return "granted"
+    @unknown default:
+      return "not requested"
+    }
+  }
+
+  private func queryDailySteps(days: Int) async throws -> [DailySteps] {
+    let calendar = Calendar.current
+    let startOfToday = calendar.startOfDay(for: Date())
+    guard let earliestStart = calendar.date(byAdding: .day, value: -(days - 1), to: startOfToday),
+          let queryEnd = calendar.date(byAdding: .day, value: 1, to: startOfToday) else {
+      throw HealthModuleError.queryFailed("Could not compute date range")
+    }
+
+    let predicate = HKQuery.predicateForSamples(withStart: earliestStart, end: queryEnd, options: .strictStartDate)
+
+    let sumsByDayStart: [TimeInterval: Double] = try await withCheckedThrowingContinuation { continuation in
+      let query = HKStatisticsCollectionQuery(
+        quantityType: self.stepType,
+        quantitySamplePredicate: predicate,
+        options: .cumulativeSum,
+        anchorDate: startOfToday,
+        intervalComponents: DateComponents(day: 1)
+      )
+
+      query.initialResultsHandler = { _, collection, error in
+        if let error {
+          continuation.resume(throwing: HealthModuleError.queryFailed(error.localizedDescription))
+          return
+        }
+
+        var sums: [TimeInterval: Double] = [:]
+        collection?.enumerateStatistics(from: earliestStart, to: startOfToday) { statistics, _ in
+          sums[statistics.startDate.timeIntervalSince1970] = statistics.sumQuantity()?.doubleValue(for: .count()) ?? 0
+        }
+        continuation.resume(returning: sums)
+      }
+
+      self.healthStore.execute(query)
+    }
+
+    return (0..<days).map { offset -> DailySteps in
+      let dayStart = calendar.date(byAdding: .day, value: -offset, to: startOfToday)!
+      var entry = DailySteps()
+      entry.dayStartMillis = dayStart.timeIntervalSince1970 * 1000
+      entry.steps = Int(sumsByDayStart[dayStart.timeIntervalSince1970] ?? 0)
+      return entry
+    }
+  }
+}
