+import { NativeModule, requireNativeModule } from 'expo';
+
+import type { ExpoTranscribeModuleEvents, SpeechAuthorizationStatus } from './ExpoTranscribe.types';
+
+declare class ExpoTranscribeModule extends NativeModule<ExpoTranscribeModuleEvents> {
+  getAuthorizationStatus(): SpeechAuthorizationStatus;
+  requestAuthorization(): Promise<SpeechAuthorizationStatus>;
+  transcribeSample(): Promise<string>;
+}
+
+export default requireNativeModule<ExpoTranscribeModule>('ExpoTranscribe');
