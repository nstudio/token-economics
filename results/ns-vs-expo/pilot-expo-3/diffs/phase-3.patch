@@ -0,0 +1,103 @@
+import ExpoModulesCore
+import Speech
+
+enum TranscribeModuleError: Error, CustomStringConvertible {
+  case missingSample
+  case recognizerUnavailable
+  case recognitionFailed(String)
+
+  var description: String {
+    switch self {
+    case .missingSample:
+      return "Could not locate the bundled sample audio"
+    case .recognizerUnavailable:
+      return "Speech recognition is not available on this device"
+    case .recognitionFailed(let message):
+      return "Transcription failed: \(message)"
+    }
+  }
+}
+
+public class ExpoTranscribeModule: Module {
+  private var recognitionTask: SFSpeechRecognitionTask?
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoTranscribe")
+
+    Events("onPartialResult")
+
+    Function("getAuthorizationStatus") { () -> String in
+      self.authorizationStatusLabel()
+    }
+
+    AsyncFunction("requestAuthorization") { () -> String in
+      await withCheckedContinuation { (continuation: CheckedContinuation<Void, Never>) in
+        SFSpeechRecognizer.requestAuthorization { _ in
+          continuation.resume()
+        }
+      }
+      return self.authorizationStatusLabel()
+    }
+
+    AsyncFunction("transcribeSample") { () -> String in
+      try await self.transcribeSample()
+    }
+  }
+
+  private func authorizationStatusLabel() -> String {
+    switch SFSpeechRecognizer.authorizationStatus() {
+    case .notDetermined:
+      return "not requested"
+    case .authorized:
+      return "granted"
+    case .denied, .restricted:
+      return "denied"
+    @unknown default:
+      return "not requested"
+    }
+  }
+
+  private func transcribeSample() async throws -> String {
+    guard let recognizer = SFSpeechRecognizer(locale: Locale(identifier: "en-US")), recognizer.isAvailable else {
+      throw TranscribeModuleError.recognizerUnavailable
+    }
+    let sampleURL = try sampleAudioURL()
+
+    return try await withCheckedThrowingContinuation { continuation in
+      let request = SFSpeechURLRecognitionRequest(url: sampleURL)
+      request.shouldReportPartialResults = true
+
+      var didFinish = false
+      self.recognitionTask = recognizer.recognitionTask(with: request) { result, error in
+        if didFinish {
+          return
+        }
+        if let error {
+          didFinish = true
+          continuation.resume(throwing: TranscribeModuleError.recognitionFailed(error.localizedDescription))
+          return
+        }
+        guard let result else {
+          return
+        }
+        let text = result.bestTranscription.formattedString
+        if result.isFinal {
+          didFinish = true
+          continuation.resume(returning: text)
+        } else {
+          self.sendEvent("onPartialResult", ["text": text])
+        }
+      }
+    }
+  }
+
+  private func sampleAudioURL() throws -> URL {
+    let moduleBundle = Bundle(for: ExpoTranscribeModule.self)
+    guard let assetsBundleURL = moduleBundle.url(forResource: "ExpoTranscribeAssets", withExtension: "bundle"),
+          let assetsBundle = Bundle(url: assetsBundleURL),
+          let sampleURL = assetsBundle.url(forResource: "sample", withExtension: "wav") else {
+      throw TranscribeModuleError.missingSample
+    }
+    return sampleURL
+  }
+}
