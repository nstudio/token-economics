diff --git a/modules/expo-bench-speech/ios/ExpoBenchSpeechModule.swift b/modules/expo-bench-speech/ios/ExpoBenchSpeechModule.swift
new file mode 100644
index 0000000..b0bb3ba
--- /dev/null
+++ b/modules/expo-bench-speech/ios/ExpoBenchSpeechModule.swift
@@ -0,0 +1,90 @@
+import ExpoModulesCore
+import Speech
+
+struct SpeechUnavailableError: Error, LocalizedError {
+  var errorDescription: String? { "Speech recognizer is not available" }
+}
+
+struct SpeechSampleMissingError: Error, LocalizedError {
+  var errorDescription: String? { "Sample audio file not found in bundle" }
+}
+
+public class ExpoBenchSpeechModule: Module {
+  private var recognitionTask: SFSpeechRecognitionTask?
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoBenchSpeech")
+
+    Events("onPartialTranscript")
+
+    Function("getAuthorizationStatus") { () -> String in
+      self.authorizationStatusString()
+    }
+
+    AsyncFunction("requestAuthorization") { () -> String in
+      await withCheckedContinuation { continuation in
+        SFSpeechRecognizer.requestAuthorization { _ in
+          continuation.resume()
+        }
+      }
+      return self.authorizationStatusString()
+    }
+
+    AsyncFunction("transcribeSample") { () -> String in
+      try await self.transcribeSample()
+    }
+  }
+
+  private func authorizationStatusString() -> String {
+    switch SFSpeechRecognizer.authorizationStatus() {
+    case .notDetermined: return "notDetermined"
+    case .authorized: return "authorized"
+    case .denied, .restricted: return "denied"
+    @unknown default: return "notDetermined"
+    }
+  }
+
+  private func sampleAudioURL() throws -> URL {
+    let moduleBundle = Bundle(for: ExpoBenchSpeechModule.self)
+    let assetBundle: Bundle
+    if let bundleURL = moduleBundle.url(forResource: "ExpoBenchSpeech", withExtension: "bundle"),
+      let resourceBundle = Bundle(url: bundleURL) {
+      assetBundle = resourceBundle
+    } else {
+      assetBundle = moduleBundle
+    }
+    guard let url = assetBundle.url(forResource: "sample", withExtension: "wav") else {
+      throw SpeechSampleMissingError()
+    }
+    return url
+  }
+
+  private func transcribeSample() async throws -> String {
+    guard let recognizer = SFSpeechRecognizer(), recognizer.isAvailable else {
+      throw SpeechUnavailableError()
+    }
+
+    let request = SFSpeechURLRecognitionRequest(url: try sampleAudioURL())
+    request.shouldReportPartialResults = true
+
+    return try await withCheckedThrowingContinuation { continuation in
+      var didResume = false
+      self.recognitionTask = recognizer.recognitionTask(with: request) { result, error in
+        if let error {
+          if !didResume {
+            didResume = true
+            continuation.resume(throwing: error)
+          }
+          return
+        }
+        guard let result else { return }
+        let text = result.bestTranscription.formattedString
+        self.sendEvent("onPartialTranscript", ["text": text, "isFinal": result.isFinal])
+        if result.isFinal && !didResume {
+          didResume = true
+          continuation.resume(returning: text)
+        }
+      }
+    }
+  }
+}
