@@ -0,0 +1,15 @@
+import { NativeModule, requireNativeModule } from 'expo';
+
+import { PartialTranscriptEvent, SpeechAuthorizationStatus } from './ExpoBenchSpeech.types';
+
+type ExpoBenchSpeechModuleEvents = {
+  onPartialTranscript(event: PartialTranscriptEvent): void;
+};
+
+declare class ExpoBenchSpeechModule extends NativeModule<ExpoBenchSpeechModuleEvents> {
+  getAuthorizationStatus(): SpeechAuthorizationStatus;
+  requestAuthorization(): Promise<SpeechAuthorizationStatus>;
+  transcribeSample(): Promise<string>;
+}
+
+export default requireNativeModule<ExpoBenchSpeechModule>('ExpoBenchSpeech');
