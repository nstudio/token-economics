diff --git a/modules/expo-bench-health/ios/ExpoBenchHealthModule.swift b/modules/expo-bench-health/ios/ExpoBenchHealthModule.swift
new file mode 100644
index 0000000..f6df62b
--- /dev/null
+++ b/modules/expo-bench-health/ios/ExpoBenchHealthModule.swift
@@ -0,0 +1,91 @@
+import ExpoModulesCore
+import HealthKit
+
+struct HealthUnavailableError: Error, LocalizedError {
+  var errorDescription: String? { "Health data is not available on this device" }
+}
+
+struct HealthQueryError: Error, LocalizedError {
+  var errorDescription: String? { "Unable to read step data" }
+}
+
+public class ExpoBenchHealthModule: Module {
+  private let healthStore = HKHealthStore()
+  private let stepType = HKQuantityType.quantityType(forIdentifier: .stepCount)!
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoBenchHealth")
+
+    Function("getAuthorizationStatus") { () -> String in
+      self.authorizationStatusString()
+    }
+
+    AsyncFunction("requestAuthorization") { () -> String in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        throw HealthUnavailableError()
+      }
+      try await self.healthStore.requestAuthorization(toShare: [self.stepType], read: [self.stepType])
+      return self.authorizationStatusString()
+    }
+
+    AsyncFunction("saveSteps") { (count: Double) in
+      let now = Date()
+      let quantity = HKQuantity(unit: .count(), doubleValue: count)
+      let sample = HKQuantitySample(type: self.stepType, quantity: quantity, start: now, end: now)
+      try await self.healthStore.save(sample)
+    }
+
+    AsyncFunction("getDailySteps") { () -> [[String: Any]] in
+      try await self.getDailySteps()
+    }
+  }
+
+  private func authorizationStatusString() -> String {
+    guard HKHealthStore.isHealthDataAvailable() else { return "sharingDenied" }
+    switch healthStore.authorizationStatus(for: stepType) {
+    case .notDetermined: return "notDetermined"
+    case .sharingDenied: return "sharingDenied"
+    case .sharingAuthorized: return "sharingAuthorized"
+    @unknown default: return "notDetermined"
+    }
+  }
+
+  private func getDailySteps() async throws -> [[String: Any]] {
+    let calendar = Calendar.current
+    let startOfToday = calendar.startOfDay(for: Date())
+    let startDate = calendar.date(byAdding: .day, value: -6, to: startOfToday)!
+    let endDate = calendar.date(byAdding: .day, value: 1, to: startOfToday)!
+
+    let predicate = HKQuery.predicateForSamples(withStart: startDate, end: endDate, options: .strictStartDate)
+
+    let collection: HKStatisticsCollection = try await withCheckedThrowingContinuation { continuation in
+      let query = HKStatisticsCollectionQuery(
+        quantityType: stepType,
+        quantitySamplePredicate: predicate,
+        options: .cumulativeSum,
+        anchorDate: startDate,
+        intervalComponents: DateComponents(day: 1)
+      )
+      query.initialResultsHandler = { _, result, error in
+        if let error {
+          continuation.resume(throwing: error)
+        } else if let result {
+          continuation.resume(returning: result)
+        } else {
+          continuation.resume(throwing: HealthQueryError())
+        }
+      }
+      healthStore.execute(query)
+    }
+
+    var days: [[String: Any]] = []
+    collection.enumerateStatistics(from: startDate, to: endDate) { statistics, _ in
+      let steps = statistics.sumQuantity()?.doubleValue(for: .count()) ?? 0
+      days.append([
+        "startOfDayMs": statistics.startDate.timeIntervalSince1970 * 1000,
+        "steps": Int(steps),
+      ])
+    }
+    return days
+  }
+}
