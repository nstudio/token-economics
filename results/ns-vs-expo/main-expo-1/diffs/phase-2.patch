+++ b/modules/expo-bench-health/src/ExpoBenchHealthModule.ts
@@ -0,0 +1,12 @@
+import { NativeModule, requireNativeModule } from 'expo';
+
+import { DailyStepEntry, HealthAuthorizationStatus } from './ExpoBenchHealth.types';
+
+declare class ExpoBenchHealthModule extends NativeModule<{}> {
+  getAuthorizationStatus(): HealthAuthorizationStatus;
+  requestAuthorization(): Promise<HealthAuthorizationStatus>;
+  saveSteps(count: number): Promise<void>;
+  getDailySteps(): Promise<DailyStepEntry[]>;
+}
+
+export default requireNativeModule<ExpoBenchHealthModule>('ExpoBenchHealth');
