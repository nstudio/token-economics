--- /dev/null
+++ b/modules/expo-speech-recognizer/ios/ExpoSpeechRecognizerModule.swift
@@ -0,0 +1,94 @@
+import ExpoModulesCore
+import Speech
+
+enum SpeechRecognizerError: LocalizedError {
+  case sampleNotFound
+  case recognizerUnavailable
+
+  var errorDescription: String? {
+    switch self {
+    case .sampleNotFound:
+      return "Bundled sample audio could not be found"
+    case .recognizerUnavailable:
+      return "Speech recognizer is not available right now"
+    }
+  }
+}
+
+public class ExpoSpeechRecognizerModule: Module {
+  private var recognitionTask: SFSpeechRecognitionTask?
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoSpeechRecognizer")
+
+    Events("onPartialResult")
+
+    Function("getAuthorizationStatus") { () -> String in
+      self.authorizationStatusString(SFSpeechRecognizer.authorizationStatus())
+    }
+
+    AsyncFunction("requestAuthorization") { () async -> String in
+      let status = await withCheckedContinuation { (continuation: CheckedContinuation<SFSpeechRecognizerAuthorizationStatus, Never>) in
+        SFSpeechRecognizer.requestAuthorization { status in
+          continuation.resume(returning: status)
+        }
+      }
+      return self.authorizationStatusString(status)
+    }
+
+    AsyncFunction("transcribeSample") { () async throws -> String in
+      try await self.transcribeSample()
+    }
+  }
+
+  private func authorizationStatusString(_ status: SFSpeechRecognizerAuthorizationStatus) -> String {
+    switch status {
+    case .notDetermined:
+      return "notDetermined"
+    case .authorized:
+      return "authorized"
+    case .denied, .restricted:
+      return "denied"
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+
+  private func transcribeSample() async throws -> String {
+    guard
+      let bundleURL = Bundle(for: ExpoSpeechRecognizerModule.self)
+        .url(forResource: "ExpoSpeechRecognizerAssets", withExtension: "bundle"),
+      let resourceBundle = Bundle(url: bundleURL),
+      let sampleURL = resourceBundle.url(forResource: "sample", withExtension: "wav")
+    else {
+      throw SpeechRecognizerError.sampleNotFound
+    }
+
+    guard let recognizer = SFSpeechRecognizer(), recognizer.isAvailable else {
+      throw SpeechRecognizerError.recognizerUnavailable
+    }
+
+    let request = SFSpeechURLRecognitionRequest(url: sampleURL)
+    request.shouldReportPartialResults = true
+
+    return try await withCheckedThrowingContinuation { continuation in
+      var didResume = false
+      self.recognitionTask = recognizer.recognitionTask(with: request) { result, error in
+        if let error {
+          if !didResume {
+            didResume = true
+            continuation.resume(throwing: error)
+          }
+          return
+        }
+        guard let result else { return }
+        let text = result.bestTranscription.formattedString
+        self.sendEvent("onPartialResult", ["text": text])
+        if result.isFinal, !didResume {
+          didResume = true
+          continuation.resume(returning: text)
+        }
+      }
+    }
+  }
+}
