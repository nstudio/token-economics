+import { useCallback, useRef, useState } from 'react';
 import { Button, ScrollView, StyleSheet, Text, View } from 'react-native';
+import { useFocusEffect } from '@react-navigation/native';
+
+import ExpoSpeechRecognizer from '../modules/expo-speech-recognizer/src/ExpoSpeechRecognizerModule';
+import type { SpeechAuthorizationStatus } from '../modules/expo-speech-recognizer/src/ExpoSpeechRecognizer.types';
+
+function statusLine(status: SpeechAuthorizationStatus): string {
+  switch (status) {
+    case 'authorized':
+      return 'Speech access: granted';
+    case 'denied':
+      return 'Speech access: denied';
+    default:
+      return 'Speech access: not requested';
+  }
+}
+
+function errorText(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
 
 export default function TranscribeScreen() {
+  const [accessStatus, setAccessStatus] = useState<SpeechAuthorizationStatus>('notDetermined');
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [transcript, setTranscript] = useState<string | null>(null);
+  const [completedIn, setCompletedIn] = useState<string | null>(null);
+  const [isTranscribing, setIsTranscribing] = useState(false);
+  const startedAtRef = useRef(0);
+
+  const refresh = useCallback(() => {
+    setAccessStatus(ExpoSpeechRecognizer.getAuthorizationStatus());
+  }, []);
+
+  useFocusEffect(
+    useCallback(() => {
+      refresh();
+    }, [refresh])
+  );
+
+  async function handleRequestAccess() {
+    setErrorMessage(null);
+    try {
+      const status = await ExpoSpeechRecognizer.requestAuthorization();
+      setAccessStatus(status);
+    } catch (error) {
+      setErrorMessage(errorText(error));
+    }
+  }
+
+  async function handleTranscribe() {
+    setErrorMessage(null);
+    setCompletedIn(null);
+    setTranscript(null);
+    setIsTranscribing(true);
+    startedAtRef.current = Date.now();
+
+    const subscription = ExpoSpeechRecognizer.addListener('onPartialResult', ({ text }) => {
+      setTranscript(text);
+    });
+
+    try {
+      const finalTranscript = await ExpoSpeechRecognizer.transcribeSample();
+      setTranscript(finalTranscript);
+      setCompletedIn(((Date.now() - startedAtRef.current) / 1000).toFixed(1));
+    } catch (error) {
+      setErrorMessage(errorText(error));
+    } finally {
+      subscription.remove();
+      setIsTranscribing(false);
+    }
+  }
+
   return (
     <ScrollView contentContainerStyle={styles.container}>
-      <Text style={styles.status}>Speech access: not requested</Text>
+      <Text style={styles.status}>
+        {errorMessage ?? (isTranscribing ? 'Transcribing…' : statusLine(accessStatus))}
+      </Text>
       <View style={styles.buttons}>
-        <Button title="Request Access" onPress={() => {}} />
+        <Button title="Request Access" onPress={handleRequestAccess} />
         <View style={styles.buttonSpacer} />
-        <Button title="Transcribe Sample" onPress={() => {}} disabled />
+        <Button
+          title="Transcribe Sample"
+          onPress={handleTranscribe}
+          disabled={accessStatus !== 'authorized' || isTranscribing}
+        />
       </View>
       <View style={styles.transcriptArea}>
-        <Text style={styles.emptyState}>No transcript yet</Text>
+        {transcript === null ? (
+          <Text style={styles.emptyState}>No transcript yet</Text>
+        ) : (
+          <>
+            <Text style={styles.transcript}>{transcript}</Text>
+            {completedIn !== null && (
+              <Text style={styles.completed}>Completed in {completedIn} s</Text>
+            )}
+          </>
+        )}
       </View>
     </ScrollView>
   );
