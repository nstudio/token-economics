-import { Button, ScrollView, StyleSheet, Text, View } from 'react-native';
+import { useCallback, useState } from 'react';
+import { ActivityIndicator, Button, ScrollView, StyleSheet, Text, View } from 'react-native';
+import { useFocusEffect } from '@react-navigation/native';
+
+import ExpoHealthStore from '../modules/expo-health-store/src/ExpoHealthStoreModule';
+import type {
+  DailyStepTotal,
+  HealthAuthorizationStatus,
+} from '../modules/expo-health-store/src/ExpoHealthStore.types';
+
+const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
+const MONTHS = [
+  'Jan',
+  'Feb',
+  'Mar',
+  'Apr',
+  'May',
+  'Jun',
+  'Jul',
+  'Aug',
+  'Sep',
+  'Oct',
+  'Nov',
+  'Dec',
+];
+
+function statusLine(status: HealthAuthorizationStatus): string {
+  switch (status) {
+    case 'authorized':
+      return 'Health access: granted';
+    case 'denied':
+      return 'Health access: denied';
+    default:
+      return 'Health access: not requested';
+  }
+}
+
+function formatRow(row: DailyStepTotal): string {
+  const [year, month, day] = row.dateKey.split('-').map(Number);
+  const date = new Date(year, month - 1, day);
+  const dayLabel = `${WEEKDAYS[date.getDay()]} ${MONTHS[date.getMonth()]} ${date.getDate()}`;
+  const stepsLabel = `${row.steps.toLocaleString('en-US')} steps`;
+  const line = `${dayLabel} — ${stepsLabel}`;
+  return row.isToday ? `${line} (today)` : line;
+}
+
+function errorText(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
 
 export default function HealthScreen() {
+  const [accessStatus, setAccessStatus] = useState<HealthAuthorizationStatus>('notDetermined');
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [days, setDays] = useState<DailyStepTotal[] | null>(null);
+  const [isLogging, setIsLogging] = useState(false);
+
+  const loadDays = useCallback(async () => {
+    const totals = await ExpoHealthStore.getDailyStepTotals(7);
+    setDays([...totals].reverse());
+  }, []);
+
+  const refresh = useCallback(async () => {
+    const status = ExpoHealthStore.getAuthorizationStatus();
+    setAccessStatus(status);
+    if (status === 'authorized') {
+      try {
+        await loadDays();
+      } catch (error) {
+        setErrorMessage(errorText(error));
+      }
+    } else {
+      setDays(null);
+    }
+  }, [loadDays]);
+
+  useFocusEffect(
+    useCallback(() => {
+      refresh();
+    }, [refresh])
+  );
+
+  async function handleRequestAccess() {
+    setErrorMessage(null);
+    try {
+      const status = await ExpoHealthStore.requestAuthorization();
+      setAccessStatus(status);
+      if (status === 'authorized') {
+        await loadDays();
+      } else {
+        setDays(null);
+      }
+    } catch (error) {
+      setErrorMessage(errorText(error));
+    }
+  }
+
+  async function handleLogSteps() {
+    setErrorMessage(null);
+    setIsLogging(true);
+    try {
+      await ExpoHealthStore.saveSteps(500);
+      await loadDays();
+    } catch (error) {
+      setErrorMessage(errorText(error));
+    } finally {
+      setIsLogging(false);
+    }
+  }
+
   return (
     <ScrollView contentContainerStyle={styles.container}>
-      <Text style={styles.status}>Health access: not requested</Text>
+      <Text style={styles.status}>{errorMessage ?? statusLine(accessStatus)}</Text>
       <View style={styles.buttons}>
-        <Button title="Request Access" onPress={() => {}} />
+        <Button title="Request Access" onPress={handleRequestAccess} />
         <View style={styles.buttonSpacer} />
-        <Button title="Log 500 Steps" onPress={() => {}} disabled />
+        <Button
+          title="Log 500 Steps"
+          onPress={handleLogSteps}
+          disabled={accessStatus !== 'authorized' || isLogging}
+        />
       </View>
       <Text style={styles.sectionHeader}>Last 7 Days</Text>
-      <Text style={styles.emptyState}>No data yet</Text>
+      {accessStatus !== 'authorized' ? (
+        <Text style={styles.emptyState}>Health access needed</Text>
+      ) : days === null ? (
+        <ActivityIndicator />
+      ) : (
+        days.map((row) => (
+          <Text key={row.dateKey} style={row.isToday ? styles.rowToday : styles.row}>
+            {formatRow(row)}
+          </Text>
+        ))
+      )}
     </ScrollView>
   );
 }
