@@ -0,0 +1,12 @@
+import { NativeModule, requireNativeModule } from 'expo';
+
+import type { DailyStepTotal, HealthAuthorizationStatus } from './ExpoHealthStore.types';
+
+declare class ExpoHealthStoreModule extends NativeModule<{}> {
+  getAuthorizationStatus(): HealthAuthorizationStatus;
+  requestAuthorization(): Promise<HealthAuthorizationStatus>;
+  saveSteps(count: number): Promise<void>;
+  getDailyStepTotals(days: number): Promise<DailyStepTotal[]>;
+}
+
+export default requireNativeModule<ExpoHealthStoreModule>('ExpoHealthStore');
