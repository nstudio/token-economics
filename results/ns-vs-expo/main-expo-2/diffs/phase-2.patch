diff --git a/modules/expo-health-store/ios/ExpoHealthStoreModule.swift b/modules/expo-health-store/ios/ExpoHealthStoreModule.swift
new file mode 100644
index 0000000..9e282bc
--- /dev/null
+++ b/modules/expo-health-store/ios/ExpoHealthStoreModule.swift
@@ -0,0 +1,122 @@
+import ExpoModulesCore
+import HealthKit
+
+struct DailyStepTotalRecord: Record {
+  @Field var dateKey: String = ""
+  @Field var steps: Int = 0
+  @Field var isToday: Bool = false
+}
+
+enum HealthStoreError: LocalizedError {
+  case unavailable
+  case queryFailed
+
+  var errorDescription: String? {
+    switch self {
+    case .unavailable:
+      return "Health data is not available on this device"
+    case .queryFailed:
+      return "Failed to read step data"
+    }
+  }
+}
+
+public class ExpoHealthStoreModule: Module {
+  private let healthStore = HKHealthStore()
+  private let stepType = HKQuantityType.quantityType(forIdentifier: .stepCount)!
+
+  public func definition() -> ModuleDefinition {
+    Name("ExpoHealthStore")
+
+    Function("getAuthorizationStatus") { () -> String in
+      self.authorizationStatusString()
+    }
+
+    AsyncFunction("requestAuthorization") { () async throws -> String in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        throw HealthStoreError.unavailable
+      }
+      try await self.healthStore.requestAuthorization(toShare: [self.stepType], read: [self.stepType])
+      return self.authorizationStatusString()
+    }
+
+    AsyncFunction("saveSteps") { (count: Double) async throws in
+      let now = Date()
+      let quantity = HKQuantity(unit: .count(), doubleValue: count)
+      let sample = HKQuantitySample(type: self.stepType, quantity: quantity, start: now, end: now)
+      try await self.healthStore.save(sample)
+    }
+
+    AsyncFunction("getDailyStepTotals") { (days: Int) async throws -> [DailyStepTotalRecord] in
+      try await self.dailyStepTotals(days: days)
+    }
+  }
+
+  private func authorizationStatusString() -> String {
+    switch healthStore.authorizationStatus(for: stepType) {
+    case .notDetermined:
+      return "notDetermined"
+    case .sharingDenied:
+      return "denied"
+    case .sharingAuthorized:
+      return "authorized"
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+
+  private func dailyStepTotals(days: Int) async throws -> [DailyStepTotalRecord] {
+    let calendar = Calendar.current
+    let todayStart = calendar.startOfDay(for: Date())
+    guard
+      let earliestStart = calendar.date(byAdding: .day, value: -(days - 1), to: todayStart),
+      let rangeEnd = calendar.date(byAdding: .day, value: 1, to: todayStart)
+    else {
+      return []
+    }
+
+    var intervalComponents = DateComponents()
+    intervalComponents.day = 1
+
+    let predicate = HKQuery.predicateForSamples(withStart: earliestStart, end: rangeEnd, options: .strictStartDate)
+    let query = HKStatisticsCollectionQuery(
+      quantityType: stepType,
+      quantitySamplePredicate: predicate,
+      options: .cumulativeSum,
+      anchorDate: todayStart,
+      intervalComponents: intervalComponents
+    )
+
+    let collection: HKStatisticsCollection = try await withCheckedThrowingContinuation { continuation in
+      query.initialResultsHandler = { _, collection, error in
+        if let error {
+          continuation.resume(throwing: error)
+        } else if let collection {
+          continuation.resume(returning: collection)
+        } else {
+          continuation.resume(throwing: HealthStoreError.queryFailed)
+        }
+      }
+      healthStore.execute(query)
+    }
+
+    let dateKeyFormatter = DateFormatter()
+    dateKeyFormatter.dateFormat = "yyyy-MM-dd"
+    dateKeyFormatter.calendar = calendar
+    dateKeyFormatter.timeZone = calendar.timeZone
+
+    var totals: [DailyStepTotalRecord] = []
+    for dayOffset in 0..<days {
+      guard let dayStart = calendar.date(byAdding: .day, value: -(days - 1 - dayOffset), to: todayStart) else {
+        continue
+      }
+      let sum = collection.statistics(for: dayStart)?.sumQuantity()?.doubleValue(for: .count()) ?? 0
+      var record = DailyStepTotalRecord()
+      record.dateKey = dateKeyFormatter.string(from: dayStart)
+      record.steps = Int(sum.rounded())
+      record.isToday = calendar.isDateInToday(dayStart)
+      totals.append(record)
+    }
+    return totals
+  }
+}
