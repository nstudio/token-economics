+export type SpeechAuthorizationStatus = 'notDetermined' | 'authorized' | 'denied';
+
+export type PartialTranscriptEvent = {
+  transcript: string;
+};
+
+export type SpeechKitModuleEvents = {
+  onPartialTranscript: (event: PartialTranscriptEvent) => void;
+};
diff --git a/modules/speech-kit/src/SpeechKitModule.web.ts b/modules/speech-kit/src/SpeechKitModule.web.ts
new file mode 100644
index 0000000..e550fad
--- /dev/null
+++ b/modules/speech-kit/src/SpeechKitModule.web.ts
@@ -0,0 +1,19 @@
+import { NativeModule, registerWebModule } from 'expo';
+
+import { SpeechAuthorizationStatus, SpeechKitModuleEvents } from './SpeechKitModule.types';
+
+class SpeechKitModule extends NativeModule<SpeechKitModuleEvents> {
+  getAuthorizationStatus(): SpeechAuthorizationStatus {
+    return 'denied';
+  }
+
+  async requestAuthorization(): Promise<SpeechAuthorizationStatus> {
+    return 'denied';
+  }
+
+  async transcribeSample(): Promise<string> {
+    throw new Error('Speech recognition is not available on this platform.');
+  }
+}
+
+export default registerWebModule(SpeechKitModule, 'SpeechKitModule');
