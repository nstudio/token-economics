+import { NativeModule, requireNativeModule } from 'expo';
+
+import { SpeechAuthorizationStatus, SpeechKitModuleEvents } from './SpeechKitModule.types';
+
+declare class SpeechKitModule extends NativeModule<SpeechKitModuleEvents> {
+  getAuthorizationStatus(): SpeechAuthorizationStatus;
+  requestAuthorization(): Promise<SpeechAuthorizationStatus>;
+  transcribeSample(): Promise<string>;
+}
+
+export default requireNativeModule<SpeechKitModule>('SpeechKitModule');
