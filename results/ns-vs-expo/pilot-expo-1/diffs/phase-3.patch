 import { ThemedView } from '@/components/themed-view';
 import { Spacing } from '@/constants/theme';
 
+import SpeechKitModule from '../../modules/speech-kit/src/SpeechKitModule';
+import { SpeechAuthorizationStatus } from '../../modules/speech-kit/src/SpeechKitModule.types';
+
+const STATUS_LABEL: Record<SpeechAuthorizationStatus, string> = {
+  notDetermined: 'Speech access: not requested',
+  authorized: 'Speech access: granted',
+  denied: 'Speech access: denied',
+};
+
 export default function TranscribeScreen() {
+  const [status, setStatus] = useState<SpeechAuthorizationStatus>('notDetermined');
+  const [statusError, setStatusError] = useState<string | null>(null);
+  const [isTranscribing, setIsTranscribing] = useState(false);
+  const [transcript, setTranscript] = useState<string | null>(null);
+  const [elapsedSeconds, setElapsedSeconds] = useState<number | null>(null);
+  const startedAtRef = useRef(0);
+
+  useEffect(() => {
+    const subscription = SpeechKitModule.addListener('onPartialTranscript', (event) => {
+      setTranscript(event.transcript);
+    });
+    return () => subscription.remove();
+  }, []);
+
+  useFocusEffect(
+    useCallback(() => {
+      setStatus(SpeechKitModule.getAuthorizationStatus());
+      setStatusError(null);
+    }, [])
+  );
+
+  const requestAccess = async () => {
+    setStatusError(null);
+    try {
+      const result = await SpeechKitModule.requestAuthorization();
+      setStatus(result);
+    } catch (error) {
+      setStatusError(error instanceof Error ? error.message : String(error));
+    }
+  };
+
+  const transcribeSample = async () => {
+    setStatusError(null);
+    setTranscript(null);
+    setElapsedSeconds(null);
+    setIsTranscribing(true);
+    startedAtRef.current = Date.now();
+    try {
+      const result = await SpeechKitModule.transcribeSample();
+      setTranscript(result);
+      setElapsedSeconds((Date.now() - startedAtRef.current) / 1000);
+    } catch (error) {
+      setStatusError(error instanceof Error ? error.message : String(error));
+    } finally {
+      setIsTranscribing(false);
+    }
+  };
+
+  const statusLine = statusError ?? (isTranscribing ? 'Transcribing…' : STATUS_LABEL[status]);
+
   return (
     <ThemedView style={styles.container}>
       <SafeAreaView style={styles.safeArea}>
-        <ThemedText type="default">Speech access: not requested</ThemedText>
+        <ThemedText type="default">{statusLine}</ThemedText>
 
         <ThemedView style={styles.buttonGroup}>
-          <Button title="Request Access" onPress={() => {}} />
-          <Button title="Transcribe Sample" onPress={() => {}} disabled />
+          <Button title="Request Access" onPress={requestAccess} />
+          <Button
+            title="Transcribe Sample"
+            onPress={transcribeSample}
+            disabled={status !== 'authorized' || isTranscribing}
+          />
         </ThemedView>
 
         <ThemedView style={styles.section}>
-          <ThemedText type="small" themeColor="textSecondary">
-            No transcript yet
-          </ThemedText>
+          {!transcript && (
+            <ThemedText type="small" themeColor="textSecondary">
+              No transcript yet
+            </ThemedText>
+          )}
+
+          {transcript && <ThemedText type="default">{transcript}</ThemedText>}
+
+          {elapsedSeconds !== null && (
+            <ThemedText type="small" themeColor="textSecondary">
+              Completed in {elapsedSeconds.toFixed(1)} s
+            </ThemedText>
+          )}
         </ThemedView>
       </SafeAreaView>
     </ThemedView>
