diff --git a/modules/health-kit/ios/HealthKitModule.swift b/modules/health-kit/ios/HealthKitModule.swift
new file mode 100644
index 0000000..fccc65d
--- /dev/null
+++ b/modules/health-kit/ios/HealthKitModule.swift
@@ -0,0 +1,104 @@
+import ExpoModulesCore
+import HealthKit
+
+internal final class HealthDataUnavailableException: Exception {
+  override var reason: String {
+    "Health data is not available on this device."
+  }
+}
+
+internal final class HealthStatisticsQueryFailedException: GenericException<String> {
+  override var reason: String {
+    "Failed to read step data: \(param)"
+  }
+}
+
+struct DaySteps: Record {
+  @Field var date: String = ""
+  @Field var steps: Int = 0
+}
+
+public class HealthKitModule: Module {
+  private let healthStore = HKHealthStore()
+  private let stepType = HKQuantityType.quantityType(forIdentifier: .stepCount)!
+
+  public func definition() -> ModuleDefinition {
+    Name("HealthKitModule")
+
+    Function("getAuthorizationStatus") { () -> String in
+      self.authorizationStatusString()
+    }
+
+    AsyncFunction("requestAuthorization") { () async throws -> String in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        throw HealthDataUnavailableException()
+      }
+      try await self.healthStore.requestAuthorization(toShare: [self.stepType], read: [self.stepType])
+      return self.authorizationStatusString()
+    }
+
+    AsyncFunction("logSteps") { (count: Double) async throws in
+      let now = Date()
+      let quantity = HKQuantity(unit: .count(), doubleValue: count)
+      let sample = HKQuantitySample(type: self.stepType, quantity: quantity, start: now, end: now)
+      try await self.healthStore.save(sample)
+    }
+
+    AsyncFunction("getLastSevenDays") { () async throws -> [DaySteps] in
+      try await self.lastSevenDaysSteps()
+    }
+  }
+
+  private func authorizationStatusString() -> String {
+    switch healthStore.authorizationStatus(for: stepType) {
+    case .sharingAuthorized:
+      return "authorized"
+    case .sharingDenied:
+      return "denied"
+    case .notDetermined:
+      fallthrough
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+
+  private func lastSevenDaysSteps() async throws -> [DaySteps] {
+    let calendar = Calendar.current
+    let startOfToday = calendar.startOfDay(for: Date())
+    let startDate = calendar.date(byAdding: .day, value: -6, to: startOfToday)!
+    let endDate = calendar.date(byAdding: .day, value: 1, to: startOfToday)!
+    let predicate = HKQuery.predicateForSamples(withStart: startDate, end: endDate, options: .strictStartDate)
+
+    let collection: HKStatisticsCollection = try await withCheckedThrowingContinuation { continuation in
+      let query = HKStatisticsCollectionQuery(
+        quantityType: stepType,
+        quantitySamplePredicate: predicate,
+        options: .cumulativeSum,
+        anchorDate: startDate,
+        intervalComponents: DateComponents(day: 1)
+      )
+      query.initialResultsHandler = { _, results, error in
+        if let results {
+          continuation.resume(returning: results)
+        } else {
+          continuation.resume(throwing: HealthStatisticsQueryFailedException(error?.localizedDescription ?? "unknown error"))
+        }
+      }
+      healthStore.execute(query)
+    }
+
+    let dateFormatter = ISO8601DateFormatter()
+    dateFormatter.formatOptions = [.withFullDate]
+
+    var days: [DaySteps] = []
+    for offset in 0..<7 {
+      let dayStart = calendar.date(byAdding: .day, value: offset, to: startDate)!
+      let steps = collection.statistics(for: dayStart)?.sumQuantity()?.doubleValue(for: .count()) ?? 0
+      var day = DaySteps()
+      day.date = dateFormatter.string(from: dayStart)
+      day.steps = Int(steps)
+      days.append(day)
+    }
+    return days.reversed()
+  }
+}
