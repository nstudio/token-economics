+import { NativeModule, requireNativeModule } from 'expo';
+
+import { DaySteps, HealthAuthorizationStatus } from './HealthKitModule.types';
+
+declare class HealthKitModule extends NativeModule<{}> {
+  getAuthorizationStatus(): HealthAuthorizationStatus;
+  requestAuthorization(): Promise<HealthAuthorizationStatus>;
+  logSteps(count: number): Promise<void>;
+  getLastSevenDays(): Promise<DaySteps[]>;
+}
+
+export default requireNativeModule<HealthKitModule>('HealthKitModule');
