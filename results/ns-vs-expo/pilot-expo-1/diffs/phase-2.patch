+import HealthKitModule from '../../modules/health-kit/src/HealthKitModule';
+import { DaySteps, HealthAuthorizationStatus } from '../../modules/health-kit/src/HealthKitModule.types';
+
+const STEPS_PER_LOG = 500;
+
+const STATUS_LABEL: Record<HealthAuthorizationStatus, string> = {
+  notDetermined: 'Health access: not requested',
+  authorized: 'Health access: granted',
+  denied: 'Health access: denied',
+};
+
+const dayFormatter = new Intl.DateTimeFormat('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
+const stepsFormatter = new Intl.NumberFormat('en-US');
+
+function formatDayLabel(isoDate: string) {
+  const date = new Date(`${isoDate}T00:00:00`);
+  return dayFormatter.format(date).replace(',', '');
+}
+
 export default function HealthScreen() {
+  const [status, setStatus] = useState<HealthAuthorizationStatus>('notDetermined');
+  const [statusError, setStatusError] = useState<string | null>(null);
+  const [days, setDays] = useState<DaySteps[] | null>(null);
+  const [isLogging, setIsLogging] = useState(false);
+
+  const loadLastSevenDays = useCallback(async () => {
+    try {
+      const result = await HealthKitModule.getLastSevenDays();
+      setDays(result);
+    } catch (error) {
+      setStatusError(error instanceof Error ? error.message : String(error));
+    }
+  }, []);
+
+  useFocusEffect(
+    useCallback(() => {
+      const current = HealthKitModule.getAuthorizationStatus();
+      setStatus(current);
+      setStatusError(null);
+      if (current === 'authorized') {
+        loadLastSevenDays();
+      }
+    }, [loadLastSevenDays])
+  );
+
+  const requestAccess = async () => {
+    setStatusError(null);
+    try {
+      const result = await HealthKitModule.requestAuthorization();
+      setStatus(result);
+      if (result === 'authorized') {
+        loadLastSevenDays();
+      }
+    } catch (error) {
+      setStatusError(error instanceof Error ? error.message : String(error));
+    }
+  };
+
+  const logSteps = async () => {
+    setStatusError(null);
+    setIsLogging(true);
+    try {
+      await HealthKitModule.logSteps(STEPS_PER_LOG);
+      await loadLastSevenDays();
+    } catch (error) {
+      setStatusError(error instanceof Error ? error.message : String(error));
+    } finally {
+      setIsLogging(false);
+    }
+  };
+
+  const statusLine = statusError ?? STATUS_LABEL[status];
+
   return (
     <ThemedView style={styles.container}>
       <SafeAreaView style={styles.safeArea}>
-        <ThemedText type="default">Health access: not requested</ThemedText>
+        <ThemedText type="default">{statusLine}</ThemedText>
 
         <ThemedView style={styles.buttonGroup}>
-          <Button title="Request Access" onPress={() => {}} />
-          <Button title="Log 500 Steps" onPress={() => {}} disabled />
+          <Button title="Request Access" onPress={requestAccess} />
+          <Button
+            title="Log 500 Steps"
+            onPress={logSteps}
+            disabled={status !== 'authorized' || isLogging}
+          />
         </ThemedView>
 
         <ThemedView style={styles.section}>
           <ThemedText type="smallBold">Last 7 Days</ThemedText>
-          <ThemedText type="small" themeColor="textSecondary">
-            No data yet
-          </ThemedText>
+
+          {status === 'denied' && (
+            <ThemedText type="small" themeColor="textSecondary">
+              Health access needed
+            </ThemedText>
+          )}
+
+          {status !== 'denied' && (status !== 'authorized' || !days || days.length === 0) && (
+            <ThemedText type="small" themeColor="textSecondary">
+              No data yet
+            </ThemedText>
+          )}
+
+          {status === 'authorized' &&
+            days &&
+            days.map((day, index) => {
+              const isToday = index === 0;
+              const suffix = isToday ? ' (today)' : '';
+              return (
+                <ThemedText key={day.date} type={isToday ? 'smallBold' : 'small'}>
+                  {formatDayLabel(day.date)} — {stepsFormatter.format(day.steps)} steps{suffix}
+                </ThemedText>
+              );
+            })}
         </ThemedView>
       </SafeAreaView>
     </ThemedView>
