@@ -0,0 +1,23 @@
+import { NativeModule, registerWebModule } from 'expo';
+
+import { DaySteps, HealthAuthorizationStatus } from './HealthKitModule.types';
+
+class HealthKitModule extends NativeModule<{}> {
+  getAuthorizationStatus(): HealthAuthorizationStatus {
+    return 'denied';
+  }
+
+  async requestAuthorization(): Promise<HealthAuthorizationStatus> {
+    return 'denied';
+  }
+
+  async logSteps(_count: number): Promise<void> {
+    throw new Error('HealthKit is not available on this platform.');
+  }
+
+  async getLastSevenDays(): Promise<DaySteps[]> {
+    return [];
+  }
+}
+
+export default registerWebModule(HealthKitModule, 'HealthKitModule');
