+<script setup lang="ts">
+import { ref } from 'vue'
+import { knownFolders, Utils, type NavigatedData } from '@nativescript/core'
+
+type AuthState = 'notRequested' | 'granted' | 'denied'
+
+const authState = ref<AuthState>('notRequested')
+const statusLine = ref('Speech access: not requested')
+const isTranscribing = ref(false)
+const transcript = ref('No transcript yet')
+const completedLine = ref('')
+
+function statusTextFor(state: AuthState): string {
+    if (state === 'granted') return 'Speech access: granted'
+    if (state === 'denied') return 'Speech access: denied'
+    return 'Speech access: not requested'
+}
+
+function authStateFromStatus(status: SFSpeechRecognizerAuthorizationStatus): AuthState {
+    if (status === SFSpeechRecognizerAuthorizationStatus.Authorized) return 'granted'
+    if (status === SFSpeechRecognizerAuthorizationStatus.NotDetermined) return 'notRequested'
+    return 'denied'
+}
+
+function errorText(error: NSError | null | undefined, fallback: string): string {
+    return error?.localizedDescription ?? fallback
+}
+
+function refreshAuthStatus() {
+    authState.value = authStateFromStatus(SFSpeechRecognizer.authorizationStatus())
+    if (!isTranscribing.value) {
+        statusLine.value = statusTextFor(authState.value)
+    }
+}
+
+function requestAccess() {
+    SFSpeechRecognizer.requestAuthorization(() => {
+        Utils.dispatchToMainThread(() => {
+            refreshAuthStatus()
+        })
+    })
+}
+
+function transcribeSample() {
+    if (authState.value !== 'granted' || isTranscribing.value) return
+
+    const recognizer = SFSpeechRecognizer.alloc().initWithLocale(NSLocale.alloc().initWithLocaleIdentifier('en-US'))
+    if (!recognizer || !recognizer.available) {
+        statusLine.value = 'Speech recognizer is not available'
+        return
+    }
+
+    const sampleFile = knownFolders.currentApp().getFile('assets/sample.wav')
+    const request = SFSpeechURLRecognitionRequest.alloc().initWithURL(NSURL.fileURLWithPath(sampleFile.path))
+    request.shouldReportPartialResults = true
+    request.requiresOnDeviceRecognition = false
+
+    isTranscribing.value = true
+    statusLine.value = 'Transcribing…'
+    transcript.value = 'No transcript yet'
+    completedLine.value = ''
+
+    const startTime = Date.now()
+
+    recognizer.recognitionTaskWithRequestResultHandler(request, (result, error) => {
+        Utils.dispatchToMainThread(() => {
+            if (error) {
+                isTranscribing.value = false
+                statusLine.value = errorText(error, 'Transcription failed')
+                return
+            }
+
+            if (!result) return
+
+            transcript.value = result.bestTranscription.formattedString
+
+            if (result.final) {
+                const elapsedSeconds = (Date.now() - startTime) / 1000
+                completedLine.value = `Completed in ${elapsedSeconds.toFixed(1)} s`
+                isTranscribing.value = false
+                statusLine.value = statusTextFor(authState.value)
+            }
+        })
+    })
+}
+
+function onNavigatedTo(_args: NavigatedData) {
+    refreshAuthStatus()
+}
+</script>
