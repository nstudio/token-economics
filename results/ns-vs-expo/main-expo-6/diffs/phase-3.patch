+import { useCallback, useState } from 'react';
 import { StyleSheet, Text, View, Pressable, ScrollView } from 'react-native';
+import { useFocusEffect } from '@react-navigation/native';
+
+import SpeechRecognizerModule from '../modules/speech-recognizer/src/SpeechRecognizerModule';
+import type { SpeechAuthorizationStatus } from '../modules/speech-recognizer/src/SpeechRecognizerModule.types';
+
+const STATUS_LABEL: Record<SpeechAuthorizationStatus, string> = {
+  notDetermined: 'Speech access: not requested',
+  authorized: 'Speech access: granted',
+  denied: 'Speech access: denied',
+};
+
+function errorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
 
 export default function TranscribeScreen() {
+  const [authStatus, setAuthStatus] = useState<SpeechAuthorizationStatus>('notDetermined');
+  const [statusOverride, setStatusOverride] = useState<string | null>(null);
+  const [transcript, setTranscript] = useState('');
+  const [completedSeconds, setCompletedSeconds] = useState<number | null>(null);
+  const [transcribing, setTranscribing] = useState(false);
+
+  useFocusEffect(
+    useCallback(() => {
+      setStatusOverride(null);
+      setAuthStatus(SpeechRecognizerModule.getAuthorizationStatus());
+    }, [])
+  );
+
+  const handleRequestAccess = async () => {
+    try {
+      const status = await SpeechRecognizerModule.requestAuthorization();
+      setStatusOverride(null);
+      setAuthStatus(status);
+    } catch (error) {
+      setStatusOverride(errorMessage(error));
+    }
+  };
+
+  const handleTranscribe = async () => {
+    setTranscribing(true);
+    setStatusOverride(null);
+    setTranscript('');
+    setCompletedSeconds(null);
+
+    const startedAt = Date.now();
+    const subscription = SpeechRecognizerModule.addListener('onPartialTranscript', (event) => {
+      setTranscript(event.transcript);
+    });
+
+    try {
+      const finalTranscript = await SpeechRecognizerModule.transcribeSample();
+      setTranscript(finalTranscript);
+      setCompletedSeconds((Date.now() - startedAt) / 1000);
+    } catch (error) {
+      setStatusOverride(errorMessage(error));
+    } finally {
+      subscription.remove();
+      setTranscribing(false);
+    }
+  };
+
+  const transcribeDisabled = authStatus !== 'authorized' || transcribing;
+  const statusText = transcribing ? 'Transcribing…' : statusOverride ?? STATUS_LABEL[authStatus];
+
   return (
     <ScrollView contentContainerStyle={styles.container}>
-      <Text style={styles.status}>Speech access: not requested</Text>
+      <Text style={styles.status}>{statusText}</Text>
 
       <View style={styles.buttons}>
-        <Pressable style={styles.button}>
+        <Pressable style={styles.button} onPress={handleRequestAccess}>
           <Text style={styles.buttonText}>Request Access</Text>
         </Pressable>
-        <Pressable style={[styles.button, styles.buttonDisabled]} disabled>
-          <Text style={[styles.buttonText, styles.buttonTextDisabled]}>
+        <Pressable
+          style={[styles.button, transcribeDisabled && styles.buttonDisabled]}
+          disabled={transcribeDisabled}
+          onPress={handleTranscribe}
+        >
+          <Text style={[styles.buttonText, transcribeDisabled && styles.buttonTextDisabled]}>
             Transcribe Sample
           </Text>
         </Pressable>
       </View>
 
       <View style={styles.transcriptArea}>
-        <Text style={styles.emptyState}>No transcript yet</Text>
+        {transcript.length === 0 ? (
+          <Text style={styles.emptyState}>No transcript yet</Text>
+        ) : (
+          <>
+            <Text style={styles.transcriptText}>{transcript}</Text>
+            {completedSeconds !== null && (
+              <Text style={styles.completedText}>
+                Completed in {completedSeconds.toFixed(1)} s
+              </Text>
+            )}
+          </>
+        )}
       </View>
     </ScrollView>
   );
