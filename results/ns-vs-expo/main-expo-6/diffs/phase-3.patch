+import { NativeModule, requireNativeModule } from 'expo';
+
+import type {
+  PartialTranscriptEvent,
+  SpeechAuthorizationStatus,
+} from './SpeechRecognizerModule.types';
+
+export type SpeechRecognizerModuleEvents = {
+  onPartialTranscript(event: PartialTranscriptEvent): void;
+};
+
+declare class SpeechRecognizerModule extends NativeModule<SpeechRecognizerModuleEvents> {
+  requestAuthorization(): Promise<SpeechAuthorizationStatus>;
+  getAuthorizationStatus(): SpeechAuthorizationStatus;
+  transcribeSample(): Promise<string>;
+}
+
+export default requireNativeModule<SpeechRecognizerModule>('SpeechRecognizerModule');
