+import { useCallback, useState } from 'react';
 import { StyleSheet, Text, View, Pressable, ScrollView } from 'react-native';
+import { useFocusEffect } from '@react-navigation/native';
+
+import HealthKitModule from '../modules/health-kit/src/HealthKitModule';
+import type {
+  DailySteps,
+  HealthAuthorizationStatus,
+} from '../modules/health-kit/src/HealthKitModule.types';
+
+const STATUS_LABEL: Record<HealthAuthorizationStatus, string> = {
+  notDetermined: 'Health access: not requested',
+  authorized: 'Health access: granted',
+  denied: 'Health access: denied',
+};
+
+function errorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
+function formatDayLabel(dateISO: string): string {
+  const date = new Date(`${dateISO}T00:00:00`);
+  const weekday = date.toLocaleDateString('en-US', { weekday: 'short' });
+  const monthDay = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
+  return `${weekday} ${monthDay}`;
+}
 
 export default function HealthScreen() {
+  const [authStatus, setAuthStatus] = useState<HealthAuthorizationStatus>('notDetermined');
+  const [statusOverride, setStatusOverride] = useState<string | null>(null);
+  const [days, setDays] = useState<DailySteps[]>([]);
+  const [logging, setLogging] = useState(false);
+
+  const loadDays = useCallback(async () => {
+    try {
+      setDays(await HealthKitModule.getLastSevenDaysSteps());
+    } catch (error) {
+      setStatusOverride(errorMessage(error));
+    }
+  }, []);
+
+  useFocusEffect(
+    useCallback(() => {
+      setStatusOverride(null);
+      const status = HealthKitModule.getAuthorizationStatus();
+      setAuthStatus(status);
+      if (status === 'authorized') {
+        loadDays();
+      }
+    }, [loadDays])
+  );
+
+  const handleRequestAccess = async () => {
+    try {
+      const status = await HealthKitModule.requestAuthorization();
+      setStatusOverride(null);
+      setAuthStatus(status);
+      if (status === 'authorized') {
+        await loadDays();
+      }
+    } catch (error) {
+      setStatusOverride(errorMessage(error));
+    }
+  };
+
+  const handleLogSteps = async () => {
+    setLogging(true);
+    try {
+      await HealthKitModule.logSteps(500);
+      setStatusOverride(null);
+      await loadDays();
+    } catch (error) {
+      setStatusOverride(errorMessage(error));
+    } finally {
+      setLogging(false);
+    }
+  };
+
+  const logDisabled = authStatus !== 'authorized' || logging;
+  const statusText = statusOverride ?? STATUS_LABEL[authStatus];
+
   return (
     <ScrollView contentContainerStyle={styles.container}>
-      <Text style={styles.status}>Health access: not requested</Text>
+      <Text style={styles.status}>{statusText}</Text>
 
       <View style={styles.buttons}>
-        <Pressable style={styles.button}>
+        <Pressable style={styles.button} onPress={handleRequestAccess}>
           <Text style={styles.buttonText}>Request Access</Text>
         </Pressable>
-        <Pressable style={[styles.button, styles.buttonDisabled]} disabled>
-          <Text style={[styles.buttonText, styles.buttonTextDisabled]}>
+        <Pressable
+          style={[styles.button, logDisabled && styles.buttonDisabled]}
+          disabled={logDisabled}
+          onPress={handleLogSteps}
+        >
+          <Text style={[styles.buttonText, logDisabled && styles.buttonTextDisabled]}>
             Log 500 Steps
           </Text>
         </Pressable>
       </View>
 
       <Text style={styles.sectionHeader}>Last 7 Days</Text>
-      <Text style={styles.emptyState}>No data yet</Text>
+      {authStatus === 'denied' ? (
+        <Text style={styles.emptyState}>Health access needed</Text>
+      ) : days.length === 0 ? (
+        <Text style={styles.emptyState}>No data yet</Text>
+      ) : (
+        days.map((day, index) => {
+          const isToday = index === 0;
+          const label = `${formatDayLabel(day.dateISO)} — ${day.steps.toLocaleString('en-US')} steps${
+            isToday ? ' (today)' : ''
+          }`;
+          return (
+            <Text
+              key={day.dateISO}
+              style={[styles.dayRow, isToday && styles.dayRowToday]}
+            >
+              {label}
+            </Text>
+          );
+        })
+      )}
     </ScrollView>
   );
 }
