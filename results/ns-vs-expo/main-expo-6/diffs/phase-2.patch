--- /dev/null
+++ b/modules/health-kit/ios/HealthKitModule.swift
@@ -0,0 +1,115 @@
+import ExpoModulesCore
+import HealthKit
+
+private let healthStore = HKHealthStore()
+
+internal final class HealthDataUnavailableException: Exception {
+  override var reason: String {
+    "Health data is not available on this device."
+  }
+}
+
+internal final class StepCountTypeUnavailableException: Exception {
+  override var reason: String {
+    "Step count is not available on this device."
+  }
+}
+
+public class HealthKitModule: Module {
+  public func definition() -> ModuleDefinition {
+    Name("HealthKitModule")
+
+    AsyncFunction("requestAuthorization") { () -> String in
+      guard HKHealthStore.isHealthDataAvailable() else {
+        throw HealthDataUnavailableException()
+      }
+      let stepType = try HealthKitModule.stepCountType()
+      try await healthStore.requestAuthorization(toShare: [stepType], read: [stepType])
+      return HealthKitModule.sharingAuthorizationStatus(for: stepType)
+    }
+
+    Function("getAuthorizationStatus") { () -> String in
+      guard let stepType = HKQuantityType.quantityType(forIdentifier: .stepCount) else {
+        return "notDetermined"
+      }
+      return HealthKitModule.sharingAuthorizationStatus(for: stepType)
+    }
+
+    AsyncFunction("logSteps") { (count: Double) in
+      let stepType = try HealthKitModule.stepCountType()
+      let now = Date()
+      let quantity = HKQuantity(unit: .count(), doubleValue: count)
+      let sample = HKQuantitySample(type: stepType, quantity: quantity, start: now, end: now)
+      try await healthStore.save(sample)
+    }
+
+    AsyncFunction("getLastSevenDaysSteps") { () -> [[String: Any]] in
+      let stepType = try HealthKitModule.stepCountType()
+      return try await HealthKitModule.fetchLastSevenDaysSteps(stepType: stepType)
+    }
+  }
+
+  private static func stepCountType() throws -> HKQuantityType {
+    guard let stepType = HKQuantityType.quantityType(forIdentifier: .stepCount) else {
+      throw StepCountTypeUnavailableException()
+    }
+    return stepType
+  }
+
+  private static func sharingAuthorizationStatus(for type: HKObjectType) -> String {
+    switch healthStore.authorizationStatus(for: type) {
+    case .notDetermined:
+      return "notDetermined"
+    case .sharingDenied:
+      return "denied"
+    case .sharingAuthorized:
+      return "authorized"
+    @unknown default:
+      return "notDetermined"
+    }
+  }
+
+  private static func fetchLastSevenDaysSteps(stepType: HKQuantityType) async throws -> [[String: Any]] {
+    let calendar = Calendar.current
+    let startOfToday = calendar.startOfDay(for: Date())
+    guard
+      let startDate = calendar.date(byAdding: .day, value: -6, to: startOfToday),
+      let endDate = calendar.date(byAdding: .day, value: 1, to: startOfToday)
+    else {
+      throw StepCountTypeUnavailableException()
+    }
+
+    var dailyInterval = DateComponents()
+    dailyInterval.day = 1
+
+    let sumsByDayStart: [Date: Double] = try await withCheckedThrowingContinuation { continuation in
+      let query = HKStatisticsCollectionQuery(
+        quantityType: stepType,
+        quantitySamplePredicate: nil,
+        options: .cumulativeSum,
+        anchorDate: startOfToday,
+        intervalComponents: dailyInterval
+      )
+      query.initialResultsHandler = { _, results, error in
+        if let error {
+          continuation.resume(throwing: error)
+          return
+        }
+        var sums: [Date: Double] = [:]
+        results?.enumerateStatistics(from: startDate, to: endDate) { statistics, _ in
+          sums[statistics.startDate] = statistics.sumQuantity()?.doubleValue(for: .count()) ?? 0
+        }
+        continuation.resume(returning: sums)
+      }
+      healthStore.execute(query)
+    }
+
+    return (0...6).map { offset -> [String: Any] in
+      let dayStart = calendar.date(byAdding: .day, value: -offset, to: startOfToday)!
+      let components = calendar.dateComponents([.year, .month, .day], from: dayStart)
+      let dateISO = String(format: "%04d-%02d-%02d", components.year ?? 0, components.month ?? 0, components.day ?? 0)
+      let steps = Int((sumsByDayStart[dayStart] ?? 0).rounded())
+      return ["dateISO": dateISO, "steps": steps]
+    }
+  }
+}
