{
  "compilerOptions": {
    "module": "node18",
    "moduleResolution": "node16",

    "baseUrl": ".",
    "paths": {
      "sparkling-navigation": [
        "node_modules/sparkling-navigation"
      ]
    },

    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
  },
  "vueCompilerOptions": {
    "plugins": ["vue-lynx/types/volar-plugin"]
  },
  "exclude": ["dist/"],
}
