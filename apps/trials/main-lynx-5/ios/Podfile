platform :ios, '12.0'

# Use private spec repo for SparklingMethod and Sparkling
source 'https://cdn.cocoapods.org/'

use_modular_headers!

install! 'cocoapods',
:generate_multiple_pod_projects => true,
:incremental_installation => true,
:deterministic_uuids => true

inhibit_all_warnings!

SPARKLING_VERSION = '2.0.1'

def sparkling_methods
  pod 'SparklingMethod', SPARKLING_VERSION, :subspecs => [
  'Lynx', 'DIProvider', 'Debug'
  ]
end

def sparkling_methods_dep
  # BEGIN SPARKLING AUTOLINK
  pod 'Sparkling-Router', :path => '../node_modules/sparkling-navigation/ios'
  # END SPARKLING AUTOLINK
end

def sparkling_kit
  pod 'Sparkling', SPARKLING_VERSION
  sparkling_methods
  sparkling_methods_dep
  
  pod 'Lynx', '3.6.0', :subspecs => [
    'Framework',
    'ReleaseResource'
  ]
  
  pod 'PrimJS', '3.6.1', :subspecs => ['quickjs', 'napi']

  pod 'LynxService', '3.6.0', :subspecs => [
  'Image',
  'Log',
  'Http',
  'Devtool'
  ]

#  pod 'BaseDevtool'
  pod 'LynxDevtool', '3.6.0', :subspecs => [
   'Framework',
  ]
  
  pod 'SnapKit'
  pod 'Mantle', '~> 2.2.0'
  
  pod 'SDWebImage','5.15.5'
  pod 'SDWebImageWebPCoder', '0.11.0'
  
end

# Sparkling 2.0.1 registers its Swift services by planting C-string pointers in the
# __DATA,SPK_PRE_SVC section via @_section globals. Swift 6.x (Xcode 26+) rejects
# pointer initializers in @_section constants, so this re-plants the entries from C
# inside SPKBootExecutor.m (same image the boot scanner reads) and strips the Swift
# globals. Idempotent; remove once Sparkling ships its own fix.
def patch_sparkling_for_xcode26(sandbox_root)
  sdk_dir = File.join(sandbox_root, 'Sparkling/packages/sparkling-sdk/ios/Sparkling')
  boot_executor = File.join(sdk_dir, 'Utils/SPKBootExecutor.m')
  return unless File.exist?(boot_executor)

  c_entries = <<~OBJC
    __attribute__((used, section("__DATA," SPK_PREPARE_SERVICE_SECTION_NAME)))
    static const char *const spkRegisterSPKResourceLoaderImpl = "SPKResourceLoaderImpl";
    __attribute__((used, section("__DATA," SPK_PREPARE_SERVICE_SECTION_NAME)))
    static const char *const spkRegisterSPKLynxService = "SPKLynxService";
  OBJC

  src = File.read(boot_executor)
  unless src.include?('spkRegisterSPKResourceLoaderImpl')
    src = src.sub(/^typedef struct _SPKBootExecuteImage/, c_entries + "\ntypedef struct _SPKBootExecuteImage")
    File.write(boot_executor, src)
  end

  swift_global = /@_used\s*\n@_section\("__DATA, SPK_PRE_SVC"\)\s*\nnonisolated\(unsafe\)\s*\nprivate let spkRegister\w+: UnsafePointer<CChar>\? = [^\n]+\n/
  [
    File.join(sdk_dir, 'Application/Container/Resource/SPKResourceLoaderImpl.swift'),
    File.join(sdk_dir, 'Service/LynxService/SPKLynxService.swift'),
  ].each do |path|
    next unless File.exist?(path)
    src = File.read(path)
    patched = src.sub(swift_global, "// Registered via a C section entry in SPKBootExecutor.m; Swift @_section constants\n// cannot hold pointer values under Swift 6.x.\n")
    File.write(path, patched) if patched != src
  end
end

pre_install do |installer|
  patch_sparkling_for_xcode26(installer.sandbox.root.to_s)
end

use_frameworks!
target 'SparklingGo' do
  sparkling_kit
end

target 'SparklingGoTests' do
  sparkling_kit
end

target 'SparklingMethodTests' do
  sparkling_kit
end

target 'SparklingGoUITests' do
  sparkling_kit
end
