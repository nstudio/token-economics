    "@vitest/coverage-v8": "^4.0.18",
    "prettier": "^3.8.1",
    "sparkling-app-cli": "~2.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "private": false,
  "scripts": {
    "build": "sparkling-app-cli build --copy",
